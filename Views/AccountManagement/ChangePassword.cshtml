@{
    ViewData["Title"] = "Change Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <style>
    /* ---------- RESET ---------- */
    *{margin:0;padding:0;box-sizing:border-box;}

    /* ---------- PAGE BACKGROUND ---------- */
    body{
      font-family:Helvetica,Arial,sans-serif;
      background:linear-gradient(to bottom right,#b2e7ff,#ffffff);
      min-height:100vh;
      display:flex;              /* centre everything vertically */
      flex-direction:column;
      align-items:center;
    }

    /* ---------- MAIN WRAPPER ---------- */
    .content-wrapper{max-width:400px;width:100%;margin:90px 20px 40px;}

    /* back link */
    .back-btn{
      display:inline-block;margin-bottom:1rem;padding:.45rem 1rem;
      background:#e9efff;border:1px solid #6981ec;border-radius:6px;
      color:#6981ec;text-decoration:none;font-weight:600;text-align:center;
      transition:.25s;
    }
    .back-btn:hover{background:#6981ec;color:#fff;}

    /* ---------- FORM CARD ---------- */
    .form-card{
      background:#fff;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,.1);
      padding:1.75rem 2rem;
    }
    .form-card h2{margin-bottom:1rem;color:#333;text-align:center;}

    /* bootstrap-like tweaks */
    .form-group{margin-bottom:1rem;}
    label{display:block;margin-bottom:.35rem;font-weight:600;color:#555;}
    input.form-control{
      width:100%;padding:.45rem .65rem;border:1px solid #ccc;border-radius:4px;
      font-size:1rem;
    }
    button.btn{
      display:block;width:100%;padding:.55rem 1rem;border:none;border-radius:4px;
      font-size:1rem;font-weight:600;cursor:pointer;
    }
    .btn-primary{background:#6981ec;color:#fff;}
    .btn-primary:hover{background:#5369d8;}

    /* alert */
    .alert{padding:.55rem 1rem;border-radius:4px;margin-bottom:1rem;}
    .alert-danger{background:#f8d7da;color:#842029;}
    .note{margin-top:.75rem;font-size:.9rem;color:#555;text-align:center;}
  </style>
</head>
<body>
  <div class="content-wrapper">
    <!-- BACK LINK -->
    @if (!(ViewBag.RequireChange as bool? ?? false))
    {
      <a asp-controller="Students"
      asp-action="Index"
      class="back-btn">
      ←&nbsp;Back&nbsp;to&nbsp;My&nbsp;Profile
      </a>
    }


    <!-- CHANGE-PASSWORD CARD -->
    <div class="form-card">
      <h2>Change Password</h2>

      @if (ViewBag.Error != null)
      {
        <div class="alert alert-danger">@ViewBag.Error</div>
      }

      <form asp-action="ChangePassword" method="post">
        <input type="hidden" name="userId" value="@ViewBag.UserId" />

        <div class="form-group">
          <label for="newPassword">New password</label>
          <input type="password" class="form-control" id="newPassword" name="newPassword" />
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm new password</label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" />
        </div>

        <button type="submit" class="btn btn-primary">Save&nbsp;New&nbsp;Password</button>

        <p class="note">
        You’ll be signed out after saving and must sign in again with the new password.
        </p>
      </form>
    </div>
  </div>
</body>
</html>
