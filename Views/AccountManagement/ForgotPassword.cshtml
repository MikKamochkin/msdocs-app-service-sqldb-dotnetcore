<!-- Views/AccountManagement/ForgotPassword.cshtml -->
@{
    ViewData["Title"] = "Forgot Password";
}

<h1>Forgot Password</h1>

@if (ViewBag.Error != null)
{
  <div class="alert alert-danger">@ViewBag.Error</div>
}
else
{
  <p>
    We will send a one-time temporary password to your primary email:
    <strong>@ViewBag.Email</strong>
  </p>
  <form asp-action="ForgotPassword"
        asp-route-userId="@ViewBag.UserId"
        method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">
      Send a temporary password to my email
    </button>
  </form>
}
