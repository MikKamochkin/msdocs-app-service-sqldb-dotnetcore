@{
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <style>
    /* ---------- RESET ---------- */
    *{margin:0;padding:0;box-sizing:border-box;}

    /* ---------- PAGE BACKGROUND ---------- */
    body{
      font-family:Helvetica,Arial,sans-serif;
      /*background:linear-gradient(to bottom right,#b2e7ff,#ffffff);*/
      background: #e8ecfc;
      min-height:100vh;
      display:flex;               /* vertically center the card */
      flex-direction:column;
      align-items:center;
    }

    /* ---------- MAIN WRAPPER ---------- */
    .content-wrapper{max-width:420px;width:100%;margin:90px 20px 40px;}

    /* back link */
    .back-btn{
      display:inline-block;margin-bottom:1rem;padding:.45rem 1rem;
      background:#e9efff;border:1px solid #6981ec;border-radius:6px;
      color:#6981ec;text-decoration:none;font-weight:600;text-align:center;
      transition:.25s;
    }
    .back-btn:hover{background:#6981ec;color:#fff;}

    /* ---------- CARD ---------- */
    .form-card{
      background:#fff;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,.1);
      padding:1.75rem 2rem;
    }
    .form-card h2{margin-bottom:1rem;color:#333;text-align:center;}

    /* form + button */
    .form-group{margin-bottom:1rem;}
    p{font-size:.95rem;color:#333;line-height:1.4;}
    button.btn{
      display:block;width:100%;padding:.55rem 1rem;border:none;border-radius:4px;
      font-size:1rem;font-weight:600;cursor:pointer;background:#6981ec;color:#fff;
      transition:.25s;
    }
    button.btn:hover{background:#5369d8;}

    /* alert */
    .alert{padding:.55rem 1rem;border-radius:4px;margin-bottom:1rem;}
    .alert-danger{background:#f8d7da;color:#842029;}
  </style>
</head>
<body>
  <div class="content-wrapper">
    <!-- BACK LINK -->
    <a asp-controller="Login" asp-action="Index" class="back-btn">
      ←&nbsp;Back&nbsp;to&nbsp;Sign-In
    </a>

    <!-- FORGOT-PASSWORD CARD -->
    <div class="form-card">
      <h2>Forgot Password</h2>

      @if (ViewBag.Error != null)
      {
        <div class="alert alert-danger">@ViewBag.Error</div>
      }
      else
      {
        <form asp-action="ForgotPassword"
              asp-route-userId="@ViewBag.UserId"
              method="post">
          @Html.AntiForgeryToken()

          <div class="form-group">
            <p>
              We will send a one-time temporary password to your primary email:<br />
              <strong>@ViewBag.Email</strong>
            </p>
          </div>

          <div class="form-group">
            <button type="submit" class="btn">
              Send&nbsp;temporary&nbsp;password&nbsp;to&nbsp;my&nbsp;email
            </button>
          </div>
        </form>
      }
    </div>
  </div>
</body>
</html>
