@model DotNetCoreSqlDb.Models.Assignments

@{
    ViewData["Title"] = "Create Assignment";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
        
    <div class="col">
        <h2>Create Assignment</h2>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.GroupId, "Student/Group")
                @Html.DropDownListFor(m => m.GroupId, (SelectList)ViewBag.Groups, "Select Group", new { @class="form-control" })
                @Html.ValidationMessageFor(m => m.GroupId, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TeacherId, "Teacher")
                @Html.DropDownListFor(m => m.TeacherId, (SelectList)ViewBag.Teachers, "— unassigned —", new { @class="form-control" })
                @Html.ValidationMessageFor(m => m.TeacherId, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.StudentUnitCost)
                @Html.EditorFor(m => m.StudentUnitCost, new { htmlAttributes = new { @class="form-control" } })
                @Html.ValidationMessageFor(m => m.StudentUnitCost, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.StudentUnitType)
                @Html.DropDownListFor(m => m.StudentUnitType, (IEnumerable<SelectListItem>)ViewBag.PayUnits, new { @class="form-control" })
                @Html.ValidationMessageFor(m => m.StudentUnitType, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.StudentUnitBalance)
                @Html.EditorFor(m => m.StudentUnitBalance, new { htmlAttributes = new { @class="form-control" } })
                @Html.ValidationMessageFor(m => m.StudentUnitBalance, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.StudentUnitDuration)
                @Html.DropDownListFor(m => m.StudentUnitDuration, (IEnumerable<SelectListItem>)ViewBag.DurationTypes, new { @class="form-control" })
                @Html.ValidationMessageFor(m => m.StudentUnitDuration, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TeacherPayForUnit)
                @Html.EditorFor(m => m.TeacherPayForUnit, new { htmlAttributes = new { @class="form-control" } })
                @Html.ValidationMessageFor(m => m.TeacherPayForUnit, "", new { @class="text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TeacherPayUnitType)
                @Html.DropDownListFor(m => m.TeacherPayUnitType, (IEnumerable<SelectListItem>)ViewBag.PayUnits, "Select Currency", new { @class="form-control" })
                @Html.ValidationMessageFor(m => m.TeacherPayUnitType, "", new { @class="text-danger" })
            </div>

            @*<div class="form-group form-check">
                @Html.CheckBoxFor(m => m.IsActive, new { @class="form-check-input" })
                @Html.LabelFor(m => m.IsActive, new { @class="form-check-label" })
            </div>*@

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
    </div>
    }
</div>
