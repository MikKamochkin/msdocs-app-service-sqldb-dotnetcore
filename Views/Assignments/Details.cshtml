@* Views/Assignments/Details.cshtml *@
@model DotNetCoreSqlDb.Models.Assignments

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
    
    <div class="col">
        <h2>Assignment Details</h2>
        <hr />
        <dl class="dl-horizontal">
            <dt>Group</dt>
            <dd>@Model.Group.Name</dd>

            <dt>Teacher</dt>
            <dd>@(Model.Teacher != null ? Model.Teacher.Name : "<em>Unassigned</em>")</dd>

            <dt>Student Unit Cost</dt>
            <dd>@Model.StudentUnitCost</dd>

            <dt>Student Unit Type</dt>
            <dd>@Model.StudentUnitType</dd>

            <dt>Student Unit Duration</dt>
            <dd>@Model.StudentUnitDuration</dd>

            <dt>Teacher Pay For Unit</dt>
            <dd>@Model.TeacherPayForUnit</dd>

            <dt>Teacher Pay Unit Type</dt>
            <dd>@Model.TeacherPayUnitType</dd>

            <dt>Is Active?</dt>
            <dd>@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>

        <div class="details-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </div>
    }
</div>
