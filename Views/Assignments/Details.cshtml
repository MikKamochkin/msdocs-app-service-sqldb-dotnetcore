@* Views/Assignments/Details.cshtml *@
@model DotNetCoreSqlDb.Models.Assignments

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-dark icon-btn" title="Students">
                    <i class="fas fa-user-graduate"></i>
                </a>
                <a href="@Url.Action("Index", "Groups")" class="btn btn-dark icon-btn" title="Groups">
                    <i class="fas fa-users"></i>
                </a>
                <a href="@Url.Action("Manage", "Schedule")" class="btn btn-dark icon-btn" title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
                <a href="@Url.Action("Index", "Whatsapp")" class="btn btn-dark icon-btn" title="WhatsApp">
                    <i class="hgi hgi-stroke hgi-message-01"></i>
                </a>
                <a href="@Url.Action("Index", "Assignments")" class="btn btn-success icon-btn" title="Assignments">
                    <i class="fas fa-tasks"></i>
                </a>
                <a href="@Url.Action("Index", "TeacherManagement")" class="btn btn-dark icon-btn" title="Teachers">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </a>
            </div>
        </div>
    
    <div class="col">
        <h2>Assignment Details</h2>
        <hr />
        <dl class="dl-horizontal">
            <dt>Group</dt>
            <dd>@Model.Group.Name</dd>

            <dt>Teacher</dt>
            <dd>@(Model.Teacher != null ? Model.Teacher.Name : "<em>Unassigned</em>")</dd>

            <dt>Student Unit Cost</dt>
            <dd>@Model.StudentUnitCost</dd>

            <dt>Student Unit Type</dt>
            <dd>@Model.StudentUnitType</dd>

            <dt>Student Unit Balance</dt>
            <dd>@Model.StudentUnitBalance</dd>

            <dt>Student Unit Duration</dt>
            <dd>@Model.StudentUnitDuration</dd>

            <dt>Teacher Pay For Unit</dt>
            <dd>@Model.TeacherPayForUnit</dd>

            <dt>Teacher Pay Unit Type</dt>
            <dd>@Model.TeacherPayUnitType</dd>

            <dt>Is Active?</dt>
            <dd>@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>

        <div class="details-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </div>
    }
</div>
