@{
    ViewData["Title"] = "Download CSV Files";
    var token = (string)ViewBag.Token;
}
<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
    }
    <div class="col">
    <h2>Download CSV Files</h2>
    <ul>
        <li>
            <a class="btn btn-primary" asp-action="DownloadAccountCsv" asp-route-token="@token">
                Download Account CSV
            </a>
        </li>
        <li>
            <a class="btn btn-primary" asp-action="DownloadStudentCsv" asp-route-token="@token">
                Download Student CSV
            </a>
        </li>
    </ul>
    <hr />
    <p>
        <a asp-action="Index" asp-controller="DataConversion" class="btn btn-secondary">
            ← Back to Conversion
        </a>
    </p>
    </div>
</div>
