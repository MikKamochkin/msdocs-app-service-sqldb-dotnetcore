@model DotNetCoreSqlDb.Models.Group

@{
    ViewData["Title"] = "Create Group";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-dark d-flex icon-btn" title="Student Management">
                    <i class="fas fa-user-graduate"></i>
                </a>
                <a href="@Url.Action("Index", "Groups")" class="btn btn-success d-flex icon-btn" title="Manage Groups">
                    <i class="fas fa-users"></i>
                </a>
                <a href="@Url.Action("Manage", "Schedule")" class="btn btn-dark d-flex icon-btn" title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
            </div>
        </div>
    }
    <div class="col">
        <h2>Create Group</h2>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                <h4>Group</h4>
                <hr />
                <div class="form-group">
                    @Html.LabelFor(m => m.Name, new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <h4>Students in Group</h4>
                <div id="studentCompositions"></div>

                <input type="hidden" id="StudentIds" name="StudentIds" value="" />
                <input type="hidden" id="UseMyBalanceValues" name="UseMyBalanceValues" value="" />

                <button type="button" id="addStudentBtn" class="btn btn-secondary">Add Student</button>
                <br /><br />

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        }

        <!-- Modal for Adding a Student -->
        <div class="modal fade" id="addStudentModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Student to Group</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="studentSelect">Student</label>
                            <select id="studentSelect" class="form-control">
                                <option value="">Select a student…</option>
                                @foreach (var student in (SelectList)ViewBag.Students)
                                {
                                    <option value="@student.Value">@student.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="useMyBalance" />
                                <label class="custom-control-label" for="useMyBalance">Use My Balance</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="modalClose" class="btn btn-secondary">Close</button>
                        <button type="button" id="saveStudentBtn" class="btn btn-primary">Add Student</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Array to store student data
            let students = [];

            // Show modal when Add Student button is clicked
            $('#addStudentBtn').click(function () {
                $('#addStudentModal').modal('show');
            });

            // Handle adding a student
            $('#saveStudentBtn').click(function () {
                const studentId = $('#studentSelect').val();
                const studentName = $('#studentSelect option:selected').text();
                const useMyBalance = $('#useMyBalance').is(':checked');

                if (studentId) {
                    // Add to our array
                    students.push({
                        id: studentId,
                        name: studentName,
                        useMyBalance: useMyBalance
                    });

                    // Update the UI
                    updateStudentDisplay();
                    
                    // Update hidden fields
                    updateHiddenFields();
                    
                    // Reset modal
                    $('#addStudentModal').modal('hide');
                    $('#studentSelect').val('');
                    $('#useMyBalance').prop('checked', false);
                }
            });

            // Handle removing a student
            $(document).on('click', '.remove-student', function () {
                const index = $(this).data('index');
                students.splice(index, 1);
                updateStudentDisplay();
                updateHiddenFields();
            });

            // Function to update the student display
            function updateStudentDisplay() {
                $('#studentCompositions').empty();
                
                if (students.length === 0) {
                    $('#studentCompositions').html('<p>No students added yet.</p>');
                    return;
                }
                
                let html = '<table class="table table-bordered">';
                html += '<thead><tr><th>Student</th><th>Use My Balance</th><th>Actions</th></tr></thead>';
                html += '<tbody>';
                
                students.forEach((student, index) => {
                    html += `<tr>
                        <td>${student.name}</td>
                        <td>${student.useMyBalance ? 'Yes' : 'No'}</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm remove-student" data-index="${index}">Remove</button>
                        </td>
                    </tr>`;
                });
                
                html += '</tbody></table>';
                $('#studentCompositions').html(html);
            }

            // Function to update hidden fields
            function updateHiddenFields() {
                const studentIds = students.map(s => s.id).join(',');
                const useMyBalanceValues = students.map(s => s.useMyBalance).join(',');
                
                $('#StudentIds').val(studentIds);
                $('#UseMyBalanceValues').val(useMyBalanceValues);
            }

            $("#modalClose").click(function() {
                $("#addStudentModal").modal('hide');
            });

            // Before form submission, ensure at least one student is added
            $('form').submit(function(e) {
                if (students.length === 0) {
                    alert("Please add at least one student to the group.");
                    e.preventDefault();
                    return false;
                }
                
                // Make sure hidden fields are updated
                updateHiddenFields();
            });
        });
    </script>
}
