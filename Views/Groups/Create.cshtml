@model DotNetCoreSqlDb.Models.Group

@{
    ViewData["Title"] = "Create Group";
    // Convert ICollection to List for indexing
    var studentCompositionsList = Model.StudentGroupCompositions?.ToList() ?? new List<DotNetCoreSqlDb.Models.StudentGroupComposition>();
}

<h2>Create Group</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <h4>Group</h4>
        <hr />
        <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4>Students in Group</h4>
        <div id="studentCompositions">
            @if (studentCompositionsList.Any())
            {
                for (int i = 0; i < studentCompositionsList.Count; i++)
                {
                    <div class="student-composition" data-index="@i">
                        @Html.Hidden($"StudentGroupCompositions[{i}].StudentId", studentCompositionsList[i].StudentId)
                        @Html.Hidden($"StudentGroupCompositions[{i}].UseMyBalance", studentCompositionsList[i].UseMyBalance)
                        <div class="row">
                            <div class="col-md-6">
                                <span>@studentCompositionsList[i].Student?.Name</span>
                            </div>
                            <div class="col-md-4">
                                <span>@(studentCompositionsList[i].UseMyBalance ? "Uses Balance" : "No Balance")</span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-sm remove-student">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <button type="button" id="addStudentBtn" class="btn btn-secondary">Add Student</button>
        <br /><br />

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<!-- Modal for Adding a Student -->
<div class="modal fade" id="addStudentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Student to Group</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="studentSelect">Student</label>
                    <select id="studentSelect" class="form-control">
                        <option value="">Select a student...</option>
                        @foreach (var student in ViewBag.Students)
                        {
                            <option value="@student.Value">@student.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="useMyBalance">
                        <label class="custom-control-label" for="useMyBalance">Use My Balance</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveStudentBtn">Add Student</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let studentCount = @(studentCompositionsList.Count);

            // Show modal when Add Student button is clicked
            $('#addStudentBtn').click(function () {
                $('#addStudentModal').modal('show');
            });

            // Handle adding a student
            $('#saveStudentBtn').click(function () {
                const studentId = $('#studentSelect').val();
                const studentName = $('#studentSelect option:selected').text();
                const useMyBalance = $('#useMyBalance').is(':checked');

                if (studentId) {
                    const newStudent = `
                        <div class="student-composition" data-index="${studentCount}">
                            <input type="hidden" name="StudentGroupCompositions[${studentCount}].StudentId" value="${studentId}" />
                            <input type="hidden" name="StudentGroupCompositions[${studentCount}].UseMyBalance" value="${useMyBalance}" />
                            <div class="row">
                                <div class="col-md-6">
                                    <span>${studentName}</span>
                                </div>
                                <div class="col-md-4">
                                    <span>${useMyBalance ? 'Uses Balance' : 'No Balance'}</span>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger btn-sm remove-student">Remove</button>
                                </div>
                            </div>
                        </div>
                    `;
                    $('#studentCompositions').append(newStudent);
                    studentCount++;
                    $('#addStudentModal').modal('hide');
                    $('#studentSelect').val('');
                    $('#useMyBalance').prop('checked', false);
                }
            });

            // Handle removing a student
            $(document).on('click', '.remove-student', function () {
                $(this).closest('.student-composition').remove();
                // Reindex the remaining students
                reindexStudents();
            });

            // Function to reindex students after removal
            function reindexStudents() {
                let index = 0;
                $('.student-composition').each(function() {
                    $(this).attr('data-index', index);
                    $(this).find('input[name^="StudentGroupCompositions"]').each(function() {
                        const name = $(this).attr('name');
                        const newName = name.replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', newName);
                    });
                    index++;
                });
                studentCount = index;
            }

            // Before form submission, ensure all student data is included
            $('form').submit(function(e) {
                // Check if there are any students in the group
                if ($('.student-composition').length === 0) {
                    alert("Please add at least one student to the group.");
                    e.preventDefault();
                    return false;
                }
                
                // Make sure all indices are sequential
                reindexStudents();
            });
        });
    </script>
}
