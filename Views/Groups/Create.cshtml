@model DotNetCoreSqlDb.Models.Group
@{
    ViewData["Title"] = ViewData["IsCopyAction"] as bool? == true ? "Edit Group" : "Create Group";
    var isCopyAction = ViewData["IsCopyAction"] as bool? ?? false;
    var originalGroupId = ViewData["OriginalGroupId"] as Guid?;
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar"/>
    }
    <div class="col-md-9">
        <h2>@ViewData["Title"]</h2>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @using (Html.BeginForm(isCopyAction ? "DeactivateAndCopy" : "Create", "Groups", 
               isCopyAction ? new { id = originalGroupId } : null, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                <h4>Group</h4>
                <hr />
                <div class="form-group">
                    <h3>@Html.LabelFor(m => m.Name, new { @class = "control-label col-md-2" })</h3>
                    <div class="col-md-10">
                        @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <h4>Students in Group</h4>
                <div id="studentCompositions"></div>

                <input type="hidden" id="StudentIds" name="StudentIds" value="" />
                <input type="hidden" id="UseMyBalanceValues" name="UseMyBalanceValues" value="" />

                <button type="button" id="addStudentBtn" class="btn btn-warning">Add Student</button>
                <br /><br />

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                        <input type="submit" value="@(isCopyAction ? "Save" : "Create")" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        }

        <!-- Rest of your view remains the same -->
        <!-- Modal for Adding a Student -->
        <div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addStudentModalLabel">Add Student to Group</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="studentSelect">Student</label>
                            <select id="studentSelect" class="form-control">
                                <option value="">Select a student…</option>
                                @foreach (var student in (SelectList)ViewBag.Students)
                                {
                                    <option value="@student.Value">@student.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mt-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="useMyBalance" checked>
                                <label class="form-check-label" for="useMyBalance">
                                    Use My Balance
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" id="saveStudentBtn" class="btn btn-primary">Add Student</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    // serialize the list or fallback to an empty array
    var copyJson = ViewBag.CopyStudents is not null
        ? System.Text.Json.JsonSerializer.Serialize(ViewBag.CopyStudents)
        : "[]";
}
@section Scripts {
    <!-- Add these to your _Layout.cshtml -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Array to store student data
            let students = [];
            const copied = @Html.Raw(copyJson);
            if (Array.isArray(copied) && copied.length) {
                copied.forEach(s => students.push(s));
                updateStudentDisplay();
                updateHiddenFields();
            }

            // Show modal when Add Student button is clicked
            function updateStudentSelect() {
                const $studentSelect = $('#studentSelect');
                const currentValue = $studentSelect.val();
                
                $studentSelect.find('option').each(function() {
                    const optionValue = $(this).val();
                    if (optionValue) {
                        const isSelected = students.some(student => student.id === optionValue);
                        $(this).prop('disabled', isSelected);
                    }
                });
                
                // Restore the current value if it wasn't one of the disabled options
                if (currentValue && !$studentSelect.find('option:selected').prop('disabled')) {
                    $studentSelect.val(currentValue);
                } else {
                    $studentSelect.val('');
                }
            }

            // Call this function whenever the students array changes
            // and before showing the modal
            $('#addStudentBtn').click(function () {
                updateStudentSelect();
                $('#useMyBalance').prop('checked', true);
                $('#addStudentModal').modal('show');
            });

            // Handle removing a student - ONLY THIS ONE HANDLER SHOULD EXIST
            $(document).on('click', '.remove-student', function () {
                const studentId = $(this).data('id');
                students = students.filter(student => student.id !== studentId);
                updateStudentDisplay();
                updateHiddenFields();
                updateStudentSelect();
            });

            // Handle adding a student
            $('#saveStudentBtn').click(function () {
                const studentId = $('#studentSelect').val();
                const studentName = $('#studentSelect option:selected').text();
                const useMyBalance = $('#useMyBalance').is(':checked');

                if (studentId) {
                    // Check if student already exists in the array
                    const studentExists = students.some(student => student.id === studentId);
                    
                    if (studentExists) {
                        alert('This student has already been added to the group.');
                        return;
                    }

                    // Add to our array
                    students.push({
                        id: studentId,
                        name: studentName,
                        useMyBalance: useMyBalance
                    });

                    // Update the UI
                    updateStudentDisplay();
                    
                    // Update hidden fields
                    updateHiddenFields();
                    
                    // Reset modal
                    $('#addStudentModal').modal('hide');
                    $('#studentSelect').val('');
                    $('#useMyBalance').prop('checked', false);
                }
            });

            // Function to update the student display
            function updateStudentDisplay() {
                $('#studentCompositions').empty();
                
                if (students.length === 0) {
                    $('#studentCompositions').html('<p>No students added yet.</p>');
                    return;
                }
                
                let html = '<table class="table table-bordered">';
                html += '<thead><tr><th>Student</th><th>Use My Balance</th><th>Actions</th></tr></thead>';
                html += '<tbody>';
                
                students.forEach((student) => {
                    html += `<tr>
                        <td>${student.name}</td>
                        <td>${student.useMyBalance ? 'Yes' : 'No'}</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm remove-student" data-id="${student.id}">Remove</button>
                        </td>
                    </tr>`;
                });
                
                html += '</tbody></table>';
                $('#studentCompositions').html(html);
            }

            // Function to update hidden fields
            function updateHiddenFields() {
                const studentIds = students.map(s => s.id).join(',');
                const useMyBalanceValues = students.map(s => s.useMyBalance).join(',');
                
                $('#StudentIds').val(studentIds);
                $('#UseMyBalanceValues').val(useMyBalanceValues);
            }

            $("#modalClose").click(function() {
                $("#addStudentModal").modal('hide');
            });

            // Before form submission, ensure at least one student is added
            /*$('form').submit(function(e) {
                if (students.length === 0) {
                    alert("Please add at least one student to the group.");
                    e.preventDefault();
                    return false;
                }
                
                // Make sure hidden fields are updated
                updateHiddenFields();
            });*/
        });
    </script>
}
