@model IEnumerable<DotNetCoreSqlDb.Models.Group>

@{
    ViewData["Title"] = "Groups List";
}

<div class="row no-gutters">
    @* ——————— Sidebar Column ——————— *@
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")"
                   class="btn btn-dark d-flex icon-btn mb-2"
                   title="Student Management">
                    <i class="fas fa-user-graduate"></i>
                </a>
                
                <a href="@Url.Action("Index", "Groups")"
                   class="btn btn-success d-flex icon-btn"
                   title="Manage Groups">
                    <i class="fas fa-users"></i>
                </a>

                <a href="@Url.Action("Manage", "Schedule")"
                    class="btn btn-dark d-flex icon-btn"
                    title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
                <a href="@Url.Action("Index", "Whatsapp")" class="btn btn-dark d-flex icon-btn" title="WhatsApp">
                    <i class="hgi hgi-stroke hgi-message-01"></i>
                </a>

            </div>
        </div>
    }

    @* ——————— Main Content Column ——————— *@
    <div class="@(User.IsInRole("admin") || User.IsInRole("support") ? "col-md-9" : "col-12")">
        <h2>Groups List</h2>

        <p>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                Create New Group
            </a>
        </p>

        <table class="table">
            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Students</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model)
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>
                            @if (group.StudentGroupCompositions?.Any() ?? false)
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var comp in group.StudentGroupCompositions)
                                    {
                                        <li>
                                            @comp.Student.Name
                                            @if (comp.UseMyBalance)
                                            {
                                                <span class="badge bg-info">Uses Balance</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">No students in group</span>
                            }
                        </td>
                        <td>
                            <!-- Deactivate -->
                            @using (Html.BeginForm("Deactivate", "Groups", FormMethod.Post, new { @class="d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", group.Id)
                                <button type="submit" class="btn btn-sm btn-warning">Deactivate</button>
                            }

                            <!-- Deactivate & Copy -->
                            @using (Html.BeginForm("DeactivateAndCopy", "Groups", FormMethod.Post, new { @class="d-inline ml-1" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", group.Id)
                                <button type="submit" class="btn btn-sm btn-info">Deactivate &amp; Copy</button>
                            }

                            <!-- Copy Emails -->
                            @{
                                // collect the emails for JS
                                var emails = group.StudentGroupCompositions
                                    .SelectMany(sgc =>
                                        sgc.Student.Contacts
                                            .Where(c => c.Type == "Email")
                                            .Select(c => c.Value))
                                    .Distinct();
                                var emailList = string.Join(";", emails);
                            }
                            <button type="button"
                                    class="btn btn-sm btn-secondary ml-1"
                                    data-emails="@emailList"
                                    onclick="copyGroupEmails(this)">
                                Copy Emails
                            </button>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
  <script>
    function copyGroupEmails(btn) {
      const list = btn.getAttribute("data-emails");
      if (!list) {
        alert("No emails to copy.");
        return;
      }
      navigator.clipboard.writeText(list)
        .then(() => alert("Copied: " + list))
        .catch(err => alert("Copy failed: " + err));
    }
  </script>
}

