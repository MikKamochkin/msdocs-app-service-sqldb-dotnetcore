@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center">
    <h1 class="text-danger">Access Denied</h1>
    <h2 class="text-danger">You do not have permission to access this resource.</h2>
    
    @if (!string.IsNullOrEmpty(ViewData["ReturnUrl"] as string))
    {
        <p>You were trying to access: <strong>@ViewData["ReturnUrl"]</strong></p>
    }
    
    <p>
        <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-primary">Return to Home</a>
    </p>
</div> 