@{
    ViewData["Title"] = "Logs";
}
<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
    }

    <div class="col">
        <br>
        <!-- Mail button -->
        <!--&nbsp;&nbsp;&nbsp;<a asp-action="Mail" class="btn btn-outline-primary mr-2">
                <i class="fa-solid fa-envelope"></i>
                <span class="ml-1">Mail Logs</span>
        </a>&nbsp;-->
        <!-- SignIn button -->
        <a asp-action="SignIn" class="btn btn-outline-primary mr-2">
            <i class="fa-solid fa-door-open"></i>
            <span class="ml-1">Sign In Logs</span>
        </a>

        <a asp-action="TwilioLessonReminders" class="btn btn-outline-primary mr-2">
            <i class="fa-regular fa-comment-dots"></i>
            <span class="ml-1">Lesson Reminder Logs</span>
        </a>

        <a asp-action="ZoomMeetingsLog" class="btn btn-outline-primary mr-2">
            <i class="hgi hgi-stroke hgi-zoom"></i>
            <span class="ml-1">Zoom Meetings</span>
        </a>

        <a asp-action="EmailPaymentsLog" class="btn btn-outline-primary mr-2">
            <i class="fa-solid fa-money-bill-transfer"></i>
            <span class="ml-1">Email Payments</span>
        </a>
    </div>
</div>
