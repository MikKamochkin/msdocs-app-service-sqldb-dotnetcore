@model IEnumerable<DotNetCoreSqlDb.Models.InteracPaymentsQueue>

@{
    ViewData["Title"] = "Interac Payments Queue";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
        
        <div class="col-md-10">
            <h2>Emails</h2>

            
            <form asp-action="ReRunEmailProcessing" asp-controller="Logging" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    Re-Process the queue
                </button>
            </form>
            
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Subject
                        </th>
                        <th>
                            Body
                        </th>
                        <th>
                            Reason For Failure
                        </th>
                        <th>
                            Added Time
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Subject)</td>
                            <td>@Html.DisplayFor(modelItem => item.Body)</td>
                            <td>@Html.DisplayFor(modelItem => item.ReasonForFailure)</td>
                            <td>@Html.DisplayFor(modelItem => item.AddedToQueueTime)</td>
                        </tr>
                    }
                </tbody>
            </table>


        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
}
