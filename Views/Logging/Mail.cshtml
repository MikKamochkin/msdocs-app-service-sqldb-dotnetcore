@model IEnumerable<DotNetCoreSqlDb.Models.MailLog>
@using Markdig

@{
    ViewData["Title"] = "Mail List";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
        
        <div class="col-md-10">
            <h2>Mail List</h2>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            To
                        </th>
                        <th>
                            Subject
                        </th>
                        <th>
                            Body
                        </th>
                        <th>
                            Time Sent
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.To)</td>
                            <td>@Html.DisplayFor(modelItem => item.Subject)</td>
                            <td>
                                @* Convert Markdown→HTML here *@
                                @Html.Raw(Markdown.ToHtml(item.Body ?? ""))
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Time)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
}
