@{
	ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: Helvetica, Arial, sans-serif;
			background: #e8ecfc;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.wrapper {
			max-width: 420px;
			width: 100%;
			margin: 90px 20px 40px;
		}

		.back-btn {
			display: inline-block;
			margin-bottom: 1rem;
			padding: .45rem 1rem;
			background: #e9efff;
			border: 1px solid #6981ec;
			border-radius: 6px;
			color: #6981ec;
			text-decoration: none;
			font-weight: 600;
			text-align: center;
			transition: .25s;
		}

		.back-btn:hover {
			background: #6981ec;
			color: #fff;
		}

		.card {
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
			padding: 1.75rem 2rem;
		}

		.card h2 {
			margin-bottom: 1rem;
			color: #333;
			text-align: center;
		}

		.form-group {
			margin-bottom: 1rem;
		}

		label {
			display: block;
			margin-bottom: .35rem;
			font-weight: 600;
			color: #555;
		}

		input.form-control {
			width: 100%;
			padding: .45rem .65rem;
			border: 1px solid #ccc;
			border-radius: 4px;
			font-size: 1rem;
		}

		button.btn {
			display: block;
			width: 100%;
			padding: .55rem 1rem;
			border: none;
			border-radius: 4px;
			font-size: 1rem;
			font-weight: 600;
			cursor: pointer;
			background: #6981ec;
			color: #fff;
			transition: .25s;
		}

		button.btn:hover {
			background: #5369d8;
		}

		.alert {
			padding: .55rem 1rem;
			border-radius: 4px;
			margin-bottom: 1rem;
		}

		.alert-danger {
			background: #f8d7da;
			color: #842029;
		}

		.alert-info {
			background: #e7f1ff;
			color: #084298;
		}
	</style>
</head>

<body>
	<div class="wrapper">
		<a asp-controller="Login" asp-action="Index" class="back-btn">←&nbsp;Back&nbsp;to&nbsp;Sign-In</a>
		<div class="card">
			<h2>Forgot Password</h2>
			@if (ViewBag.Message != null)
			{
				<div class="alert alert-info">@ViewBag.Message</div>
			}
			@if (ViewBag.Error != null)
			{
				<div class="alert alert-danger">@ViewBag.Error</div>
			}
			<form asp-action="ForgotPassword" method="post">
				@Html.AntiForgeryToken()
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" class="form-control" id="email" name="email" />
				</div>
				<button type="submit" class="btn">Send Reset Link</button>
			</form>
		</div>
	</div>
</body>

</html>