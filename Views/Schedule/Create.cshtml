@model DotNetCoreSqlDb.Models.Schedule

@{
    ViewData["Title"] = "Create Schedule";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")"
                   class="btn btn-dark d-flex icon-btn"
                   title="Student Management">
                    <i class="fas fa-user-graduate"></i>
                </a>
                <a href="@Url.Action("Index", "Groups")"
                   class="btn btn-dark d-flex icon-btn"
                   title="Manage Groups">
                    <i class="fas fa-users"></i>
                </a>
                <a href="@Url.Action("Index", "Schedule")"
                   class="btn btn-dark d-flex icon-btn"
                   title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
            </div>
        </div>
    }
    <div class="col">
        <h2>Create Schedule</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-horizontal">

                <div class="form-group">
                    @* “Group” will be rendered instead of “AssignmentId” *@
                    @Html.LabelFor(m => m.AssignmentId, "Group", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(
                            m => m.AssignmentId,
                            (SelectList)ViewBag.Assignments,
                            "Select Group",
                            new { @class = "form-control" }
                        )
                        @Html.ValidationMessageFor(m => m.AssignmentId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.DateTime, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.DateTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        @Html.ValidationMessageFor(m => m.DateTime, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Status, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.Status, (IEnumerable<SelectListItem>)ViewBag.ScheduleStatusTypes, "Select Status", new { @class = "form-control" })
                        @*@Html.EditorFor(m => m.Status, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Duration, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.Duration, (IEnumerable<SelectListItem>)ViewBag.LessonDurationTypes, "Select Duration", new { @class = "form-control" })
                        @*@Html.EditorFor(m => m.Duration, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })*@
                        @Html.ValidationMessageFor(m => m.Duration, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Create" class="btn btn-primary" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default ml-2" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @* Enables client‑side validation *@
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
