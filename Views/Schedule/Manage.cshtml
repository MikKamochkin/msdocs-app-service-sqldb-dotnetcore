@model List<DotNetCoreSqlDb.Models.Schedule>
@using Microsoft.AspNetCore.Mvc.Rendering
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiForgery

@{
    ViewData["Title"] = "Manage Schedule";
    var existingJson = ViewBag.ExistingJson as string ?? "[]";
    var timeZones = ViewBag.TimeZones as List<SelectListItem>;
    var tokens = AntiForgery.GetAndStoreTokens(ViewContext.HttpContext);
}
<style>
    .notifyTeacher-btn {
        background-color: #8b0000;
        color: #fff;
    }

    td.notes-priority-white {
        background-color: #ffffff !important;
    }

    td.notes-priority-green {
        background-color: #d4edda !important;
    }

    td.notes-priority-yellow {
        background-color: #fff3cd !important;
    }

    td.notes-priority-red {
        background-color: #f8d7da !important;
    }
</style>
<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
    }

    <div class="col">
        <h2>Manage Schedule</h2>

        <!-- Filter: Teacher & Date -->
        <form asp-action="Manage" method="get" class="form-row mb-3 align-items-end">
            <div class="form-group col-md-2">
                <label for="teacherSelect">Teacher</label>

                <div class="d-flex align-items-center">
                    <select id="teacherSelect" name="teacherId" class="form-control"
                        asp-items="(SelectList)ViewBag.Teachers" onchange="this.form.submit()" style="flex: 1 1 auto;">
                        <option value="">— select —</option>
                    </select>
                    <button type="button" class="btn-sm btn-outline-secondary ml-2" onclick="selectNextTeacher()">
                        Next →
                    </button>
                </div>
            </div>
            <div class="form-group col-md-4 d-flex align-items-center">
                <button type="button" class="btn btn-outline-secondary mr-2" onclick="shiftDay(-1)">← Prev</button>
                <b><input type="date" id="selectedDate" name="date" value="@ViewBag.SelectedDate"
                        class="form-control mr-2" onchange="this.form.submit()" /></b>
                <span id="dayOfWeek" class="ml-2 font-weight-bold">
                    @if (ViewBag.SelectedDate != null)
                    {
                        var date = DateTime.Parse(ViewBag.SelectedDate.ToString());
                        <b>
                            <h2>&nbsp;&nbsp;@date.ToString("dddd")&nbsp;&nbsp;</h2>
                        </b>
                    }
                </span>
                <button type="button" class="btn btn-outline-secondary ml-2" onclick="shiftDay(1)">Next →</button>
            </div>
        </form>

        <!-- Time Zone (client-only) -->
        <div class="form-row mb-3">
            <div class="form-group col-md-3">
                <label for="timeZoneSelect">Time Zone</label>
                <select id="timeZoneSelect" class="form-control" onchange="renderTable()">
                    @foreach (var tz in timeZones)
                    {
                        if (tz.Selected)
                        {
                            <option value="@tz.Value" selected>@tz.Text</option>
                        }
                        else
                        {
                            <option value="@tz.Value">@tz.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- AJAX anti-forgery token -->
        <input type="hidden" id="__RequestVerificationToken" value="@tokens.RequestToken" />

        <hr />

        <!-- Entry form -->
        <div class="form-inline col-md-3">
            <label class="mr-2">Time</label>
            <select id="timeSelect" class="form-control mr-3"
                asp-items="(IEnumerable<SelectListItem>)ViewBag.Times"></select>

            <label class="mr-2">Student</label>
            <select id="groupSelect" class="form-control mr-3" asp-items="(IEnumerable<SelectListItem>)ViewBag.Groups">
                <option value="" selected>— select student —</option>
            </select>

            <label class="mr-2">Status</label>
            <select id="statusSelect" class="form-control mr-3"
                asp-items="(IEnumerable<SelectListItem>)ViewBag.Statuses"></select>

            <label class="mr-2">Duration</label>
            <select id="durationSelect" class="form-control mr-3"
                asp-items="(IEnumerable<SelectListItem>)ViewBag.LessonDurationTypes">
                <option value="" selected>— select duration —</option>
            </select>

            <label class="mr-2">Accounting Type</label>
            <select id="lessonAccountingType" class="form-control mr-3"
                asp-items="(IEnumerable<SelectListItem>)ViewBag.LessonAccountingType">
                <option value="" selected>— select type —</option>
            </select>
            <br>
            <button type="button" class="btn btn-primary" onclick="saveEntryAjax()">Save Entry</button>
            <button type="button" class="btn btn-secondary ml-2" id="cancelEditBtn" style="display:none;"
                onclick="cancelEdit()">Cancel</button>
        </div>




        <table class="table table-bordered" id="entriesTable">
            <thead>
                <tr>
                    <th style="width: 5%;">Time</th>
                    <th style="width: 20%;">Student</th>
                    <th style="width: 5%;">Status</th>
                    <th style="width: 5%;">Duration</th>
                    <th style="width: 7%;">Accounting Type</th>
                    <th style="width: 35%;">Notes</th>
                    <th style="width: 5%;">Details</th>
                    <th class="text-center" style="width: 5%;">🗑️</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div class="d-inline-flex gap-2">
            <form id="copyForm" method="post">
                <input type="hidden" name="teacherId" />
                <input type="hidden" name="selectedDate" />
                <button type="submit" formmethod="post" formaction="@Url.Action("CopyLastWeek", "Schedule")"
                    class="btn btn-info ml-2" onclick="prepareCopy('copyForm')">
                    Copy Last Week
                </button>
            </form>
            <form id="importDefaultForm" method="post">
                <input type="hidden" name="teacherId" />
                <input type="hidden" name="selectedDate" />
                <button type="submit" formmethod="post" formaction="@Url.Action("ImportDefault", "Schedule")"
                    class="btn btn-success ml-2" onclick="prepareCopy('importDefaultForm')">
                    Import Default Schedule
                </button>
            </form>
            <form id="notifyTeacherForm" method="post">
                <input type="hidden" name="teacherId" />
                <input type="hidden" name="selectedDate" />
                <button type="submit" formmethod="post"
                    formaction="@Url.Action("SendEmailAboutScheduleChange", "Schedule")"
                    class="btn notifyTeacher-btn ml-2" onclick="prepareCopy('notifyTeacherForm')">
                    <i class="fa-regular fa-paper-plane"></i> <i class="fa-regular fa-envelope"></i> <i
                        class="fa-solid fa-chalkboard-user"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // parse the assignment→default-duration map
        const durationMap = @Html.Raw(ViewBag.DurationMapJson);
        const DateTime = luxon.DateTime;
        const existing = @Html.Raw(existingJson);
        let rows = existing.slice();
        let editingRow = null;

        $(function () {
            renderTable();
            if (!editingRow) {
                const sel = $('#groupSelect').val();
                if (sel) $('#durationSelect').val(durationMap[sel]);
            }
        });


        $('#groupSelect').on('change', () => {
            if (!editingRow) {
                const aid = $('#groupSelect').val();
                $('#durationSelect').val(aid ? durationMap[aid] : '');
            }
        });

        function shiftDay(delta) {
            const input = $('#selectedDate')[0];
            const d = new Date(input.value);
            d.setDate(d.getDate() + delta);
            input.value = d.toISOString().slice(0, 10);

            // Update day of week display
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            $('#dayOfWeek').text(days[d.getDay()]);

            input.form.submit();
        }

        function truncateForDisplay(text, maxLen) {
            if (!text) return '';
            const clean = text.toString().replace(/\s+/g, ' ').trim();
            if (clean.length <= maxLen) return clean;
            return clean.substring(0, maxLen - 1) + '…';
        }

        function htmlEscape(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function renderTable() {
            const zone = $('#timeZoneSelect').val();
            rows.sort((a, b) =>
                DateTime.fromISO(a.DateTime).toMillis()
                - DateTime.fromISO(b.DateTime).toMillis()
            );

            const tbody = $('#entriesTable tbody').empty();
            rows.forEach((r, i) => {
                const dt = DateTime.fromISO(r.DateTime).setZone(zone).toFormat('HH:mm');
                // highlight if this is the one we're editing
                const isEditing = editingRow && editingRow.Id === r.Id;
                const cls = isEditing ? 'table-info' : '';
                const fullNotes = r.MainNotes || '';
                const shortNotes = truncateForDisplay(fullNotes, 60);
                const notesTitle = htmlEscape(fullNotes);

                const priority = r.NotesPriority ?? 0;
                let notesPriorityClass = 'notes-priority-white';

                switch(priority)
                {
                    case 0:
                        notesPriorityClass = 'notes-priority-white';
                        break;
                    case 1:
                        notesPriorityClass = 'notes-priority-red';
                        break;
                    case 2:
                        notesPriorityClass = 'notes-priority-yellow'; 
                        break;
                    case 3:
                        notesPriorityClass = 'notes-priority-green';
                        break;
                    default:
                        notesPriorityClass = 'notes-priority-white';
                } 

                tbody.append(`
                        <tr class="${cls}" data-id="${r.Id}">
                            <td onclick="editRow(${i})">${dt}</td>
                            <td onclick="editRow(${i})">${r.GroupName}</td>
                            <td onclick="editRow(${i})">${r.Status}</td>
                            <td onclick="editRow(${i})">${r.Duration}</td>
                            <td onclick="editRow(${i})">${r.LessonAccountingType}</td>
                            <td onclick="editRow(${i})" class="notes-cell ${notesPriorityClass}" title="${notesTitle}">
                                ${shortNotes}
                            </td>
                            <td>
                                ${r.StudentId
                                    ? `
                                        <a href="/StudentManagement/Details/${encodeURIComponent(r.StudentId)}"
                                        target="_blank"
                                        class="btn btn-sm">
                                            <i class="fa-solid fa-circle-info btn-lg text-dark"></i>
                                        </a>
                                    `
                                    : ""
                                }
                            </td>
                            <td class="text-center">
                            <button class="btn btn-sm btn-danger" onclick="deleteRow(${i})">×</button>
                            </td>
                        </tr>
                        `);
            });
        }

        function editRow(i) {
            // Remove highlight from previously edited row if any
            $('#entriesTable tbody tr').removeClass('table-info');

            editingRow = rows[i];
            const r = editingRow;
            const zone = $('#timeZoneSelect').val();
            $('#timeSelect').val(DateTime.fromISO(r.DateTime).setZone(zone).toFormat('HH:mm'));
            $('#groupSelect').val(r.AssignmentId);
            $('#statusSelect').val(r.Status);
            $('#durationSelect').val(r.Duration);
            $('#lessonAccountingType').val(r.LessonAccountingType);

            // Highlight the selected row
            $(`#entriesTable tbody tr[data-id="${r.Id}"]`).addClass('table-info');

            // Show cancel button
            $('#cancelEditBtn').show();
        }

        function cancelEdit() {
            editingRow = null;
            $('#timeSelect').val('');
            $('#groupSelect').val('');
            $('#statusSelect').val('');
            $('#durationSelect').val('');
            $('#lessonAccountingType').val('');

            // Remove all highlights
            $('#entriesTable tbody tr').removeClass('table-info');

            // Hide cancel button
            $('#cancelEditBtn').hide();
        }

        function saveEntryAjax() {
            const t = $('#timeSelect').val();
            const g = $('#groupSelect').val();
            const s = $('#statusSelect').val();
            const d0 = $('#selectedDate').val();
            const dur = +$('#durationSelect').val();
            const lt = $('#lessonAccountingType').val();
            const zone = $('#timeZoneSelect').val();
            const token = $('#__RequestVerificationToken').val();

            if (!t || !g || !s || !dur || !lt) {
                return alert('All fields are required.');
            }

            // build the payload without an empty-string Id
            const dto = {
                AssignmentId: g,
                SelectedDate: d0,
                DateTime: luxon.DateTime.fromISO(`${d0}T${t}`, { zone }).toUTC().toISO(),
                Status: s,
                Duration: dur,
                LessonAccountingType: lt
            };

            // if we're editing an existing row, add its Id
            if (editingRow) {
                dto.Id = editingRow.Id;
            }

            $.ajax({
                url: '/Schedule/SaveEntry',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify(dto),
                success(response) {
                    const updated = {
                        Id: response.id,
                        AssignmentId: response.assignmentId,
                        DateTime: response.dateTime,
                        Status: response.status,
                        Duration: response.duration,
                        LessonAccountingType: response.lessonAccountingType,
                        GroupName: $('#groupSelect option:selected').text(),
                        MainNotes: response.mainNotes ?? '',
                        NotesPriority: Number(response.notesPriority ?? 0),
                        StudentId: response.studentId
                    };

                    if (editingRow) {
                        rows[rows.indexOf(editingRow)] = updated;
                    } else {
                        rows.push(updated);
                    }
                    editingRow = null;
                    renderTable();
                    $('#cancelEditBtn').hide();
                },

                error(err) {
                    alert('Save failed: ' + (err.responseJSON?.error || err.responseText));
                }
            });
        }

        function deleteRow(i) {
            const entry = rows[i];
            const token = $('#__RequestVerificationToken').val();

            $.ajax({
                url: '/Schedule/DeleteEntry',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify(entry.Id),
                success() {
                    rows.splice(i, 1);
                    renderTable();
                    // If we deleted the row we were editing, cancel edit mode
                    if (editingRow && editingRow.Id === entry.Id) {
                        editingRow = null;
                        $('#cancelEditBtn').hide();
                    }
                },
                error(err) {
                    alert('Delete failed: ' + err.responseText);
                }
            });
        }

        function prepareCopy(formId) {
            const form = document.getElementById(formId);
            const tid = document.getElementById('teacherSelect').value;
            const dt = document.getElementById('selectedDate').value;

            form.querySelector('input[name="teacherId"]').value = tid;
            form.querySelector('input[name="selectedDate"]').value = dt;
        }

        function selectNextTeacher() {
            const sel = document.getElementById('teacherSelect');
            if (!sel || sel.options.length <= 1) return;

            // Find the first real teacher option (skip placeholder empty value)
            const firstTeacherIndex = Array.from(sel.options).findIndex(o => (o.value || '').trim() !== '');
            if (firstTeacherIndex === -1) return;

            let i = sel.selectedIndex;

            // If nothing selected or placeholder selected, start at first teacher
            if (i < firstTeacherIndex) {
                sel.selectedIndex = firstTeacherIndex;
                sel.form.submit();
                return;
            }

            // Otherwise move to next teacher; wrap to first teacher when at end
            i++;
            if (i >= sel.options.length) i = firstTeacherIndex;

            sel.selectedIndex = i;
            sel.form.submit();
        }

    </script>
}