@model List<DotNetCoreSqlDb.Models.Schedule>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Manage Schedule";
    var existingJson = ViewBag.ExistingJson as string ?? "[]";
    var timeZones = ViewBag.TimeZones as List<SelectListItem>;
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support"))
    {
        <partial name="_AdminSidebar" />
    }

    <div class="col">
        <h2>Manage Schedule</h2>

        <form asp-action="Manage" method="post">
            <div class="form-row mb-3 align-items-end">
                <!-- Teacher dropdown at ~1/3 width -->
                <div class="form-group col-md-2">
                    <label for="teacherSelect">Teacher</label>
                    <select id="teacherSelect" name="teacherId" class="form-control"
                        asp-items="(SelectList)ViewBag.Teachers" onchange="this.form.submit()">
                        <option value="">— select —</option>
                    </select>
                    <label for="teacherSelect"> </label>
                </div>

                <!-- Prev / Date / Next on same row -->
                <div class="form-group col-md-4 d-flex align-items-center">
                    <button type="button" class="btn btn-outline-secondary mr-2" onclick="shiftDay(-1)">
                        ← Prev
                    </button>

                    <input type="date" id="selectedDate" name="selectedDate" value="@ViewBag.SelectedDate"
                        class="form-group col-md-3" onchange="this.form.submit()" />

                    <button type="button" class="btn btn-outline-secondary" onclick="shiftDay(+1)">
                        Next →
                    </button>
                </div>
            </div>

            <!-- Time Zone on its own row, narrower -->
            <div class="form-row mb-3">
                <div class="form-group col-md-3">
                    <label for="timeZoneSelect">Time Zone</label>
                    <select id="timeZoneSelect" name="timeZoneOffset" class="form-control">
                        @foreach (var tz in timeZones)
                        {
                            if (tz.Selected)
                            {
                                <option value="@tz.Value" selected>@tz.Text</option>
                            }
                            else
                            {
                                <option value="@tz.Value">@tz.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <hr />

            <div class="form-inline mb-2">
                <label class="mr-2">Time</label>
                <select id="timeSelect" class="form-control mr-3"
                    asp-items="(IEnumerable<SelectListItem>)ViewBag.Times"></select>

                <label class="mr-2">Student</label>
                <select id="groupSelect" class="form-control mr-3"
                    asp-items="(IEnumerable<SelectListItem>)ViewBag.Groups"></select>

                <label class="mr-2">Status</label>
                <select id="statusSelect" class="form-control mr-3"
                    asp-items="(IEnumerable<SelectListItem>)ViewBag.Statuses"></select>

                <label class="mr-2">Duration</label>
                <select id="durationSelect" class="form-control mr-3"
                    asp-items="(IEnumerable<SelectListItem>)ViewBag.LessonDurationTypes"></select>

                <button type="button" class="btn btn-primary" onclick="addOrUpdateEntry()">Save Entry</button>
            </div>

            <table class="table table-bordered" id="entriesTable">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Student</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>🗑️</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <div id="hiddenRows"></div>
            <button type="submit" class="btn btn-success">Save All</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
    <script>
        const DateTime = luxon.DateTime;

        // Parse the existing payload (all ISO UTC strings)
        const existing = @Html.Raw(existingJson)
            .map(r => ({ ...r, deleted: false }));

        let rows = existing.slice();
        let editingRow = null;

        $(function () { renderTable(); });
        $('#timeZoneSelect').on('change', renderTable);

        function shiftDay(delta) {
            const input = document.querySelector('input[name=selectedDate]');
            const d = new Date(input.value);
            d.setDate(d.getDate() + delta);
            input.value = d.toISOString().slice(0, 10);
            input.form.submit();
        }

        function renderTable() {
            const zone = $('#timeZoneSelect').val();
            rows.sort((a, b) =>
                DateTime.fromISO(a.DateTime).toMillis()
                - DateTime.fromISO(b.DateTime).toMillis()
            );

            const tbody = $('#entriesTable tbody').empty();
            $('#hiddenRows').empty();

            let schedIndex = 0;
            rows.forEach((r, i) => {
                const dtInZone = DateTime.fromISO(r.DateTime)
                    .setZone(zone);
                const t = dtInZone.toFormat('HH:mm');
                const cls = r.deleted
                    ? 'table-danger'
                    : (r === editingRow ? 'table-info' : '');

                tbody.append(
                    `<tr class="${cls}">
                  <td onclick="editRow(${i})">${t}</td>
                  <td onclick="editRow(${i})">${r.GroupName}</td>
                  <td onclick="editRow(${i})">${r.Status}</td>
                  <td onclick="editRow(${i})">${r.Duration}</td>
                  <td class="text-center">${r.deleted
                        ? `<button class="btn btn-sm btn-secondary" onclick="undoDelete(${i})">⟲</button>`
                        : `<button class="btn btn-sm btn-danger" onclick="deleteRow(${i})">×</button>`
                    }</td>
                </tr>`
                );

                if (!r.deleted) {
                    ['Id', 'AssignmentId', 'DateTime', 'Status', 'Duration']
                        .forEach(prop => $('<input>').attr({
                            type: 'hidden',
                            name: `schedules[${schedIndex}].${prop}`,
                            value: r[prop]
                        }).appendTo('#hiddenRows'));
                    schedIndex++;
                }

                if (r.deleted && r.Id) {
                    $('<input>').attr({ type: 'hidden', name: 'toDelete', value: r.Id })
                        .appendTo('#hiddenRows');
                }
            });
        }

        function addOrUpdateEntry() {
            const t = $('#timeSelect').val(),
                g = $('#groupSelect').val(),
                s = $('#statusSelect').val(),
                d0 = $('input[name=selectedDate]').val(),
                dur = $('#durationSelect').val(),
                zone = $('#timeZoneSelect').val();

            if (!t || !g || !s || !dur) return alert('All fields are required.');

            const dtLocal = DateTime.fromISO(`${d0}T${t}`, { zone });
            const dtUtcIso = dtLocal.toUTC().toISO();

            const name = $('#groupSelect option:selected').text();
            const entry = {
                Id: editingRow ? editingRow.Id : '',
                AssignmentId: g,
                GroupId: g,
                DateTime: dtUtcIso,
                Status: s,
                Duration: parseInt(dur),
                GroupName: name,
                deleted: false
            };

            if (editingRow) {
                const idx = rows.indexOf(editingRow);
                if (idx > -1) rows[idx] = entry;
                editingRow = null;
            } else {
                rows.push(entry);
            }

            renderTable();
        }

        function editRow(i) {
            if (rows[i].deleted) return;
            editingRow = rows[i];
            const r = rows[i];
            const zone = $('#timeZoneSelect').val();
            const dtInZone = DateTime.fromISO(r.DateTime)
                .setZone(zone);

            $('#timeSelect').val(dtInZone.toFormat('HH:mm'));
            $('#groupSelect').val(r.AssignmentId);
            $('#statusSelect').val(r.Status);
            $('#durationSelect').val(r.Duration);
            renderTable();
        }

        function deleteRow(i) {
            if (rows[i] === editingRow) editingRow = null;
            rows[i].deleted = true;
            renderTable();
        }

        function undoDelete(i) {
            rows[i].deleted = false;
            renderTable();
        }
    </script>
}