@using Microsoft.AspNetCore.Mvc.Routing
@{
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? "";

    // Helper to choose “btn-success” vs. “btn-dark”
    Func<string, string, string> btnClass = (linkController, linkAction) =>
    {
        if (string.Equals(currentController, linkController, StringComparison.OrdinalIgnoreCase))
        {
            return "btn btn-success icon-btn";
        }
        return "btn btn-dark icon-btn";
    };
}


<div class="col-auto admin-sidebar">
    <div class="sidebar-header">
        <i class="hgi hgi-stroke hgi-croissant"></i>
    </div>
    <div class="sidebar-content">
        @* Student Management *@
        @{
            var cssStudent = btnClass("StudentManagement", "Index");
        }
        <a href="@Url.Action("Index", "StudentManagement")" class="@cssStudent" title="Student Management">
            <i class="fas fa-user-graduate"></i>
        </a>

        @* Manage Groups *@
        @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
        {
            var cssGroups = btnClass("Groups", "Index");
            <a href="@Url.Action("Index", "Groups")" class="@cssGroups" title="Manage Groups">
                <i class="fas fa-users"></i>
            </a>
        }

        @* Schedule *@
        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssSchedule = btnClass("Schedule", "Manage");
            <a href="@Url.Action("Manage", "Schedule")" class="@cssSchedule" title="Schedule">
                <i class="hgi hgi-stroke hgi-calendar-03"></i>
            </a>
        }

        @* WhatsApp *@
        @{
            var cssWhatsApp = btnClass("Whatsapp", "Index");
        }
        <a href="@Url.Action("Index", "Whatsapp")" class="@cssWhatsApp" title="WhatsApp">
            <i class="hgi hgi-stroke hgi-message-01"></i>
        </a>

        @* Assignments *@
        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssAssignments = btnClass("Assignments", "Index");
            <a href="@Url.Action("Index", "Assignments")" class="@cssAssignments" title="Assignments">
                <i class="fas fa-tasks"></i>
            </a>
        }

        @* Teacher Management*@
        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssTeachers = btnClass("TeacherManagement", "Index");
            <a href="@Url.Action("Index", "TeacherManagement")" class="@cssTeachers" title="Teachers">
                <i class="fa-solid fa-chalkboard-user"></i>
            </a>
        }

        @* Logging*@
        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssLog = btnClass("Logging", "Index");
            <a href="@Url.Action("Index", "Logging")" class="@cssLog" title="Logs">
                <i class="fa-solid fa-list"></i>
            </a>
        }

        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssDataConversion = btnClass("DataConversion", "Index");
            <a href="@Url.Action("Index", "DataConversion")" class="@cssDataConversion" title="DataConversion">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </a>
        }

        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssZoomMeetings = btnClass("ZoomMeetings", "Index");
            <a href="@Url.Action("Index", "ZoomMeetings")" class="@cssZoomMeetings" title="ZoomMeetings">
                <i class="hgi hgi-stroke hgi-zoom"></i>
            </a>
        }

        @if (User.IsInRole("admin") || User.IsInRole("support"))
        {
            var cssDepositIntoStudent = btnClass("StudentBalance", "Index");
            <a href="@Url.Action("Index", "StudentBalance")" class="@cssDepositIntoStudent" title="StudentBalance">
                <i class="fa-solid fa-money-bill-transfer"></i>
            </a>
        }
    </div>
</div>
