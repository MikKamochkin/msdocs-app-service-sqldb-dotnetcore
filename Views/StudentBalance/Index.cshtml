@model string
@{
    ViewData["Title"] = "Search Payer and Student";
    var students = ViewBag.Students as List<SelectListItem>;
    var payerNameSearched = ViewBag.payerNameSearched;
}

<div class="row no-gutters">
    <partial name="_AdminSidebar" />
    <div class="col-md-9">
        <h2>Find Payer by Name</h2>

        <form method="get" asp-action="SearchByPayer" asp-controller="StudentBalance" class="form-inline mb-4">
            <div class="form-group mr-2">
                <input type="text" name="payerName" class="form-control" placeholder="Enter payer name" required />
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        @if(payerNameSearched != null)
        {
            <b><h4><div>Students for: @payerNameSearched</div></h4></b>
        }
        @if (students != null && students.Count > 0)
        {
            <div class="list-group">
                @foreach (var student in students)
                {
                    <a asp-controller="StudentBalance"
                       asp-action="GoToStudent"
                       asp-route-id="@student.Value"
                       class="list-group-item list-group-item-action">
                        @student.Text
                    </a>
                }
            </div>
        }
        else if (Model != null)
        {
            <p>No students found for payer name: <strong>@Model</strong></p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("studentSelect")?.addEventListener("change", function () {
            const studentId = this.value;
            if (studentId) {
                window.location.href = `/StudentBalance/GoToStudent?id=${studentId}`;
            }
        });
    </script>
}
