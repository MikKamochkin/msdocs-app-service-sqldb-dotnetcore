@model List<DotNetCoreSqlDb.Models.StudentBalance>

@{
    ViewData["Title"] = "Update Balance";
    var studentName = ViewBag.StudentName as string;
    var studentId = ViewBag.StudentId;
    var transactions = ViewBag.Transactions as IEnumerable<dynamic>;
}

<div class="row no-gutters">
@if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
{
        <partial name="_AdminSidebar" />
}

    <div class="col-md-9">
        <h2>Assignments for @studentName</h2>

        @if (Model == null || !Model.Any())
        {
            <p>No assignments found for this student.</p>
        }
        else
        {
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Balance</th>
                        <th>Group Name</th>
                        <th>Teacher</th>
                        <th>StudentUnitCost</th>
                        <th>StudentUnitType</th>
                        <th>Lesson Duration</th>
                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var balance in Model)
                    {
                        <tr>

                            <td>@balance.Balance</td>
                            <td>@balance.Assignment.Group.Name</td>
                            <td>@balance.Assignment.Teacher.Name</td>
                            <td>@balance.Assignment.StudentUnitCost</td>
                            <td>@balance.Assignment.StudentUnitType</td>
                            <td>@balance.Assignment.StudentUnitDuration</td>
                            <td>
                                <button class="btn btn-sm btn-primary" data-toggle="modal" data-target="#balanceModal"
                                    data-id="@balance.Id" data-current="@balance.Balance">
                                    Add Amount
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="student-balance-transactions-table-container">
            <div class="student-balance-transactions-table-wrapper">
                <div class="transaction-layout">
                    <div class="transaction-history">
                        <h3>Recent Transaction History</h3>
                        <table class="table student-balance-transactions-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Teacher</th>
                                    <th>Units Added</th>
                                </tr>
                            </thead>
                    
                    <tbody>
                        @if (transactions != null && transactions.Any())
                        {
                            foreach (var tx in transactions)
                            {
                                <tr data-id="@tx.Id">
                                    <td>@tx.DateTime?.ToString("g")</td>
                                    <td>@tx.Assignment?.Teacher?.Name</td>
                                    <td>@tx.TransactionAmount</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">No transactions yet.</td>
                            </tr>
                        }
                    </tbody>
                    </table>
                    </div>

                    <hr />
                    <div class="transaction-details">
                    <h3>Transaction Details</h3>
                    <table id="transactionDetailsTable" class="table table-bordered">
                        <tbody>
                            <tr>
                                <th scope="row">Date</th>
                                <td id="tdDate">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Teacher</th>
                                <td id="tdTeacher">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Units</th>
                                <td id="tdUnits">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Amount Paid</th>
                                <td id="tdAmountPaid">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Currency</th>
                                <td id="tdCurrency">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Payer Notes</th>
                                <td id="tdPayerNotes">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Admin Notes</th>
                                <td id="tdAdminNotes">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Reference</th>
                                <td id="tdReference">—</td>
                            </tr>
                            <tr>
                                <th scope="row">Type</th>
                                <td id="tdType">—</td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <!-- Modal -->
    <div class="modal fade" id="balanceModal" tabindex="-1" role="dialog" aria-labelledby="balanceModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form method="post" asp-action="AddToBalance" asp-controller="StudentBalance">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="balanceModalLabel">Add to Balance</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="balanceId" id="balanceId" />
                        <div class="form-group">
                            <label for="unitsToAdd">Units to Add</label>
                            <input type="number" step="0.01" name="unitsToAdd" id="unitsToAdd" class="form-control"
                                required />
                        </div>

                        <!-- New String Fields -->
                        <div class="form-group">
                            <label for="amountPaid">Amount Paid</label>
                            <input type="text" name="amountPaid" id="amountPaid" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="adminNotes">AdminNotes</label>
                            <input type="text" name="adminNotes" id="adminNotes" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="currency">Currency</label>
                            @Html.DropDownList(
                                "currency",  // <-- must be "currency" to bind
                                new SelectList((IEnumerable<SelectListItem>)ViewBag.PayUnitTypes, "Value", "Text", ViewBag.DefaultCurrency),
                                null,        // no placeholder; CAD will be selected
                                new { @class = "form-control", id = "currency" }
                            )
                        </div>
                        <div class="form-group">
                            <label for="payerNotes">Payer Notes</label>
                            <input type="text" name="payerNotes" id="payerNotes" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="paymentReference">Payment Reference</label>
                            <input type="text" name="paymentReference" id="paymentReference" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="paymentType">Payment Type</label>
                            <input type="text" 
                                name="paymentType" 
                                id="paymentType" 
                                class="form-control" 
                                value="@ViewBag.DefaultPaymentType" />
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Apply</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </div>


@section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>


        <script>
            $('#balanceModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var balanceId = button.data('id');

                var modal = $(this);
                modal.find('#balanceId').val(balanceId);
                modal.find('#unitsToAdd').val('');
                modal.find('#amountPaid').val('');
                modal.find('#adminNotes').val('');
                modal.find('#currency').val('CAD');
                modal.find('#payerNotes').val('');
                modal.find('#paymentReference').val('');
                modal.find('#paymentType').val('@ViewBag.DefaultPaymentType');

            });
        </script>
        <script>
            $(function () {
                $('.student-balance-transactions-table tbody').on('click', 'tr[data-id]', function () {
                    var $row = $(this);
                    var id = $row.data('id');

                    // Highlight the selected row
                    $row.addClass('table-active').siblings().removeClass('table-active');

                    // Fetch details
                    $.get('@Url.Action("GetTransactionDetails", "StudentBalance")', { transactionLogId: id })
                        .done(function (data) {
                            $('#tdDate').text(data.dateTime || '—');
                            $('#tdTeacher').text(data.teacher || '—');
                            $('#tdUnits').text(data.units || '—');
                            $('#tdAmountPaid').text(data.amountPaid || '—');
                            $('#tdCurrency').text(data.currency || '—');
                            $('#tdPayerNotes').text(data.payerNotes || '—');
                            $('#tdAdminNotes').text(data.adminNotes || '—');
                            $('#tdReference').text(data.reference || '—');
                            $('#tdType').text(data.type || '—');

                        })
                        .fail(function () {
                            alert('Could not load details.');
                        });
                });
            });
        </script>
}
