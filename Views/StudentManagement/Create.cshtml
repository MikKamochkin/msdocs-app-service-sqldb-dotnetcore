@model DotNetCoreSqlDb.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />
        <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ParentOrEmployer, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ParentOrEmployer, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ParentOrEmployer, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MainNotes, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MainNotes, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MainNotes, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Source dropdown -->
        <div class="form-group">
            @Html.LabelFor(model => model.Source, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Source, (IEnumerable<SelectListItem>)ViewBag.SourceTypes, "Select Source", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Source, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Timezone dropdown -->
        <div class="form-group">
            @Html.LabelFor(model => model.TimeZoneId, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.TimeZoneId, (IEnumerable<SelectListItem>)ViewBag.TimeZones, "Select Time Zone", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TimeZoneId, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Accounting Group field: only visible to admin users -->
        @if (User.IsInRole("admin"))
        {
            <div class="form-group">
                @Html.LabelFor(model => model.AccountingGroup, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.AccountingGroup, (IEnumerable<SelectListItem>)ViewBag.AccountingGroupTypes, "Accounting Group", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.AccountingGroup, "", new { @class = "text-danger" })
                </div>
            </div>
        }

        <h4>Contact Information</h4>
        <!-- The contact summary table will be rendered here -->
        <div id="contacts">
            <table id="contactsSummary" style="margin-top:20px;" class="table table-bordered d-none">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Value</th>
                        <th>Invitation</th>
                        <th>Emergency</th>
                        <th>Money</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
        <!-- Button to open the modal -->
        <button type="button" id="addContact" class="btn btn-secondary">Add Contact Information</button>
        <br /><br />

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<!-- Modal for adding a new contact -->
<div id="contactModal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog">
    <div class="modal-content">
       <div class="modal-header">
           <h5 class="modal-title">Add Contact Information</h5>
       </div>
       <div class="modal-body">
         <div class="form-group">
            <label class="control-label">Contact Type</label>
            @Html.DropDownList("modalContactType", new SelectList(ViewBag.ContactTypes, "Value", "Text"), "Select Contact Type", new { @class = "form-control", id="modalContactType" })
         </div>
         <div class="form-group">
            <label class="control-label">Value</label>
            @Html.TextBox("modalContactValue", null, new { @class = "form-control", id="modalContactValue" })
         </div>
         <div class="form-group">
            <label class="control-label">Invitation</label>
            <div>
                @Html.CheckBox("modalContactInvitation", false, new { id="modalContactInvitation" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Emergency</label>
            <div>
                @Html.CheckBox("modalContactEmergency", false, new { id="modalContactEmergency" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Money</label>
            <div>
                @Html.CheckBox("modalContactMoney", false, new { id="modalContactMoney" })
            </div>
         </div>
       </div>
       <div class="modal-footer">
         <button type="button" id="modalCancel" class="btn btn-secondary">Cancel</button>
         <button type="button" id="modalSave" class="btn btn-primary">Save</button>
       </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script type="text/javascript">
        var contactCount = 0;
        var editingContactIndex = null;

        function addContactSummary(index, contactType, typeText, value, invitationBool, emergencyBool, moneyBool) {
            $("#contactsSummary").removeClass("d-none");
            
            var summaryRow =
                '<tr class="contact-summary" data-index="' + index + '">' +
                    '<td>' + typeText + '</td>' +
                    '<td>' + value + '</td>' +
                    '<td>' + (invitationBool ? "✔" : "") + '</td>' +
                    '<td>' + (emergencyBool ? "✔" : "") + '</td>' +
                    '<td>' + (moneyBool ? "✔" : "") + '</td>' +
                    '<td>' +
                        '<button type="button" class="btn btn-sm btn-primary edit-contact">Edit</button> ' +
                        '<button type="button" class="btn btn-sm btn-danger delete-contact">Delete</button>' +
                    '</td>' +
                    '<td style="display:none;">' +
                        '<input type="hidden" name="Contacts[' + index + '].Type" value="' + contactType + '" />' +
                        '<input type="hidden" name="Contacts[' + index + '].Value" value="' + value + '" />' +
                        '<input type="hidden" name="Contacts[' + index + '].Invitation" value="' + invitationBool + '" />' +
                        '<input type="hidden" name="Contacts[' + index + '].Emergency" value="' + emergencyBool + '" />' +
                        '<input type="hidden" name="Contacts[' + index + '].Money" value="' + moneyBool + '" />' +
                    '</td>' +
                '</tr>';
            $("#contactsSummary tbody").append(summaryRow);
        }

        $(document).ready(function() {
            $("#contactModal").modal({
                backdrop: 'static',
                keyboard: false,
                show: false
            });

            $("#addContact").click(function() {
                editingContactIndex = null;
                $("#modalContactType").val("");
                $("#modalContactValue").val("");
                $("#modalContactInvitation").prop("checked", false);
                $("#modalContactEmergency").prop("checked", false);
                $("#modalContactMoney").prop("checked", false);
                $("#contactModal").modal('show');
            });

            $(document).on("click", ".edit-contact", function(e) {
                e.stopPropagation();
                var $row = $(this).closest("tr");
                editingContactIndex = $row.data("index");
                
                var $hiddenInputs = $row.find("td:last input[type='hidden']");
                $("#modalContactType").val($hiddenInputs.filter("[name$='.Type']").val());
                $("#modalContactValue").val($hiddenInputs.filter("[name$='.Value']").val());
                $("#modalContactInvitation").prop("checked", $hiddenInputs.filter("[name$='.Invitation']").val().toLowerCase() === "true");
                $("#modalContactEmergency").prop("checked", $hiddenInputs.filter("[name$='.Emergency']").val().toLowerCase() === "true");
                $("#modalContactMoney").prop("checked", $hiddenInputs.filter("[name$='.Money']").val().toLowerCase() === "true");
                
                $("#contactModal").modal("show");
            });

            $(document).on("click", ".delete-contact", function(e) {
                e.stopPropagation();
                if (confirm("Are you sure you want to delete this contact?")) {
                    $(this).closest("tr").remove();
                    if ($("#contactsSummary tbody tr").length === 0) {
                        $("#contactsSummary").addClass("d-none");
                    }
                    // Reindex remaining contacts
                    $("#contactsSummary tbody tr").each(function(newIndex) {
                        var $row = $(this);
                        $row.attr("data-index", newIndex);
                        $row.find("input[type='hidden']").each(function() {
                            var $input = $(this);
                            var name = $input.attr("name");
                            var newName = name.replace(/\[\d+\]/, "[" + newIndex + "]");
                            $input.attr("name", newName);
                        });
                    });
                    contactCount = $("#contactsSummary tbody tr").length;
                }
            });

            $("#modalSave").click(function() {
                var contactType = $("#modalContactType").val();
                var typeText = $("#modalContactType option:selected").text();
                var value = $("#modalContactValue").val();
                var invitationBool = $("#modalContactInvitation").is(":checked");
                var emergencyBool = $("#modalContactEmergency").is(":checked");
                var moneyBool = $("#modalContactMoney").is(":checked");

                if (!contactType || !value) {
                    alert("Please fill in both Contact Type and Value.");
                    return;
                }

                if (editingContactIndex !== null) {
                    var $row = $("tr.contact-summary[data-index='" + editingContactIndex + "']");
                    $row.find("td:eq(0)").text(typeText);
                    $row.find("td:eq(1)").text(value);
                    $row.find("td:eq(2)").text(invitationBool ? "✔" : "");
                    $row.find("td:eq(3)").text(emergencyBool ? "✔" : "");
                    $row.find("td:eq(4)").text(moneyBool ? "✔" : "");
                    
                    var $hiddenInputs = $row.find("td:last input[type='hidden']");
                    $hiddenInputs.filter("[name$='.Type']").val(contactType);
                    $hiddenInputs.filter("[name$='.Value']").val(value);
                    $hiddenInputs.filter("[name$='.Invitation']").val(invitationBool);
                    $hiddenInputs.filter("[name$='.Emergency']").val(emergencyBool);
                    $hiddenInputs.filter("[name$='.Money']").val(moneyBool);
                } else {
                    addContactSummary(contactCount, contactType, typeText, value, invitationBool, emergencyBool, moneyBool);
                    contactCount++;
                }
                
                $("#contactModal").modal('hide');
            });

            $("#modalCancel").click(function() {
                editingContactIndex = null;
                $("#contactModal").modal('hide');
            });

            $("form").submit(function(e) {
                if ($("#contactsSummary tbody tr").length === 0) {
                    alert("Please add at least one contact.");
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}