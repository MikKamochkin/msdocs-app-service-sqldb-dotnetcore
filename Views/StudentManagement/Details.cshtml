@model DotNetCoreSqlDb.Models.Student

@{
    ViewData["Title"] = "Student Details";
    
    string studentNumber = ViewBag.StudentNumber; 
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
    }
    <div class="col">
        <h2>Student Details</h2>

        <div>
            <h4>Student</h4>
            <hr />
            <dl class="dl-horizontal">
                <dt>Name</dt>
                <dd>@Html.DisplayFor(model => model.Name)</dd>
                <dt>Student Number</dt>
                <dd>@studentNumber</dd>
                <dt>Parent/Employer</dt>
                <dd>@Html.DisplayFor(model => model.ParentOrEmployer)</dd>
                <dt>Main Notes</dt>
                <dd>@Html.DisplayFor(model => model.MainNotes)</dd>
                <dt>Created Date</dt>
                <dd>@Html.DisplayFor(model => model.CreatedDate)</dd>
                <dt>Source</dt>
                <dd>@Html.DisplayFor(model => model.Source)</dd>
                <dt>Time Zone</dt>
                <dd>@Html.DisplayFor(model => model.TimeZoneId)</dd>
                @if(User.IsInRole("admin") || User.IsInRole("support"))
                {
                    <dt>Accounting Group</dt>
                    <dd>@Html.DisplayFor(model => model.AccountingGroup)</dd>
                }
            </dl>
        </div>

        <h4>Contact Information</h4>
        @if(Model.Contacts != null && Model.Contacts.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Value</th>
                        <th>Invitation</th>
                        <th>Emergency</th>
                        <th>Money</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var contact in Model.Contacts)
                    {
                        <tr>
                            <td>@Html.DisplayFor(m => contact.Type)</td>
                            <td>@Html.DisplayFor(m => contact.Value)</td>
                            <td>@(contact.Invitation ? "✔" : "")</td>
                            <td>@(contact.Emergency ? "✔" : "")</td>
                            <td>@(contact.Money ? "✔" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No contact information available.</p>
        }

        <h4>Payer Information</h4>
        @if(Model.Payers != null && Model.Payers.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var payer in Model.Payers)
                    {
                        <tr>
                            <td>@Html.DisplayFor(m => payer.Name)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No Payers</p>
        }

        <h4><a asp-controller="StudentBalance"
            asp-action="UpdateBalance"
            asp-route-id="@Model.ID"
            class="btn btn-dark">
                Go To Balance Info
            </a>
        </h4>

        <div class="details-buttons">
            <a  
                href='@Url.Action("Edit", new { id = Model.ID })'
                class="btn btn-dark icon-btn"
                title="Edit Student">
                <i class="fa-solid fa-pencil"></i>
            </a>
            <a 
                href='@Url.Action("Index")'
                class="btn btn-dark icon-btn"
                title="Back to List">
                <i class="hgi hgi-stroke hgi-arrow-turn-backward"></i>
            </a>
            </div>

    </div>
</div>
