@model DotNetCoreSqlDb.Controllers.StudentManagementController.PagedResult<DotNetCoreSqlDb.Controllers.StudentManagementController.StudentListItemVM>


@{
    ViewData["Title"] = "Students List";

    // Sorting + search state
    string currentSort = ViewBag.CurrentSort as string ?? "createdDate_desc";
    string nameSortParam = currentSort == "Name" ? "name_desc" : "Name";
    string dateSortParam = currentSort == "CreatedDate" ? "createdDate_desc" : "CreatedDate";
    string q = ViewBag.Query as string ?? "";

    // Paging state (renamed to avoid '@page' Razor directive confusion)
    int pageNumber = ViewBag.Page is int ? (int)ViewBag.Page : (Model?.Page ?? 1);
    int pageSize = ViewBag.PageSize is int ? (int)ViewBag.PageSize : (Model?.PageSize ?? 50);
    int total = ViewBag.Total is int ? (int)ViewBag.Total : (Model?.TotalCount ?? 0);
    int totalPagesCount = Math.Max(1, (int)Math.Ceiling((double)total / Math.Max(1, pageSize)));

    // One-time creds (from TempData set in Create/Edit POST)
    var newName = TempData["JustCreatedOrChangedStudentName"] as string;
    var newUser = TempData["JustCreatedOrChangedStudentUsername"] as string;
    var newPass = TempData["JustCreatedOrChangedStudentPassword"] as string;
    bool hasNewCreds = !string.IsNullOrWhiteSpace(newUser) && !string.IsNullOrWhiteSpace(newPass);
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
        <div class="col-md-10">
            <h2>Students List</h2>

            @* One-time credentials modal *@
            @if (hasNewCreds)
            {
                <div id="credsModal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false"
                     aria-labelledby="credsModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 id="credsModalLabel" class="modal-title">Student Created</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close" id="modalXClose">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="white-space:nowrap; overflow:auto;">
                                @if (!string.IsNullOrWhiteSpace(newName))
                                {
                                    <p><strong>Name:</strong> @newName</p>
                                }
                                <p><strong>Student Number:</strong> <code id="newUserVal">@newUser</code></p>
                                <p><strong>Password:</strong> <code id="newPassVal">@newPass</code></p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" id="copyBtn" class="btn btn-primary" onclick="copyCreds()">Copy</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <p>
                <a href="@Url.Action("Create")" class="btn btn-primary">Create New Student</a>
            </p>

            @* Search + page size *@
            <form method="get" class="form-inline mb-3">
                <input type="text" name="q" value="@q" class="form-control mr-2" style="min-width:280px"
                       placeholder="Search name, phone, email, employer..." />
                <input type="hidden" name="sortOrder" value="@currentSort" />
                <input type="hidden" name="page" value="1" />
                <select name="pageSize" class="form-control mr-2" onchange="this.form.submit()">
                    @{
                        int[] sizes = new[] { 25, 50, 100, 200 };
                        foreach (var s in sizes)
                        {
                            if (s == pageSize)
                            {
                                <option value="@s" selected>@s / page</option>
                            }
                            else
                            {
                                <option value="@s">@s / page</option>
                            }
                        }
                    }
                </select>
                <button type="submit" class="btn btn-secondary">Search</button>
            </form>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = nameSortParam, q = q, page = 1, pageSize = pageSize })">
                                Name
                                @if (currentSort == "Name")
                                {
                                    <span>&#9650;</span>
                                }
                                else if (currentSort == "name_desc")
                                {
                                    <span>&#9660;</span>
                                }
                            </a>
                        </th>
                        <th class="fixedCol">Parent/Employer</th>
                        <th class="fixedCol">Phone Number</th>
                        <th>Email</th>
                        <th>PasswordReset?</th>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = dateSortParam, q = q, page = 1, pageSize = pageSize })">
                                Created Date
                                @if (currentSort == "CreatedDate")
                                {
                                    <span>&#9650;</span>
                                }
                                else if (currentSort == "createdDate_desc")
                                {
                                    <span>&#9660;</span>
                                }
                            </a>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.ParentOrEmployer</td>
                            <td class="fixedCol">@item.Phone</td>
                            <td class="fixedCol">@item.Email</td>
                            <td>
                                @if (item.HasPasswordReset)
                                {
                                    <i class="fa-solid fa-check text-success" title="Password was set/reset"></i>
                                }
                            </td>
                            <td>
                                <span class="localDate" data-utc="@item.CreatedDate.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")"></span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.ID })"><i class="fa-solid fa-circle-info btn-lg text-dark"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Pager *@
            <nav aria-label="Students pages">
                <ul class="pagination">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { sortOrder = currentSort, q = q, page = pageNumber - 1, pageSize = pageSize })">Prev</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@(pageNumber) / @(totalPagesCount) (@total total)</span>
                    </li>
                    <li class="page-item @(pageNumber >= totalPagesCount ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { sortOrder = currentSort, q = q, page = pageNumber + 1, pageSize = pageSize })">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
    else
    {
        <div class="col-md-12">
            <h2>Students List</h2>

            <p>
                <a href="@Url.Action("Create")" class="btn btn-primary">Create New Student</a>
            </p>

            @* Search + page size (non-admin view) *@
            <form method="get" class="form-inline mb-3">
                <input type="text" name="q" value="@q" class="form-control mr-2" style="min-width:280px"
                       placeholder="Search name, phone, email, employer..." />
                <input type="hidden" name="sortOrder" value="@currentSort" />
                <input type="hidden" name="page" value="1" />
                <select name="pageSize" class="form-control mr-2" onchange="this.form.submit()">
                    @{
                        int[] sizes = new[] { 25, 50, 100, 200 };
                        foreach (var s in sizes)
                        {
                            if (s == pageSize)
                            {
                                <option value="@s" selected>@s / page</option>
                            }
                            else
                            {
                                <option value="@s">@s / page</option>
                            }
                        }
                    }
                </select>
                <button type="submit" class="btn btn-secondary">Search</button>
            </form>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = nameSortParam, q = q, page = 1, pageSize = pageSize })">
                                Name
                                @if (currentSort == "Name")
                                {
                                    <span>&#9650;</span>
                                }
                                else if (currentSort == "name_desc")
                                {
                                    <span>&#9660;</span>
                                }
                            </a>
                        </th>
                        <th class="fixedCol">Parent/Employer</th>
                        <th class="fixedCol">Phone Number</th>
                        <th>Email</th>
                        <th>
                            <a href="@Url.Action("Index", new { sortOrder = dateSortParam, q = q, page = 1, pageSize = pageSize })">
                                Created Date
                                @if (currentSort == "CreatedDate")
                                {
                                    <span>&#9650;</span>
                                }
                                else if (currentSort == "createdDate_desc")
                                {
                                    <span>&#9660;</span>
                                }
                            </a>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.ParentOrEmployer</td>
                            <td class="fixedCol">@item.Phone</td>
                            <td class="fixedCol">@item.Email</td>
                            <td>
                                <span class="localDate" data-utc="@item.CreatedDate.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ")"></span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.ID })">🛈</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Pager (non-admin) *@
            <nav aria-label="Students pages">
                <ul class="pagination">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { sortOrder = currentSort, q = q, page = pageNumber - 1, pageSize = pageSize })">Prev</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">@(pageNumber) / @(totalPagesCount) (@total total)</span>
                    </li>
                    <li class="page-item @(pageNumber >= totalPagesCount ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { sortOrder = currentSort, q = q, page = pageNumber + 1, pageSize = pageSize })">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script>
        // When the document loads, convert each UTC date to the user's local time.
        $(document).ready(function () {
            $('.localDate').each(function () {
                var utcStr = $(this).data('utc');
                if (utcStr) {
                    var dateObj = new Date(utcStr);
                    // Convert to a locale-specific string (this will adjust for timezone and date changes)
                    $(this).text(dateObj.toLocaleString());
                }
            });

            // If the modal is on the page, show it now
            var $credsModal = $('#credsModal');
            if ($credsModal.length) {
                $credsModal.modal('show');

                // Also support closing via the "X" button if data-dismiss isn't wired for some reason
                $('#modalXClose').on('click', function () { $credsModal.modal('hide'); });
            }
        });

        // Copy creds helper
        function copyCreds() {
            var u = document.getElementById('newUserVal') ? document.getElementById('newUserVal').innerText : '';
            var p = document.getElementById('newPassVal') ? document.getElementById('newPassVal').innerText : '';
            var t = 'Student Number: ' + u + '\nPassword: ' + p + '\nhttps://torontofrench.ca';

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(t);
            } else {
                var ta = document.createElement('textarea');
                ta.value = t;
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) { }
                document.body.removeChild(ta);
            }
        }
    </script>
}
