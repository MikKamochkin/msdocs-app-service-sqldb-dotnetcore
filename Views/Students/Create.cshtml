@model DotNetCoreSqlDb.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

@* Display validation errors, including the contact validation error *@
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />
        <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ParentOrEmployer, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ParentOrEmployer, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ParentOrEmployer, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MainNotes, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MainNotes, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MainNotes, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Source dropdown -->
        <div class="form-group">
            @Html.LabelFor(model => model.Source, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Source, (IEnumerable<SelectListItem>)ViewBag.SourceTypes, "Select Source", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Source, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4>Contact Information</h4>
        <!-- The contact summary (with hidden inputs) will be rendered here -->
        <div id="contacts"></div>
        <!-- Button to open the modal -->
        <button type="button" id="addContact" class="btn btn-secondary">Add Another Contact</button>
        <br /><br />

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<!-- Modal for adding/editing a contact -->
<div id="contactModal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog">
    <div class="modal-content">
       <div class="modal-header">
           <h5 class="modal-title" id="contactModalTitle">Add Contact</h5>
       </div>
       <div class="modal-body">
         <div class="form-group">
            <label class="control-label">Contact Type</label>
            @Html.DropDownList("modalContactType", new SelectList(ViewBag.ContactTypes, "Value", "Text"), "Select Contact Type", new { @class = "form-control", id = "modalContactType" })
         </div>
         <div class="form-group">
            <label class="control-label">Value</label>
            @Html.TextBox("modalContactValue", null, new { @class = "form-control", id = "modalContactValue" })
         </div>
         <div class="form-group">
            <label class="control-label">Invitation</label>
            <div>
                @Html.CheckBox("modalContactInvitation", false, new { id = "modalContactInvitation" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Emergency</label>
            <div>
                @Html.CheckBox("modalContactEmergency", false, new { id = "modalContactEmergency" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Money</label>
            <div>
                @Html.CheckBox("modalContactMoney", false, new { id = "modalContactMoney" })
            </div>
         </div>
       </div>
       <div class="modal-footer">
         <button type="button" id="modalCancel" class="btn btn-secondary">Cancel</button>
         <button type="button" id="modalSave" class="btn btn-primary">Save</button>
       </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <!-- Ensure Bootstrap's JavaScript is loaded -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script type="text/javascript">
        // Global counters/variables:
        var contactCount = 0;
        // Holds the index of the contact currently being edited; null if adding a new contact.
        var editingContactIndex = null;

        // Function to add a new contact summary row with data attributes.
        function addContactSummary(index, contactType, typeText, value, invitationBool, emergencyBool, moneyBool) {
            // Create the summary table if it doesn't exist.
            if ($("#contactsSummary").length === 0) {
                var tableHtml =
                    '<table id="contactsSummary" style="margin-top:20px;" class="table table-bordered">' +
                        '<thead>' +
                            '<tr>' +
                                '<th>Type</th>' +
                                '<th>Value</th>' +
                                '<th>Invitation</th>' +
                                '<th>Emergency</th>' +
                                '<th>Money</th>' +
                            '</tr>' +
                        '</thead>' +
                        '<tbody></tbody>' +
                    '</table>';
                $("#contacts").after(tableHtml);
            }
            
            var summaryRow =
                '<tr class="contact-summary" data-index="' + index + '" ' +
                'data-contacttype="' + contactType + '" ' +
                'data-contactvalue="' + value + '" ' +
                'data-invitation="' + invitationBool + '" ' +
                'data-emergency="' + emergencyBool + '" ' +
                'data-money="' + moneyBool + '">' +
                    '<td>' + typeText + '</td>' +
                    '<td>' + value + '</td>' +
                    '<td>' + (invitationBool ? "Yes" : "No") + '</td>' +
                    '<td>' + (emergencyBool ? "Yes" : "No") + '</td>' +
                    '<td>' + (moneyBool ? "Yes" : "No") + '</td>' +
                    '<td style="display:none;">' +
                        '<input type="hidden" name="Contacts[' + index + '].Type" value="' + contactType + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Value" value="' + value + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Invitation" value="' + invitationBool + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Emergency" value="' + emergencyBool + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Money" value="' + moneyBool + '"/>' +
                    '</td>' +
                '</tr>';
            $("#contactsSummary tbody").append(summaryRow);
        }

        $(document).ready(function() {
            // Initialize the modal with a static backdrop and disabled keyboard.
            $("#contactModal").modal({
                backdrop: 'static',
                keyboard: false,
                show: false
            });

            // When the "Add Another Contact" button is clicked, clear modal fields and set mode to "add".
            $("#addContact").click(function(e) {
                editingContactIndex = null;
                $("#contactModalTitle").text("Add Contact");
                $("#modalContactType").val("");
                $("#modalContactValue").val("");
                $("#modalContactInvitation").prop("checked", false);
                $("#modalContactEmergency").prop("checked", false);
                $("#modalContactMoney").prop("checked", false);
                $("#contactModal").modal('show');
            });

            // Delegate click event to the summary rows to enable editing.
            $(document).on("click", "#contactsSummary tbody tr.contact-summary", function(e) {
                // Retrieve the current row's data.
                var $row = $(this);
                editingContactIndex = $row.data("index");
                $("#modalContactType").val($row.data("contacttype"));
                $("#modalContactValue").val($row.data("contactvalue"));
                $("#modalContactInvitation").prop("checked", $row.data("invitation"));
                $("#modalContactEmergency").prop("checked", $row.data("emergency"));
                $("#modalContactMoney").prop("checked", $row.data("money"));
                $("#contactModalTitle").text("Edit Contact");
                $("#contactModal").modal("show");
            });

            // When Save is clicked in the modal.
            $("#modalSave").click(function() {
                var contactType = $("#modalContactType").val();
                var typeText = $("#modalContactType option:selected").text();
                var value = $("#modalContactValue").val();
                var invitationBool = $("#modalContactInvitation").is(":checked");
                var emergencyBool  = $("#modalContactEmergency").is(":checked");
                var moneyBool      = $("#modalContactMoney").is(":checked");

                // Validate that at least one field is filled (if necessary).
                if (!contactType && !value && !invitationBool && !emergencyBool && !moneyBool) {
                    $("#contactModal").modal('hide');
                    return;
                }

                // If editing an existing contact, update that row.
                if (editingContactIndex !== null) {
                    var $row = $("#contactsSummary tbody tr.contact-summary[data-index='" + editingContactIndex + "']");
                    $row.find("td:nth-child(1)").text(typeText);
                    $row.find("td:nth-child(2)").text(value);
                    $row.find("td:nth-child(3)").text(invitationBool ? "Yes" : "No");
                    $row.find("td:nth-child(4)").text(emergencyBool ? "Yes" : "No");
                    $row.find("td:nth-child(5)").text(moneyBool ? "Yes" : "No");
                    
                    var hiddenHtml = 
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Type" value="' + contactType + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Value" value="' + value + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Invitation" value="' + invitationBool + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Emergency" value="' + emergencyBool + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Money" value="' + moneyBool + '"/>';
                    $row.find("td:last").html(hiddenHtml);
                    
                    // Update data attributes.
                    $row.data("contacttype", contactType);
                    $row.data("contactvalue", value);
                    $row.data("invitation", invitationBool);
                    $row.data("emergency", emergencyBool);
                    $row.data("money", moneyBool);
                    
                    editingContactIndex = null;
                } else {
                    // Otherwise, add a new contact summary row.
                    addContactSummary(contactCount, contactType, typeText, value, invitationBool, emergencyBool, moneyBool);
                    contactCount++;
                }
                
                $("#contactModal").modal('hide');
            });

            // Cancel button simply closes the modal.
            $("#modalCancel").click(function() {
                editingContactIndex = null;
                $("#contactModal").modal('hide');
            });

            // Client-side check: Before form submission, ensure at least one contact is added.
            $("form").submit(function(e) {
                if ($("#contactsSummary tbody tr").length === 0) {
                    alert("Please add at least one contact.");
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
