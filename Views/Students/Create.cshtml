@model DotNetCoreSqlDb.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />
        <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ParentOrEmployer, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ParentOrEmployer, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ParentOrEmployer, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MainNotes, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MainNotes, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MainNotes, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.CreatedDate, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4>Contact Information</h4>

        <!-- Empty initially. We'll add contact-entry blocks via JS. -->
        <div id="contacts"></div>

        <button type="button" id="addContact" class="btn btn-secondary">Add Another Contact</button>
        <br /><br />

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<!-- Hidden template for new contact entry -->
<div id="contactTemplate" style="display:none;">
    <div class="contact-entry">
        <div class="entry-input">
            <div class="form-group">
                <label class="control-label col-md-2">Contact Type</label>
                <div class="col-md-10">
                    @Html.DropDownList("Contacts[INDEX].Type", new SelectList(ViewBag.ContactTypes, "Value", "Text"), 
                                       "Select Contact Type", 
                                       new { @class = "form-control contact-type" })
                </div>
            </div>
            <div class="contact-fields">
                <div class="form-group">
                    <label class="control-label col-md-2">Value</label>
                    <div class="col-md-10">
                        @Html.TextBox("Contacts[INDEX].Value", null, new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2">Invitation</label>
                    <div class="col-md-10">
                        @Html.CheckBox("Contacts[INDEX].Invitation", false)
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2">Emergency</label>
                    <div class="col-md-10">
                        @Html.CheckBox("Contacts[INDEX].Emergency", false)
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-md-2">Money</label>
                    <div class="col-md-10">
                        @Html.CheckBox("Contacts[INDEX].Money", false)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script type="text/javascript">

        // A helper function to finalize (summarize) the last contact entry, if it isn't summarized yet.
        function finalizeLastContact() {
            var currentEntry = $("#contacts .contact-entry").last();
            // Only proceed if there's a contact entry AND it's not already summarized
            if (currentEntry.length > 0 && currentEntry.find(".contact-summary").length === 0) {

                // Gather data
                var contactType = currentEntry.find("select.contact-type").val();
                var typeText    = currentEntry.find("select.contact-type option:selected").text();
                var value       = currentEntry.find("input[name$='.Value']").val();
                var invitation  = currentEntry.find("input[name$='.Invitation']").is(":checked") ? "Yes" : "No";
                var emergency   = currentEntry.find("input[name$='.Emergency']").is(":checked") ? "Yes" : "No";
                var money       = currentEntry.find("input[name$='.Money']").is(":checked") ? "Yes" : "No";

                // Optional check: if contact type is required, enforce that:
                if (!contactType) {
                    alert("Please select a contact type before finalizing this contact.");
                    return;
                }

                // If the summary table doesn't exist yet, create it now
                if ($("#contactsSummary").length === 0) {
                    var tableHtml =
                        '<table id="contactsSummary" style="margin-top:20px;">' +
                            '<thead>' +
                                '<tr>' +
                                    '<th>Type</th>' +
                                    '<th>Value</th>' +
                                    '<th>Invitation</th>' +
                                    '<th>Emergency</th>' +
                                    '<th>Money</th>' +
                                '</tr>' +
                            '</thead>' +
                            '<tbody></tbody>' +
                        '</table>';
                    // Insert the table below the #contacts container
                    $("#contacts").after(tableHtml);
                }

                // Create a row for the table
                var summaryHtml = '<tr class="contact-summary">' +
                                    '<td>' + (typeText || '') + '</td>' +
                                    '<td>' + (value || '') + '</td>' +
                                    '<td>' + invitation + '</td>' +
                                    '<td>' + emergency + '</td>' +
                                    '<td>' + money + '</td>' +
                                  '</tr>';

                // Append the new row to the table and remove the input form
                $("#contactsSummary tbody").append(summaryHtml);
                currentEntry.remove();
            }
        }

        $(document).ready(function() {

            // 1) When user clicks the "Add Another Contact" button
            $("#addContact").click(function() {
                // First, finalize the last contact (if any) before adding a new one
                finalizeLastContact();

                // Now add a fresh contact entry
                var index = $("#contacts .contact-entry").length;
                var templateHtml = $("#contactTemplate").html();
                templateHtml = templateHtml.replace(/INDEX/g, index);
                $("#contacts").append(templateHtml);
            });

            // 2) When user clicks *anywhere* on the page (document),
            //    if the click is outside the last contact entry, finalize it.
            $(document).on("click", function(e) {
                var $target = $(e.target);
                var $lastContactEntry = $("#contacts .contact-entry").last();

                // Only proceed if there's a last contact entry,
                // and the user clicked outside it (no overlap with that entry)
                if ($lastContactEntry.length > 0 &&
                    $target.closest($lastContactEntry).length === 0) {
                    finalizeLastContact();
                }
            });

        });
    </script>
}
