@model DotNetCoreSqlDb.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit Student</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ID)

    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />
        <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ParentOrEmployer, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ParentOrEmployer, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ParentOrEmployer, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MainNotes, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MainNotes, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MainNotes, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Source dropdown -->
        <div class="form-group">
            @Html.LabelFor(model => model.Source, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Source, (IEnumerable<SelectListItem>)ViewBag.SourceTypes, "Select Source", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Source, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Timezone dropdown -->
        <div class="form-group">
            @Html.LabelFor(model => model.TimeZoneId, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.TimeZoneId, (IEnumerable<SelectListItem>)ViewBag.Timezones, "Select Time Zone", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TimeZoneId, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Accounting Group (admin only) -->
        @if (User.IsInRole("admin"))
        {
            <div class="form-group">
                @Html.LabelFor(model => model.AccountingGroup, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.AccountingGroup, (IEnumerable<SelectListItem>)ViewBag.AccountingGroupTypes, "Select Accounting Group", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.AccountingGroup, "", new { @class = "text-danger" })
                </div>
            </div>
        }

        <h4>Contact Information</h4>
        <div id="contacts">
            @if (Model.Contacts != null && Model.Contacts.Any())
            {
                <table id="contactsSummary" style="margin-top:20px;" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Invitation</th>
                            <th>Emergency</th>
                            <th>Money</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Contacts.Count; i++)
                        {
                            var contact = Model.Contacts.ElementAt(i);
                            <tr class="contact-summary" data-index="@i"
                                data-contacttype="@contact.Type"
                                data-contactvalue="@contact.Value"
                                data-invitation="@contact.Invitation.ToString().ToLower()"
                                data-emergency="@contact.Emergency.ToString().ToLower()"
                                data-money="@contact.Money.ToString().ToLower()">
                                <td>@(DropdownOptions.ContactTypes.FirstOrDefault(x => x.Value == contact.Type)?.Text)</td>
                                <td>@contact.Value</td>
                                <td>@(contact.Invitation ? "✔" : "")</td>
                                <td>@(contact.Emergency ? "✔" : "")</td>
                                <td>@(contact.Money ? "✔" : "")</td>
                                <td style="display:none;">
                                    <!-- Existing contacts include their ID -->
                                    <input type="hidden" name="Contacts[@i].ID" value="@contact.ID" />
                                    <input type="hidden" name="Contacts[@i].Type" value="@contact.Type" />
                                    <input type="hidden" name="Contacts[@i].Value" value="@contact.Value" />
                                    <input type="hidden" name="Contacts[@i].Invitation" value="@contact.Invitation.ToString().ToLower()" />
                                    <input type="hidden" name="Contacts[@i].Emergency" value="@contact.Emergency.ToString().ToLower()" />
                                    <input type="hidden" name="Contacts[@i].Money" value="@contact.Money.ToString().ToLower()" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <button type="button" id="addContact" class="btn btn-secondary">Add Contact Information</button>
        <br /><br />
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<!-- Modal for adding/editing a contact -->
<div id="contactModal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog">
    <div class="modal-content">
       <div class="modal-header">
           <h5 class="modal-title" id="contactModalTitle">Add Contact Information</h5>
       </div>
       <div class="modal-body">
         <div class="form-group">
            <label class="control-label">Contact Type</label>
            @Html.DropDownList("modalContactType", new SelectList(ViewBag.ContactTypes, "Value", "Text"), "Select Contact Type", new { @class = "form-control", id="modalContactType" })
         </div>
         <div class="form-group">
            <label class="control-label">Value</label>
            @Html.TextBox("modalContactValue", null, new { @class = "form-control", id="modalContactValue" })
         </div>
         <div class="form-group">
            <label class="control-label">Invitation</label>
            <div>
                @Html.CheckBox("modalContactInvitation", false, new { id="modalContactInvitation" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Emergency</label>
            <div>
                @Html.CheckBox("modalContactEmergency", false, new { id="modalContactEmergency" })
            </div>
         </div>
         <div class="form-group">
            <label class="control-label">Money</label>
            <div>
                @Html.CheckBox("modalContactMoney", false, new { id="modalContactMoney" })
            </div>
         </div>
       </div>
       <div class="modal-footer">
         <button type="button" id="modalCancel" class="btn btn-secondary">Cancel</button>
         <button type="button" id="modalSave" class="btn btn-primary">Save</button>
       </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script type="text/javascript">
        // IMPORTANT: Initialize contactCount from the number of existing contacts.
        var contactCount = @((Model.Contacts != null && Model.Contacts.Any()) ? Model.Contacts.Count() : 0);
        var editingContactIndex = null;

        // Adds a new row to the contacts table.
        function addContactSummary(index, contactType, typeText, value, invitationBool, emergencyBool, moneyBool) {
            // If table doesn't exist (should not occur in edit mode since existing contacts render it), create it.
            if ($("#contactsSummary").length === 0) {
                var tableHtml =
                    '<table id="contactsSummary" style="margin-top:20px;" class="table table-bordered">' +
                        '<thead>' +
                            '<tr>' +
                                '<th>Type</th>' +
                                '<th>Value</th>' +
                                '<th>Invitation</th>' +
                                '<th>Emergency</th>' +
                                '<th>Money</th>' +
                            '</tr>' +
                        '</thead>' +
                        '<tbody></tbody>' +
                    '</table>';
                $("#contacts").append(tableHtml);
            }
            
            var summaryRow =
                '<tr class="contact-summary" data-index="' + index + '" ' +
                'data-contacttype="' + contactType + '" ' +
                'data-contactvalue="' + value + '" ' +
                'data-invitation="' + (invitationBool ? "true" : "false") + '" ' +
                'data-emergency="' + (emergencyBool ? "true" : "false") + '" ' +
                'data-money="' + (moneyBool ? "true" : "false") + '">' +
                    '<td>' + typeText + '</td>' +
                    '<td>' + value + '</td>' +
                    '<td>' + (invitationBool ? "✔" : "") + '</td>' +
                    '<td>' + (emergencyBool ? "✔" : "") + '</td>' +
                    '<td>' + (moneyBool ? "✔" : "") + '</td>' +
                    '<td style="display:none;">' +
                        '<input type="hidden" name="Contacts[' + index + '].Type" value="' + contactType + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Value" value="' + value + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Invitation" value="' + (invitationBool ? "true" : "false") + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Emergency" value="' + (emergencyBool ? "true" : "false") + '"/>' +
                        '<input type="hidden" name="Contacts[' + index + '].Money" value="' + (moneyBool ? "true" : "false") + '"/>' +
                    '</td>' +
                '</tr>';
            $("#contactsSummary tbody").append(summaryRow);
        }

        $(document).ready(function () {
            // Initialize modal with static backdrop.
            $("#contactModal").modal({ backdrop: 'static', keyboard: false, show: false });

            // "Add Contact Information" button click: clear modal fields.
            $("#addContact").click(function (e) {
                editingContactIndex = null;
                $("#contactModalTitle").text("Add Contact");
                $("#modalContactType").val("");
                $("#modalContactValue").val("");
                $("#modalContactInvitation").prop("checked", false);
                $("#modalContactEmergency").prop("checked", false);
                $("#modalContactMoney").prop("checked", false);
                $("#contactModal").modal('show');
            });

            // When a contact row is clicked, load its data into the modal for editing.
            $(document).on("click", "#contactsSummary tbody tr.contact-summary", function (e) {
                var $row = $(this);
                editingContactIndex = $row.data("index");
                $("#modalContactType").val($row.data("contacttype"));
                $("#modalContactValue").val($row.data("contactvalue"));
                $("#modalContactInvitation").prop("checked", $row.data("invitation") === "true");
                $("#modalContactEmergency").prop("checked", $row.data("emergency") === "true");
                $("#modalContactMoney").prop("checked", $row.data("money") === "true");
                $("#contactModalTitle").text("Edit Contact");
                $("#contactModal").modal("show");
            });

            // When the modal Save button is clicked…
            $("#modalSave").click(function () {
                var contactType = $("#modalContactType").val();
                var typeText = $("#modalContactType option:selected").text();
                var value = $("#modalContactValue").val();
                var invitationBool = $("#modalContactInvitation").is(":checked");
                var emergencyBool = $("#modalContactEmergency").is(":checked");
                var moneyBool = $("#modalContactMoney").is(":checked");

                // If no data was entered, simply close the modal.
                if (!contactType && !value && !invitationBool && !emergencyBool && !moneyBool) {
                    $("#contactModal").modal('hide');
                    return;
                }

                if (editingContactIndex !== null) {
                    // Update an existing row.
                    var $row = $("#contactsSummary tbody tr.contact-summary[data-index='" + editingContactIndex + "']");
                    $row.find("td:nth-child(1)").text(typeText);
                    $row.find("td:nth-child(2)").text(value);
                    $row.find("td:nth-child(3)").text(invitationBool ? "✔" : "");
                    $row.find("td:nth-child(4)").text(emergencyBool ? "✔" : "");
                    $row.find("td:nth-child(5)").text(moneyBool ? "✔" : "");
                    
                    var hiddenHtml =
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Type" value="' + contactType + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Value" value="' + value + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Invitation" value="' + (invitationBool ? "true" : "false") + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Emergency" value="' + (emergencyBool ? "true" : "false") + '"/>' +
                        '<input type="hidden" name="Contacts[' + editingContactIndex + '].Money" value="' + (moneyBool ? "true" : "false") + '"/>';
                    $row.find("td:last").html(hiddenHtml);

                    // Update the row's data attributes.
                    $row.data("contacttype", contactType);
                    $row.data("contactvalue", value);
                    $row.data("invitation", invitationBool ? "true" : "false");
                    $row.data("emergency", emergencyBool ? "true" : "false");
                    $row.data("money", moneyBool ? "true" : "false");

                    editingContactIndex = null;
                } else {
                    // Add a new contact row using the next available index.
                    addContactSummary(contactCount, contactType, typeText, value, invitationBool, emergencyBool, moneyBool);
                    contactCount++;
                }
                
                $("#contactModal").modal('hide');
            });

            $("#modalCancel").click(function () {
                editingContactIndex = null;
                $("#contactModal").modal('hide');
            });

            // On form submission, remove any existing Contacts.index inputs and add one for each row.
            $("form").submit(function (e) {
                $("input[name='Contacts.index']").remove();
                $("#contactsSummary tbody tr.contact-summary").each(function () {
                    var idx = $(this).data("index");
                    $("<input>").attr({
                        type: "hidden",
                        name: "Contacts.index",
                        value: idx
                    }).appendTo("form");
                });
                if ($("#contactsSummary tbody tr").length === 0) {
                    alert("Please add at least one contact.");
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
