@model DotNetCoreSqlDb.Models.Student
@{
    ViewData["Title"] = "My Information";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <style>
    /* ---------- RESET ---------- */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* ---------- PAGE BACKGROUND ---------- */
    body {
      font-family: Helvetica, sans-serif;
      background: linear-gradient(to bottom right, #b2e7ff, #ffffff);
      min-height: 100vh;
    }

    /* ---------- HEADER / NAV ---------- */
    header {
      background-color: #6981ec;
      color: #fff;
      padding: 10px 0;
      min-height: 60px;
      position: relative;
    }
    .header-container { max-width: 1250px; margin: 0 auto; overflow: hidden; }
    #logo { float: left; font-size: 1.5em; color: #ffffff; padding-top: 5px; }

    /* desktop nav fixed 40 % from viewport left */
    nav { position: absolute; left: 25vw; top: 50%; transform: translateY(-50%); }
    .nav-links   { list-style: none; margin: 0; padding: 0; }
    .nav-links li{ display: inline-block; margin-left: 20px; }
    .nav-links li a{
      color: #000; text-decoration: none; padding: 10px 15px; display: inline-block;
      transition: background-color .3s;
    }
    .nav-links li a:hover        { background-color: #ced6ff; scale: 110%; border-radius: 10%; }
    .nav-links li a.active-page,
    .nav-links li a.inactive-page{ background-color: #fff; border-radius: 10%; }

    /* burger (desktop hidden) */
    .burger{ display:none; cursor:pointer; margin-left:15px; }
    .burger div{ width:25px; height:3px; background:#fff; margin:5px; transition:.3s; }

    /* ---------- MOBILE NAV OVERRIDES ---------- */
    @@media(max-width:768px){
      nav{ position:relative; left:0; top:0; transform:none; margin-top:10px; }
      .nav-links{
        display:none; width:100%; text-align:center; position:absolute;
        background:#333; top:60px; left:0; z-index:1;
      }
      .nav-links.active{ display:block; }
      .nav-links li{ display:block; margin:10px 0; }
      .burger{ display:block; float:right; margin-top:15px; }
      .burger.active .line1{ transform:rotate(45deg) translate(-5px,6px); }
      .burger.active .line2{ opacity:0; }
      .burger.active .line3{ transform:rotate(-45deg) translate(-5px,-6px); }
    }

    /* ---------- MAIN LAYOUT ---------- */
    .content-wrapper { max-width:900px; margin:80px auto 40px; padding:0 20px; }

    /* ---------- PROFILE CARD ---------- */
    .profile-section{
      background:#fff; border-radius:8px;
      box-shadow:0 2px 6px rgba(0,0,0,0.1);
      padding:1.5rem 2rem; margin-bottom:2rem;
    }

    /* header row inside card */
    .profile-header{
      display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;
    }
    .profile-header h2{ color:#333; margin-bottom:.25rem; }

    /* settings action buttons */
    .settings-actions{ display:flex; gap:.75rem; flex-wrap:wrap; }
    .settings-actions a{
      padding:.5rem 1rem; border:1px solid #6981ec; border-radius:6px;
      background:#fff; color:#6981ec; font-size:.9rem; text-decoration:none;
      transition:all .25s;
    }
    .settings-actions a:hover{ background:#6981ec; color:#fff; }

    /* definition list */
    .dl-horizontal{ margin:1rem 0 1.5rem; }
    .dl-horizontal dt{ float:left; clear:left; width:120px; font-weight:600; color:#555; }
    .dl-horizontal dd{ margin-left:140px; color:#333; }

    /* table styling */
    .table{
      width:100%; border-collapse:collapse; margin-top:1rem; font-size:.95rem;
    }
    .table thead th{
      background:#e9efff; color:#333; font-weight:600;
      padding:.75rem 1rem; text-align:left; border-bottom:1px solid #d4d9ff;
    }
    .table tbody td{
      padding:.65rem 1rem; border-bottom:1px solid #f0f0f0; color:#444;
    }
    .table tbody tr:nth-child(even){ background:#fafbff; }

    /* ---------- RESPONSIVE PROFILE ---------- */
    @@media(max-width:600px){
      .profile-section{ padding:1rem 1.25rem; }
      .profile-header{ flex-direction:column; align-items:flex-start; }
      .settings-actions{ margin-top:.75rem; }
      .dl-horizontal dt,
      .dl-horizontal dd{ float:none; width:auto; margin:0 0 .5rem 0; }
      .table thead{ display:none; }
      .table tbody td{
        display:block; width:100%; text-align:right; padding-left:50%; position:relative;
      }
      .table tbody td::before{
        content:attr(data-label); position:absolute; left:1rem;
        width:calc(50% - 1rem); text-align:left; font-weight:600; color:#666;
      }
    }
  </style>
</head>
<body>
  <!-- NAV -->
  <header>
    <div class="header-container">
      <div id="logo">@ViewData["Title"]</div>

      <nav>
        <ul class="nav-links">
          <li>
            <a asp-controller="Students" asp-action="Schedule" title="Schedule">
              <i class="hgi hgi-stroke hgi-calendar-03"></i>
            </a>
          </li>
          <li>
            <a asp-controller="Students" asp-action="Zoom" title="Zoom">
              <i class="hgi hgi-stroke hgi-zoom"></i>
            </a>
          </li>
          <li>
            <a asp-controller="Students" asp-action="Index" title="Account" class="active-page">
              <i class="fas fa-user-graduate"></i>
            </a>
          </li>
        </ul>

        <div class="burger">
          <div class="line1"></div><div class="line2"></div><div class="line3"></div>
        </div>
      </nav>
    </div>
  </header>

  <!-- PROFILE CONTENT -->
  <div class="content-wrapper">
    <!-- PROFILE DETAILS -->
    <div class="profile-section">
      <div class="profile-header">
        <h2><b>My Profile</b></h2>

        <!-- SETTINGS BUTTONS -->
        <div class="settings-actions">
          <a asp-controller="AccountManagement"
             asp-action="ChangeUsername"
             asp-route-userId="@Model.ID">
            Change&nbsp;Username
          </a>
          <a asp-controller="AccountManagement"
             asp-action="ChangePassword"
             asp-route-userId="@Model.ID">
            Change&nbsp;Password
          </a>
        </div>
      </div>
      <hr />
      <dl class="dl-horizontal">
        <dt>Name</dt>
        <dd>@Html.DisplayFor(m => m.Name)</dd>
      </dl>
    </div>

    <!-- CONTACT INFO -->
    <div class="profile-section">
      <h4><b>Contact Information</b></h4>
      @if (Model.Contacts != null && Model.Contacts.Any())
      {
        <div style="overflow-x:auto;">
          <table class="table">
            <thead>
              @*<tr>
                <th>Type</th><th>Value</th><th>Invitation</th><th>Emergency</th><th>Money</th>
              </tr>*@
            </thead>
            <tbody>
              @foreach (var contact in Model.Contacts)
              {
                <tr>
                  <td data-label="Type">@Html.DisplayFor(m => contact.Type)</td>
                  <td data-label="Value">@Html.DisplayFor(m => contact.Value)</td>
                  @*<td data-label="Invitation">@(contact.Invitation ? "✔" : "")</td>
                  <td data-label="Emergency">@(contact.Emergency ? "✔" : "")</td>
                  <td data-label="Money">@(contact.Money ? "✔" : "")</td>*@
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      else
      {
        <p>No contact information available.</p>
      }
    </div>
  </div>

  <!-- ---------- SCRIPTS ---------- -->
  <script>
    /* burger toggle (mobile) */
    document.querySelector('.burger').addEventListener('click', e => {
      e.currentTarget.classList.toggle('active');
      document.querySelector('.nav-links').classList.toggle('active');
    });
  </script>
</body>
</html>
