@model IEnumerable<DotNetCoreSqlDb.Models.Student>

@{
    ViewData["Title"] = "Students List";
    
    // Retrieve the current sort order from ViewBag (set by the controller)
    string currentSort = ViewBag.CurrentSort as string ?? "";
    // Toggle sorting: if current sort is ascending for Name, then next is descending, and vice versa.
    string nameSortParam = currentSort == "Name" ? "name_desc" : "Name";
    string dateSortParam = currentSort == "CreatedDate" ? "createdDate_desc" : "CreatedDate";
}

<h2>Students List</h2>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">Create New Student</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                <a href="@Url.Action("Index", new { sortOrder = nameSortParam })">
                    Name
                    @if (currentSort == "Name")
                    {
                        <span>&#9650;</span>
                    }
                    else if (currentSort == "name_desc")
                    {
                        <span>&#9660;</span>
                    }
                </a>
            </th>
            <th>Parent/Employer</th>
            <th>Email</th>
            <th>
                <a href="@Url.Action("Index", new { sortOrder = dateSortParam })">
                    Created Date
                    @if (currentSort == "CreatedDate")
                    {
                        <span>&#9650;</span>
                    }
                    else if (currentSort == "createdDate_desc")
                    {
                        <span>&#9660;</span>
                    }
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // Look for the first contact with type "email" (using case-insensitive comparison)
            var emailContact = item.Contacts?.FirstOrDefault(c => !string.IsNullOrEmpty(c.Type) &&
                c.Type.Equals("email", StringComparison.OrdinalIgnoreCase));
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.ParentOrEmployer)</td>
                <td>@(emailContact != null ? emailContact.Value : "")</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.ID })">Details</a> |
                    <a href="@Url.Action("Edit", new { id = item.ID })">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
