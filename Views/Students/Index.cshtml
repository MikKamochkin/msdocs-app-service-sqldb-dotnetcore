@model DotNetCoreSqlDb.Models.Student
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "My Profile";
    var timeZones = ViewBag.TimeZones as List<SelectListItem>;
    var assignments = ViewBag.Assignments as List<DotNetCoreSqlDb.Models.Assignments>;
    var balances = ViewBag.Balances as List<DotNetCoreSqlDb.Models.StudentBalance>;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        /* ---------- RESET ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ---------- PAGE BACKGROUND ---------- */
        body {
            font-family: Helvetica, sans-serif;
            /*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
            background: #e8ecfc;
            min-height: 100vh;
        }

        /* ---------- HEADER / NAV ---------- */
        header {
            background-color: #6981ec;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 1000;
        }

        .header-container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            height: 100%;
            position: relative;
            /* Needed for absolute positioning of children */
        }

        #logo {
            position: absolute;
            left: 12%;
            top: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            /*font-weight: 700;*/
            color: #fff;
            /* Changed to white to match your original */
        }

        nav {
            position: absolute;
            left: 20%;
            top: 50%;
            transform: translateY(-50%);
        }

        .nav-links {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-links li {
            display: inline-block;
            margin-left: 20px;
        }

        .nav-links li a {
            color: #000;
            text-decoration: none;
            padding: 10px 15px;
            display: inline-block;
            transition: background-color .3s;
        }

        .nav-links li a:hover {
            background-color: #ced6ff;
            scale: 110%;
            border-radius: 10%;
        }

        .nav-links li a.active-page,
        .nav-links li a.inactive-page {
            background-color: #fff;
            border-radius: 10%;
        }

        /* burger (desktop hidden) */
        .burger {
            display: none;
            cursor: pointer;
            margin-left: 15px;
        }

        .burger .line {
            width: 25px;
            height: 3px;
            background: #fff;
            margin: 4px 0;
            transition: .3s;
        }


        @@media (max-width: 768px) {
            header {
                height: 56px;
            }

            .header-container {
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 12px;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: relative;
                /* still needed for nav dropdown positioning */
            }

            /* let the title be readable and not cut off */
            #logo {
                position: static;
                left: auto;
                top: auto;
                transform: none;
                font-size: 1rem;
                color: #fff;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 65%;
            }

            nav {
                position: static;
                left: auto;
                top: auto;
                transform: none;
                margin-top: 0;
            }

            .burger {
                display: block;
                margin-top: 0;
            }

            /* dropdown nav */
            .nav-links {
                position: absolute;
                top: 56px;
                /* just under header */
                left: 0;
                right: 0;
                display: none;
                flex-direction: column;
                background: #3c4c97;
                padding: 8px 0;
                z-index: 1001;
                text-align: left;
            }

            .nav-links.active {
                display: flex;
            }

            .nav-links li {
                display: block;
                width: 100%;
                margin: 0;
            }

            .nav-links li a {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                padding: 10px 16px;
                color: #fff;
                text-decoration: none;
                border-radius: 0;
                background: transparent;
            }

            .nav-links li a i {
                color: inherit;
                font-size: 1.1rem;
            }

            /* active item: subtle highlight instead of white box */
            .nav-links li a.active-page {
                background: rgba(255, 255, 255, 0.16);
                border-left: 3px solid #ffe082;
            }

            .nav-links li a:not(.active-page) {
                opacity: 0.9;
            }

            /* burger animation */
            .burger.active .line1 {
                transform: translateY(7px) rotate(45deg);
            }

            .burger.active .line2 {
                opacity: 0;
            }

            .burger.active .line3 {
                transform: translateY(-7px) rotate(-45deg);
            }
        }


        /* ---------- MAIN LAYOUT ---------- */
        .content-wrapper {
            max-width: 900px;
            margin: 80px auto 40px;
            padding: 0 20px;
        }

        /* ---------- PROFILE CARD ---------- */
        .profile-section {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
            padding: 1.5rem 2rem;
            margin-bottom: 2rem;
        }

        /* header row inside card */
        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .profile-header h2 {
            color: #333;
            margin-bottom: .25rem;
        }

        /* settings action buttons */
        .settings-actions {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .settings-actions a {
            padding: .5rem 1rem;
            border: 1px solid #6981ec;
            border-radius: 6px;
            background: #fff;
            color: #6981ec;
            font-size: .9rem;
            text-decoration: none;
            transition: all .25s;
        }

        .settings-actions a:hover {
            background: #6981ec;
            color: #fff;
        }

        /* definition list */
        .dl-horizontal {
            margin: 1rem 0 1.5rem;
        }

        .dl-horizontal dt {
            float: left;
            clear: left;
            width: 120px;
            font-weight: 600;
            color: #555;
        }

        .dl-horizontal dd {
            margin-left: 140px;
            color: #333;
        }

        /* table styling */
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
            font-size: .95rem;
        }

        .table thead th {
            background: #e9efff;
            color: #333;
            font-weight: 600;
            padding: .75rem 1rem;
            text-align: left;
            border-bottom: 1px solid #d4d9ff;
        }

        .table tbody td {
            padding: .65rem 1rem;
            border-bottom: 1px solid #f0f0f0;
            color: #444;
        }

        .table tbody tr:nth-child(even) {
            background: #e6e9ff;
        }

        .table tbody tr:nth-child(odd) {
            background: #fafbff;
        }

        .time-zone .selector {
            vertical-align: middle;
            /*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
            padding-left: 0.02rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border: 1px solid #6981ec;
            border-radius: 6px;
            background: #fff;
            color: #000000;
            font-size: 1rem;
            text-decoration: none;
            transition: all .25s;
        }

        .time-zone .label {
            vertical-align: middle;
            /*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
            padding-top: 0.5rem;

        }

        /* ---------- RESPONSIVE PROFILE ---------- */
        @@media (max-width: 600px) {
            .profile-section {
                padding: 1rem 1.25rem;
            }

            .profile-header {
                flex-direction: column;
                align-items: flex-start;
                gap: .5rem;
            }

            .settings-actions {
                margin-top: .25rem;
                flex-wrap: wrap;
            }

            /* definition list becomes vertical */
            .dl-horizontal dt,
            .dl-horizontal dd {
                float: none;
                width: auto;
                margin: 0 0 .5rem 0;
            }

            /* tables become stacked cards */
            .table {
                border: 0;
            }

            .table thead {
                display: none;
            }

            .table tbody tr {
                display: block;
                margin-bottom: .75rem;
                background: #fafbff;
                border-radius: 8px;
                border: 1px solid #e5e5e5;
                overflow: hidden;
            }

            .table tbody td {
                display: flex;
                width: 100%;
                text-align: left;
                padding: .5rem .75rem;
                position: relative;
                border-bottom: 1px solid #eee;
            }

            .table tbody td:last-child {
                border-bottom: none;
            }

            .table tbody td::before {
                content: attr(data-label);
                font-weight: 600;
                color: #555;
                margin-right: .5rem;
                flex: 0 0 45%;
                max-width: 45%;
            }
        }
    </style>
</head>

<body>
    <!-- NAV -->
    <header>
        <div class="header-container">
            <div id="logo">@ViewData["Title"]</div>

            <nav>
                <ul class="nav-links">
                    <li>
                        <a asp-controller="Students" asp-action="Schedule" title="Schedule">
                            <i class="hgi hgi-stroke hgi-calendar-03"></i>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Students" asp-action="Index" title="Account" class="active-page">
                            <i class="fas fa-user-graduate"></i>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Students" asp-action="LessonAndTransactionHistory" title="History">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </a>
                    </li>

                </ul>

                <div class="burger">
                    <div class="line line1"></div>
                    <div class="line line2"></div>
                    <div class="line line3"></div>
                </div>

            </nav>
        </div>
    </header>

    <!-- PROFILE CONTENT -->
    <div class="content-wrapper">
        <!-- PROFILE DETAILS -->
        <div class="profile-section">
            <div class="profile-header">
                <h2><b>My Profile</b></h2>

                <!-- SETTINGS BUTTONS -->
                <div class="settings-actions">
                    @*<a asp-controller="AccountManagement" asp-action="ChangeUsername" asp-route-userId="@Model.ID">
                        Change Username
                    </a>*@
                    <a asp-controller="AccountManagement" asp-action="ChangePassword" asp-route-userId="@Model.ID">
                        Change Password
                    </a>
                </div>
            </div>
            <hr />
            <dl class="dl-horizontal">
                @*<dt>Name</dt>
                <dd>@Html.DisplayFor(m => m.Name)</dd>*@
                <dt>Student&nbsp;Number</dt>
                <dd>@ViewBag.Username</dd>

                <form id="timezoneForm">
                    @Html.AntiForgeryToken()
                    <div class="time-zone">
                        <dt class="label">Default&nbsp;time</dt>
                        <dd>
                            <select id="timeZoneSelect" name="timeZoneId" class="selector col-md-3.5">
                                @foreach (var tz in timeZones)
                                {
                                    <option value="@tz.Value" selected="@tz.Selected">@tz.Text</option>
                                }
                            </select>
                        </dd>
                    </div>
                </form>

            </dl>
        </div>

        <!-- CONTACT INFO -->
        <div class="profile-section">
            <h4><b>Contact Information</b></h4>
            <div>Please verify that this contact information is correct.
                If you see any discrepancies, please reach out to us.</div>
            @if (Model.Contacts != null && Model.Contacts.Any())
            {
                <div style="overflow-x:auto;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">Type</th>
                                <th style="width: 50%;">Value</th>
                                <th style="width: 20%; text-align: center">I want to recieve lesson reminders via SMS*</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in Model.Contacts)
                            {
                                var canEditInvitation = contact.Type == "Phone";

                                <tr>
                                    <td data-label="Type">@Html.DisplayFor(m => contact.Type)</td>
                                    <td data-label="Value">@Html.DisplayFor(m => contact.Value)</td>
                                    <td style="text-align: center"
                                        data-label="I want to recieve lesson reminders via SMS*">
                                        <input type="checkbox"
                                            class="invitation-toggle"
                                            data-contact-id="@contact.ID"
                                            @(contact.Invitation ? "checked=\"checked\"" : "")
                                            @(canEditInvitation ? "" : "disabled=\"disabled\"") />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="font-size: small">* By checking the checkbox, I am agreeing to recieve SMS notifications one
                        hour prior to the scheduled lesson time to the selected phone number</div>
                </div>
            }
            else
            {
                <p>No contact information available.</p>
            }
        </div>


        <div class="profile-section">
            <h4><b>Balance</b></h4>
            @if (assignments != null)
            {
                <div style="overflow-x:auto;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">Teacher</th>
                                <th style="width: 33%;">Lesson Duration</th>
                                <th style="width: 33%;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in balances)
                            {
                                <tr>
                                    <td data-label="Teacher">@Html.DisplayFor(t => b.Assignment.Teacher.Name)</td>
                                    <td data-label="Lesson Duration">@Html.DisplayFor(t => b.Assignment.StudentUnitDuration) mins</td>
                                    <td data-label="Balance">@Html.DisplayFor(t => b.Balance)</td>

                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No balance information available.</p>
            }
        </div>

        <div class="profile-section">
            <h4><b>Zoom Test</b></h4>
            <div class="settings-actions">
                <a href="https://zoom.us/test">
                    <strong>Click Here To Test Your Zoom</strong>
                </a>
            </div>
        </div>
    </div>

    <!-- ---------- SCRIPTS ---------- -->
    <script>
        /* burger toggle (mobile) */
        document.querySelector('.burger').addEventListener('click', e => {
            e.currentTarget.classList.toggle('active');
            document.querySelector('.nav-links').classList.toggle('active');
        });

        document.getElementById('timeZoneSelect').addEventListener('change', function () {
            const selectedTimeZone = this.value;

            fetch('@Url.Action("SaveTimeZone", "Students")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ timeZoneId: selectedTimeZone })
            })
                .then(response => {
                    if (!response.ok) throw new Error('Failed to save');
                    console.log("Time zone updated!");
                })
                .catch(error => {
                    console.error('Error updating time zone:', error);
                });
        });

        document.querySelectorAll('.invitation-toggle').forEach(cb => {
            cb.addEventListener('change', function () {
                const contactId = this.dataset.contactId;
                const invitation = this.checked;

                fetch('@Url.Action("UpdateInvitationPreference", "Students")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        contactId: contactId,
                        invitation: invitation
                    })
                })
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to update invitation');
                        //console.log('Invitation preference updated');
                    })
                    .catch(error => {
                        //console.error('Error updating invitation:', error);
                        // revert checkbox if something went wrong
                        this.checked = !invitation;
                    });
            });
        });

    </script>
</body>

</html>