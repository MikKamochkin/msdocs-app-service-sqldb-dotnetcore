@model List<DotNetCoreSqlDb.ViewModels.TimelineItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
	ViewData["Title"] = "My History";
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>

	<style>
		/* ---------- RESET ---------- */
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		/* ---------- PAGE BACKGROUND ---------- */
		body {
			font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
			/*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
			background: #e8ecfc;
			min-height: 100vh;
		}

		/* ---------- HEADER / NAV ---------- */
		header {
			background-color: #6981ec;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 60px;
			z-index: 1000;
		}

		.header-container {
			width: 100%;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
			height: 100%;
			position: relative;
			/* Needed for absolute positioning of children */
		}

		#logo {
			position: absolute;
			left: 12%;
			top: 50%;
			transform: translate(-50%, -50%);
			font-size: 1.5rem;
			/*font-weight: 700;*/
			color: #fff;
			/* Changed to white to match your original */
		}

		nav {
			position: absolute;
			left: 20%;
			top: 50%;
			transform: translateY(-50%);
		}

		.nav-links {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.nav-links li {
			display: inline-block;
			margin-left: 20px;
		}

		.nav-links li a {
			color: #000;
			text-decoration: none;
			padding: 10px 15px;
			display: inline-block;
			transition: background-color .3s;
		}

		.nav-links li a:hover {
			background-color: #ced6ff;
			scale: 110%;
			border-radius: 10%;
		}

		.nav-links li a.active-page,
		.nav-links li a.inactive-page {
			background-color: #fff;
			border-radius: 10%;
		}

		/* burger (desktop hidden) */
		.burger {
			display: none;
			cursor: pointer;
			margin-left: 15px;
		}

		.burger div {
			width: 25px;
			height: 3px;
			background: #fff;
			margin: 5px;
			transition: .3s;
		}

		/* ---------- MOBILE NAV OVERRIDES ---------- */
		@@media(max-width:768px) {
			nav {
				position: relative;
				left: 0;
				top: 0;
				transform: none;
				margin-top: 10px;
			}

			.nav-links {
				display: none;
				width: 100%;
				text-align: center;
				position: absolute;
				background: #333;
				top: 60px;
				left: 0;
				z-index: 1;
			}

			.nav-links.active {
				display: block;
			}

			.nav-links li {
				display: block;
				margin: 10px 0;
			}

			.burger {
				display: block;
				float: right;
				margin-top: 15px;
			}

			.burger.active .line1 {
				transform: rotate(45deg) translate(-5px, 6px);
			}

			.burger.active .line2 {
				opacity: 0;
			}

			.burger.active .line3 {
				transform: rotate(-45deg) translate(-5px, -6px);
			}
		}

		/* ---------- MAIN LAYOUT ---------- */
		.content-wrapper {
			max-width: 900px;
			margin: 80px auto 40px;
			padding: 0 20px;
		}

		/* ---------- PROFILE CARD ---------- */
		.profile-section {
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
			padding: 1.5rem 2rem;
			margin-bottom: 2rem;
		}

		/* header row inside card */
		.profile-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
		}

		.profile-header h2 {
			color: #333;
			margin-bottom: .25rem;
		}

		/* settings action buttons */
		.settings-actions {
			display: flex;
			gap: .75rem;
			flex-wrap: wrap;
		}

		.settings-actions a {
			padding: .5rem 1rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #6981ec;
			font-size: .9rem;
			text-decoration: none;
			transition: all .25s;
		}

		.settings-actions a:hover {
			background: #6981ec;
			color: #fff;
		}

		/* definition list */
		.dl-horizontal {
			margin: 1rem 0 1.5rem;
		}

		.dl-horizontal dt {
			float: left;
			clear: left;
			width: 120px;
			font-weight: 600;
			color: #555;
		}

		.dl-horizontal dd {
			margin-left: 140px;
			color: #333;
		}

		/* table styling */
		.table {
			width: 100%;
			border-collapse: separate;
			/* important for visible radius */
			border-spacing: 0;
			margin-top: 1rem;
			font-size: .95rem;
			overflow: hidden;
		}

		.table thead th {
			background: #e8ecfc;
			color: #333;
			font-weight: 700;
			padding: .75rem 1rem;
			text-align: left;
		}

		/* Round the outer header corners */
		.table thead th:first-child {
			border-top-left-radius: 12px;
		}

		.table thead th:last-child {
			border-top-right-radius: 12px;
		}


		.table tbody td {
			padding: .65rem 1rem;
			border-bottom: none;
			color: #444;
		}

		/*.table tbody tr:nth-child(even) {
			background: #e6e9ff;
		}

		.table tbody tr:nth-child(odd) {
			background: #fafbff;
		}*/

		/* highlight lesson rows */
		.table tbody tr.lesson-row {
			background-color: #e6e9ff;
			/* light blue */
		}

		/* highlight transaction rows */
		.table tbody tr.transaction-row {
			background-color: #fff9cc;
			/* light yellow */
		}

		.table tbody tr.transaction-row {
			cursor: pointer;
		}

		.table tbody tr.transaction-row {
			cursor: pointer;
			transition: background-color 0.15s ease;
		}

		.table tbody tr.transaction-row:hover {
			background-color: #ffe657;
			/*box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);*/
			transform: scale(1.03);
			/* slightly darker yellow highlight */
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);

		}






		.time-zone .selector {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-left: 0.02rem;
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #000000;
			font-size: 1rem;
			text-decoration: none;
			transition: all .25s;
		}

		.time-zone .label {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-top: 0.5rem;

		}

		/* ---------- TRANSACTION CARD STYLE ---------- */

		.modal-dialog {
			max-width: 500px;
		}

		.modal-content {
			border-radius: 14px;
			box-shadow: 0 12px 35px rgba(15, 23, 42, 0.18);
		}

		.modal-header {
			background: #f0f3ff;
			border-bottom: 1px solid #d7dcf9;
			padding: 10px 16px;
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
		}

		.modal-title {
			font-size: 1.1rem;
			font-weight: 700;
			color: #1f2933;
		}

		/* --- SECTION TITLES --- */
		.transaction-section-title {
			font-size: 1.1rem;
			/* Bigger */
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: #4c58a7;
			margin: 12px 0 12px;
			text-align: center;
			padding-left: 0;
			margin-bottom: 20px;
		}

		/* --- 2-COLUMN LAYOUT FOR THE BODY --- */
		.transaction-columns {
			display: grid;
			grid-template-columns: 1fr 1fr;
			/* Lesson | Payment */
			gap: 20px;
			padding: 0 10px;
		}

		/* --- INDIVIDUAL DETAILS GRID INSIDE EACH SIDE --- */
		.transaction-details {
			display: grid;
			grid-template-columns: 1fr;
			gap: 10px;
		}

		/* --- DETAIL PILL --- */
		.transaction-detail-row {
			display: flex;
			flex-direction: column;
			background: #f7f8ff;
			border-radius: 10px;
			padding: 10px 12px;
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
		}

		/* --- LABEL --- */
		.transaction-detail-label {
			font-size: 0.9rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			color: #363941;
			margin-bottom: 3px;
			text-align: center;
			padding-left: 0;
		}

		/* --- VALUE --- */
		.transaction-detail-value {
			font-size: 0.95rem;
			font-weight: 500;
			color: #111827;
			word-break: break-word;
			text-align: center;
			padding-left: 0;
		}

		/* Positive / Negative */
		.value-positive {
			color: #15803d;
			font-weight: 600;
		}

		.value-negative {
			color: #b91c1c;
			font-weight: 600;
		}

		.modal-footer {
			border-top: 1px solid #d7dcf9;
			padding: 10px 16px;
		}

		.modal-dialog {
			max-width: 540px !important;
			/* adjust to taste */
			margin: 1.75rem auto;
			/* keep modal centered */
		}

		/* Make each column a proper full-width column container */
		.transaction-columns>div {
			width: 100%;
		}

		/* Ensure the details grid and each pill truly stretch full column width */
		.transaction-details {
			width: 100%;
		}

		.transaction-detail-row {
			width: 100%;
			align-items: center;
			/* centers children on the same axis as title */
		}

		/* Make label/value take full width so "center" is the same reference box */
		.transaction-detail-label,
		.transaction-detail-value {
			width: 100%;
			text-align: center;
		}

		.transaction-line {
			margin-bottom: 20px; /* Adds space between each label-value pair */
		}




		/* ---------- RESPONSIVE PROFILE ---------- */
		@@media(max-width:600px) {
			.profile-section {
				padding: 1rem 1.25rem;
			}

			.profile-header {
				flex-direction: column;
				align-items: flex-start;
			}

			.settings-actions {
				margin-top: .75rem;
			}

			.dl-horizontal dt,
			.dl-horizontal dd {
				float: none;
				width: auto;
				margin: 0 0 .5rem 0;
			}

			.table thead {
				display: none;
				border: none !important;
			}

			.table td,
			.table th {
				border: none !important;
			}

			.table tbody td {
				display: block;
				width: 100%;
				text-align: right;
				padding-left: 50%;
				position: relative;
			}

			.table tbody td::before {
				content: attr(data-label);
				position: absolute;
				left: 1rem;
				width: calc(50% - 1rem);
				text-align: left;
				font-weight: 600;
				color: #666;
			}
		}
	</style>
</head>

<body>
	<!-- NAV -->
	<header>
		<div class="header-container">
			<div id="logo">@ViewData["Title"]</div>
			<nav>
				<ul class="nav-links">
					<li>
						<a asp-controller="Students" asp-action="Schedule" title="Schedule">
							<i class="hgi hgi-stroke hgi-calendar-03"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Students" asp-action="Index" title="Account">
							<i class="fas fa-user-graduate"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Students" asp-action="LessonAndTransactionHistory" title="History"
							class="active-page">
							<i class="fa-solid fa-dollar-sign"></i>
						</a>
					</li>
					@*<li>
						<a asp-controller="Students" asp-action="Conversations" title="Conversations">
							<i class="fa-solid fa-message"></i>
                    </a>*@
                </li>
				</ul>

				<div class="burger">
					<div class="line1"></div>
					<div class="line3"></div>
				</div>
			</nav>
		</div>
	</header>

	<div class="content-wrapper">
		<div class="profile-section">
			<h4><b>Transaction History</b></h4>
			<div style="overflow-x:auto;">
				<table class="table">
					<thead>
						<tr>
							<th style="width: 30%;">Date/Time</th>
							<th style="width: 20%;">Lesson Status</th>
							<th style="width: 20%;">Lesson Duration</th>
							<th style="width: 10%;">Teacher</th>
							<th style="width: 20%;">Balance Change</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							var rowClass = !string.IsNullOrEmpty(item.Status) ? "lesson-row" : "transaction-row";
							// For transaction rows (Status null/empty) this is the TransactionLog Id
							var id = string.IsNullOrEmpty(item.Status) ? item.TransactionId : item.ScheduleId;

							<tr class="@rowClass" data-id="@id">
								<td>@item.DateTime</td>
								<td>@(item.Status == null ? "Payment" : item.Status)</td>
								<td>@(item.DurationMinutes != null ? item.DurationMinutes + " minutes" : "")</td>
								<td>@item.TeacherName</td>
								<td style="display: flex; justify-content: space-between; align-items: center;">
									<span>
										@(item.Amount > 0 ? "+" + item.Amount : item.Amount)
									</span>

									@if (string.IsNullOrEmpty(item.Status))
									{
										<i class="fa fa-info-circle" style="color:#6b6f86;"></i>
									}
								</td>

							</tr>
						}

					</tbody>
				</table>
			</div>
		</div>
	</div>
	<div class="modal fade" id="transactionModal" tabindex="-1" role="dialog" aria-labelledby="transactionModalLabel"
		aria-hidden="true">
		<div class="modal-dialog modal-sm" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<div>
						<h5 class="modal-title" id="transactionModalLabel">Transaction Details</h5>
						@*<div id="transactionSummary" class="transaction-summary"></div>*@
					</div>

					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>


				<div class="modal-body">

					<div class="transaction-columns">

						<!-- LEFT COLUMN: LESSON -->
						<!-- LEFT COLUMN: LESSON -->
						<div>
							<div class="transaction-section-title">Lesson</div>

							<div class="transaction-lines">
								<div class="transaction-line">
									<div class="transaction-detail-label">Payment Date</div>
									<div class="transaction-detail-value" id="tdDate"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Teacher</div>
									<div class="transaction-detail-value" id="tdTeacher"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Units Added</div>
									<div class="transaction-detail-value" id="tdUnits"></div>
								</div>
							</div>
						</div>

						<!-- RIGHT COLUMN: PAYMENT -->
						<div>
							<div class="transaction-section-title">Payment</div>

							<div class="transaction-lines">
								<div class="transaction-line">
									<div class="transaction-detail-label">Amount Paid</div>
									<div class="transaction-detail-value" id="tdAmountPaid"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Currency</div>
									<div class="transaction-detail-value" id="tdCurrency"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Payer Notes</div>
									<div class="transaction-detail-value" id="tdPayerNotes"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Reference</div>
									<div class="transaction-detail-value" id="tdReference"></div>
								</div>

								<div class="transaction-line">
									<div class="transaction-detail-label">Type</div>
									<div class="transaction-detail-value" id="tdType"></div>
								</div>
							</div>
						</div>


					</div>

				</div>


				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						Close
					</button>
				</div>
			</div>
		</div>
	</div>
</body>

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<script>
		$(function () {

			// row click -> open modal
			$('.table tbody').on('click', 'tr[data-id]', function () {
				var $row = $(this);

				// Only open modal for transaction rows (payments)
				if (!$row.hasClass('transaction-row')) {
					return;
				}

				var id = $row.data('id');
				if (!id) {
					console.warn('Clicked row has no data-id');
					return;
				}

				// Visually highlight selected row
				$row.addClass('table-active').siblings().removeClass('table-active');

				// (You commented out #transactionSummary in the HTML,
				// so it's safer to remove this block or re-enable the element.)

				// Clear previous styling
				$('#tdUnits').removeClass('value-positive value-negative');
				$('#tdAmountPaid').removeClass('value-positive value-negative');

				// GET /Students/GetTransactionDetails?transactionLogId=...
				$.getJSON('@Url.Action("GetTransactionDetails", "Students")', { transactionLogId: id })
					.done(function (data) {
						$('#tdDate').text(
							data.dateTime
								? new Date(data.dateTime).toLocaleDateString(undefined, {
									year: 'numeric',
									month: 'short',
									day: '2-digit'
								})
								: '—'
						);
						$('#tdTeacher').text(data.teacher || '—');

						$('#tdUnits').text(data.units ?? '—');
						if (data.units > 0) {
							$('#tdUnits').addClass('value-positive');
						}

						$('#tdAmountPaid').text('$' + data.amountPaid ?? '—');
						if (data.amountPaid > 0) {
							$('#tdAmountPaid').addClass('value-positive');
						} else if (data.amountPaid < 0) {
							$('#tdAmountPaid').addClass('value-negative');
						}

						$('#tdCurrency').text(data.currency || '—');
						$('#tdPayerNotes').text(data.payerNotes || '—');
						$('#tdReference').text(data.reference || '—');
						$('#tdType').text(data.type || '—');

						$('#transactionModal').modal('show');
					})
					.fail(function (xhr, status, err) {
						console.error('Error loading transaction details:', status, err);
						alert('Sorry, could not load transaction details.');
					});
			});

			// when modal closes -> remove highlight from all rows
			$('#transactionModal').on('hidden.bs.modal', function () {
				$('.table tbody tr').removeClass('table-active');
			});
		});
	</script>
}