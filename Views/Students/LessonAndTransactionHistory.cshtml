@model List<DotNetCoreSqlDb.ViewModels.TimelineItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
	ViewData["Title"] = "My History";
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>

	<style>
		/* ---------- RESET ---------- */
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		/* ---------- PAGE BACKGROUND ---------- */
		body {
			font-family: Helvetica, sans-serif;
			/*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
			background: #e8ecfc;
			min-height: 100vh;
		}

		/* ---------- HEADER / NAV ---------- */
		header {
			background-color: #6981ec;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 60px;
			z-index: 1000;
		}

		.header-container {
			width: 100%;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
			height: 100%;
			position: relative;
			/* Needed for absolute positioning of children */
		}

		#logo {
			position: absolute;
			left: 12%;
			top: 50%;
			transform: translate(-50%, -50%);
			font-size: 1.5rem;
			/*font-weight: 700;*/
			color: #fff;
			/* Changed to white to match your original */
		}

		nav {
			position: absolute;
			left: 20%;
			top: 50%;
			transform: translateY(-50%);
		}

		.nav-links {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.nav-links li {
			display: inline-block;
			margin-left: 20px;
		}

		.nav-links li a {
			color: #000;
			text-decoration: none;
			padding: 10px 15px;
			display: inline-block;
			transition: background-color .3s;
		}

		.nav-links li a:hover {
			background-color: #ced6ff;
			scale: 110%;
			border-radius: 10%;
		}

		.nav-links li a.active-page,
		.nav-links li a.inactive-page {
			background-color: #fff;
			border-radius: 10%;
		}

		/* burger (desktop hidden) */
		.burger {
			display: none;
			cursor: pointer;
			margin-left: 15px;
		}

		.burger div {
			width: 25px;
			height: 3px;
			background: #fff;
			margin: 5px;
			transition: .3s;
		}

		/* ---------- MOBILE NAV OVERRIDES ---------- */
		@@media(max-width:768px) {
			nav {
				position: relative;
				left: 0;
				top: 0;
				transform: none;
				margin-top: 10px;
			}

			.nav-links {
				display: none;
				width: 100%;
				text-align: center;
				position: absolute;
				background: #333;
				top: 60px;
				left: 0;
				z-index: 1;
			}

			.nav-links.active {
				display: block;
			}

			.nav-links li {
				display: block;
				margin: 10px 0;
			}

			.burger {
				display: block;
				float: right;
				margin-top: 15px;
			}

			.burger.active .line1 {
				transform: rotate(45deg) translate(-5px, 6px);
			}

			.burger.active .line2 {
				opacity: 0;
			}

			.burger.active .line3 {
				transform: rotate(-45deg) translate(-5px, -6px);
			}
		}

		/* ---------- MAIN LAYOUT ---------- */
		.content-wrapper {
			max-width: 900px;
			margin: 80px auto 40px;
			padding: 0 20px;
		}

		/* ---------- PROFILE CARD ---------- */
		.profile-section {
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
			padding: 1.5rem 2rem;
			margin-bottom: 2rem;
		}

		/* header row inside card */
		.profile-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
		}

		.profile-header h2 {
			color: #333;
			margin-bottom: .25rem;
		}

		/* settings action buttons */
		.settings-actions {
			display: flex;
			gap: .75rem;
			flex-wrap: wrap;
		}

		.settings-actions a {
			padding: .5rem 1rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #6981ec;
			font-size: .9rem;
			text-decoration: none;
			transition: all .25s;
		}

		.settings-actions a:hover {
			background: #6981ec;
			color: #fff;
		}

		/* definition list */
		.dl-horizontal {
			margin: 1rem 0 1.5rem;
		}

		.dl-horizontal dt {
			float: left;
			clear: left;
			width: 120px;
			font-weight: 600;
			color: #555;
		}

		.dl-horizontal dd {
			margin-left: 140px;
			color: #333;
		}

		/* table styling */
		.table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
			font-size: .95rem;
		}

		.table thead th {
			background: #e9efff;
			color: #333;
			font-weight: 600;
			padding: .75rem 1rem;
			text-align: left;
			border-bottom: 1px solid #d4d9ff;
		}

		.table tbody td {
			padding: .65rem 1rem;
			border-bottom: 1px solid #f0f0f0;
			color: #444;
		}

		/*.table tbody tr:nth-child(even) {
			background: #e6e9ff;
		}

		.table tbody tr:nth-child(odd) {
			background: #fafbff;
		}*/

		/* highlight lesson rows */
		.table tbody tr.lesson-row {
			background-color: #e6e9ff;
			/* light blue */
		}

		/* highlight transaction rows */
		.table tbody tr.transaction-row {
			background-color: #fff9cc;
			/* light yellow */
		}

		.time-zone .selector {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-left: 0.02rem;
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #000000;
			font-size: 1rem;
			text-decoration: none;
			transition: all .25s;
		}

		.time-zone .label {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-top: 0.5rem;

		}

		/* ---------- RESPONSIVE PROFILE ---------- */
		@@media(max-width:600px) {
			.profile-section {
				padding: 1rem 1.25rem;
			}

			.profile-header {
				flex-direction: column;
				align-items: flex-start;
			}

			.settings-actions {
				margin-top: .75rem;
			}

			.dl-horizontal dt,
			.dl-horizontal dd {
				float: none;
				width: auto;
				margin: 0 0 .5rem 0;
			}

			.table thead {
				display: none;
			}

			.table tbody td {
				display: block;
				width: 100%;
				text-align: right;
				padding-left: 50%;
				position: relative;
			}

			.table tbody td::before {
				content: attr(data-label);
				position: absolute;
				left: 1rem;
				width: calc(50% - 1rem);
				text-align: left;
				font-weight: 600;
				color: #666;
			}
		}
	</style>
</head>

<body>
	<!-- NAV -->
	<header>
		<div class="header-container">
			<div id="logo">@ViewData["Title"]</div>
			<nav>
				<ul class="nav-links">
					<li>
						<a asp-controller="Students" asp-action="Schedule" title="Schedule">
							<i class="hgi hgi-stroke hgi-calendar-03"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Students" asp-action="Index" title="Account">
							<i class="fas fa-user-graduate"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Students" asp-action="LessonAndTransactionHistory" title="History"
							class="active-page">
							<i class="fa-solid fa-dollar-sign"></i>
						</a>
					</li>
				</ul>

				<div class="burger">
					<div class="line1"></div>
					<div class="line3"></div>
				</div>
			</nav>
		</div>
	</header>

	<div class="content-wrapper">
		<div class="profile-section">
			<h4><b>Transaction History</b></h4>
			<div style="overflow-x:auto;">
				<table class="table">
					<thead>
						<tr>
							<th style="width: 30%;">Date/Time</th>
							<th style="width: 20%;">Lesson Status</th>
							<th style="width: 20%;">Lesson Duration</th>
							<th style="width: 10%;">Teacher</th>
							<th style="width: 20%;">Balance Change</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							var rowClass = !string.IsNullOrEmpty(item.Status) ? "lesson-row" : "transaction-row";

							<tr class="@rowClass">
								<td>@item.DateTime</td>
								<td>@(item.Status == null ? "Payment" : item.Status)</td>
								<td>@(item.DurationMinutes != null ? item.DurationMinutes + " minutes" : "")</td>
								<td>@item.TeacherName</td>
								<td>@(item.Amount > 0 ? "+" + item.Amount : item.Amount)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</body>