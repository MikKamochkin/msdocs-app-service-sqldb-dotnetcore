@model List<DotNetCoreSqlDb.Models.Schedule>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "My Schedule";
    var existingJson = ViewBag.ExistingJson as string ?? "[]";
    var timeZones = ViewBag.TimeZones as List<SelectListItem>;
    var studentId = ViewBag.StudentId;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        /* ---------- RESET ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ---------- PAGE BACKGROUND ---------- */
        body {
            font-family: Helvetica, sans-serif;
            /*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
            background: #e8ecfc;
            min-height: 100vh;
        }

        		header {
			background-color: #6981ec;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 60px;
			z-index: 1000;
		}

		.header-container {
			width: 100%;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
			height: 100%;
			position: relative; /* Needed for absolute positioning of children */
		}

		#logo {
			position: absolute;
			left: 12%;
			top: 50%;
			transform: translate(-50%, -50%);
			font-size: 1.5rem;
			/*font-weight: 700;*/
			color: #fff; /* Changed to white to match your original */
		}

		nav { position: absolute; left: 20%; top: 50%; transform: translateY(-50%); }
			.nav-links   { list-style: none; margin: 0; padding: 0; }
			.nav-links li{ display: inline-block; margin-left: 20px; }
			.nav-links li a{
			color: #000; text-decoration: none; padding: 10px 15px; display: inline-block;
			transition: background-color .3s;
			}
			.nav-links li a:hover        { background-color: #ced6ff; scale: 110%; border-radius: 10%; }
			.nav-links li a.active-page,
			.nav-links li a.inactive-page{ background-color: #fff; border-radius: 10%; }

        .burger {
            display: none;
            cursor: pointer;
            margin-left: 15px;
        }

        .burger div {
            width: 25px;
            height: 3px;
            background: #fff;
            margin: 5px;
            transition: .3s;
        }

        /* ---------- MOBILE NAV ---------- */
        @@media(max-width:768px) {
            nav {
                position: relative;
                left: 0;
                top: 0;
                transform: none;
                margin-top: 10px;
            }

            .nav-links {
                display: none;
                width: 100%;
                text-align: center;
                position: absolute;
                background: #333;
                top: 60px;
                left: 0;
                z-index: 1;
            }

            .nav-links.active {
                display: block;
            }

            .nav-links li {
                display: block;
                margin: 10px 0;
            }

            .burger {
                display: block;
                float: right;
                margin-top: 15px;
            }

            .burger.active .line1 {
                transform: rotate(45deg) translate(-5px, 6px);
            }

            .burger.active .line2 {
                opacity: 0;
            }

            .burger.active .line3 {
                transform: rotate(-45deg) translate(-5px, -6px);
            }
        }

        /* ---------- MAIN WRAPPER ---------- */
        .content-wrapper {
            max-width: 1100px;
            margin: 80px auto 40px;
            padding: 0 20px;
        }

        /* ---------- SCHEDULE CARD ---------- */
        .schedule-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
            padding: 1.5rem 2rem;
        }

        /* controls row (tz selector) */
        .controls {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
            justify-content: center;
        }

        .controls label {
            margin: 0;
            font-weight: bold;
        }

        .controls select {
            max-width: 260px;
            width: 100%;
            padding: .4rem .6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* ---------- TABLE ---------- */
        #entriesTable {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1.25rem;
            font-size: .95rem;
        }

        #entriesTable thead th {
            background: #e9efff;
            color: #333;
            font-weight: 600;
            padding: .75rem 1rem;
            text-align: left;
            border-bottom: 1px solid #d4d9ff;
        }

        #entriesTable tbody td {
            padding: .65rem 1rem;
            border-bottom: 1px solid #f0f0f0;
            color: #444;
            word-wrap: break-word;
        }

        #entriesTable tbody tr:nth-child(even) {
            background: #fafbff;
        }

        /* highlight next lesson */
        .next-row td {
            background: #fff3cd;
            font-weight: bold;
        }

        /* disabled join button */
        .disabled-btn,
        .disabled-btn:hover,
        .disabled-btn:active,
        .disabled-btn:focus {
            pointer-events: none;
            background: #6c757d !important;
            border-color: #6c757d !important;
            opacity: .65;
            color: #fff;
        }

        /* ---------- MOBILE TABLE ---------- */
        @@media(max-width:600px) {
            #entriesTable thead {
                display: none;
            }

            #entriesTable tbody td {
                display: block;
                width: 100%;
                text-align: right;
                padding-left: 50%;
                position: relative;
            }

            #entriesTable tbody td::before {
                content: attr(data-label);
                position: absolute;
                left: 1rem;
                width: calc(50% - 1rem);
                text-align: left;
                font-weight: 600;
                color: #666;
            }
        }
    </style>
</head>
<!-- NAV -->
<header>
    <div class="header-container">
        <div id="logo">@ViewData["Title"]</div>

        <nav>
            <ul class="nav-links">
                <li>
                    <a asp-controller="Students" asp-action="Schedule" title="Schedule" class="active-page">
                        <i class="hgi hgi-stroke hgi-calendar-03"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Students" asp-action="Index" title="Account">
                        <i class="fas fa-user-graduate"></i>
                    </a>
                </li>
            </ul>

            <div class="burger">
                <div class="line1"></div>
                <div class="line3"></div>
            </div>
        </nav>
    </div>
</header>

<!-- SCHEDULE CARD -->
<div class="content-wrapper">
    <div class="schedule-card">
        <!-- CONTROLS -->
        <div class="controls">
            <label for="timeZoneSelect">Time Zone:</label>
            <select id="timeZoneSelect" name="timeZoneOffset">
                @foreach (var tz in timeZones)
                {
                    if (tz.Selected)
                    {
                        <option value="@tz.Value" selected>@tz.Text</option>
                    }
                    else
                    {
                        <option value="@tz.Value">@tz.Text</option>
                    }
                }
            </select>
        </div>

        <!-- TABLE -->
        <table id="entriesTable">
            <colgroup>
                <col style="width:10%" />
                <col style="width:10%" />
                <col style="width:14%" />
                <col style="width:12%" />
                <col style="width:12%" />
                <col style="width:18%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Teacher</th>
                    <th>Status</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@* ---------- SCRIPTS ---------- *@
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.1.min.js"
        integrity="sha256-+LdG5Fjnxd8h8JAoywV4P8pIY2q3FfvMZHO7+jT9BkE=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>

    <script>
    (async () => {

        /* studentId injected by Razor */
        const studentId = '@ViewBag.StudentId';

        /* build + start connection */
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/scheduleHub")
            .withAutomaticReconnect()
            //.configureLogging(signalR.LogLevel.Information)
            .build();

        await connection.start();
        //console.log("SignalR connected. Joining group…");
        await connection.invoke("JoinStudentGroup", studentId);

        connection.on("ScheduleChanged", () => {
            //.log("Ping received – refresh!");
            refreshRows();                 // your existing function
        });

    })();
    </script>

