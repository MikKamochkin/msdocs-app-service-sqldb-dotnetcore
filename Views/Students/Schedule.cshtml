@model List<DotNetCoreSqlDb.Models.Schedule>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "My Schedule";
    var existingJson = ViewBag.ExistingJson as string ?? "[]";
    var timeZones = ViewBag.TimeZones as List<SelectListItem>;
    var studentId = ViewBag.StudentId;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        /* ---------- RESET ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ---------- PAGE BACKGROUND ---------- */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            /*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
            background: #e8ecfc;
            min-height: 100vh;
        }

        header {
            background-color: #6981ec;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 1000;
        }

        .header-container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            height: 100%;
            position: relative;
            /* Needed for absolute positioning of children */
        }

        #logo {
            position: absolute;
            left: 12%;
            top: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            /*font-weight: 700;*/
            color: #fff;
            /* Changed to white to match your original */
        }

        nav {
            position: absolute;
            left: 20%;
            top: 50%;
            transform: translateY(-50%);
        }

        .nav-links {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-links li {
            display: inline-block;
            margin-left: 20px;
        }

        .nav-links li a {
            color: #000;
            text-decoration: none;
            padding: 10px 15px;
            display: inline-block;
            transition: background-color .3s;
        }

        .nav-links li a:hover {
            background-color: #ced6ff;
            scale: 110%;
            border-radius: 10%;
        }

        .nav-links li a.active-page,
        .nav-links li a.inactive-page {
            background-color: #fff;
            border-radius: 10%;
        }

        .burger {
            display: none;
            cursor: pointer;
            margin-left: 15px;
        }

        .burger div {
            width: 25px;
            height: 3px;
            background: #fff;
            margin: 5px;
            transition: .3s;
        }

        /* ---------- MOBILE NAV ---------- */
        @@media (max-width: 768px) {

            /* Header: keep full text visible and aligned nicely */
            header {
                height: 56px;
            }

            .header-container {
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 12px;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: relative;
                /* still needed for nav dropdown positioning */
            }

            /* Override desktop absolute positioning on small screens */
            #logo {
                position: static;
                left: auto;
                top: auto;
                transform: none;
                font-size: 1rem;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 65%;
                /* prevents overlap with burger */
                color: #fff;
            }

            nav {
                position: static;
                left: auto;
                top: auto;
                transform: none;
                margin-top: 0;
            }

            /* Burger visible only on mobile */
            .burger {
                display: block;
                margin-top: 0;
                margin-left: 10px; /* small gap from the icons, like Index */
            }

            /* Dropdown nav menu */
            .nav-links {
                position: absolute;
                top: 56px;
                /* just under header */
                left: 0;
                right: 0;
                display: none;
                flex-direction: column;
                background: #3c4c97;
                /* mobile nav background */
                padding: 8px 0;
                z-index: 1001;
            }

            .nav-links.active {
                display: flex;
            }

            .nav-links li {
                display: block;
                width: 100%;
                margin: 0;
            }

            .nav-links li a {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
                padding: 10px 16px;
                color: #fff;
                text-decoration: none;
                border-radius: 0;
                background: transparent;
            }

            /* Icons inherit color so they stay visible on blue bg */
            .nav-links li a i {
                color: inherit;
                font-size: 1.1rem;
            }

            /* Active item: subtle highlight instead of white box */
            .nav-links li a.active-page {
                background: rgba(255, 255, 255, 0.16);
                border-left: 3px solid #ffe082;
            }

            /* Optional: slightly dim inactive links */
            .nav-links li a:not(.active-page) {
                opacity: 0.9;
            }

            /* Burger animation */
            .burger.active .line1 {
                transform: translateY(8px) rotate(45deg);
            }

            .burger.active .line2 {
                opacity: 0;
            }

            .burger.active .line3 {
                transform: translateY(-8px) rotate(-45deg);
            }
        }


        /* ---------- MAIN WRAPPER ---------- */
        .content-wrapper {
            max-width: 1100px;
            margin: 80px auto 40px;
            padding: 0 20px;
        }

        /* ---------- SCHEDULE CARD ---------- */
        .schedule-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
            padding: 1.5rem 2rem;
        }

        /* controls row (tz selector) */
        .controls {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
            justify-content: center;
        }

        .controls label {
            margin: 0;
            font-weight: bold;
        }

        /* display-only timezone label */
        .timezone-display {
            font-weight: 600;
            margin-left: 0.35rem;
        }

        /* hide the underlying select from the UI, keep for JS */
        .hidden-tz-select {
            display: none;
        }

        .controls select {
            max-width: 260px;
            width: 100%;
            padding: .4rem .6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* ---------- TABLE ---------- */
        #entriesTable {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1.25rem;
            font-size: .95rem;
        }

        #entriesTable thead th {
            background: #e9efff;
            color: #333;
            font-weight: 600;
            padding: .75rem 1rem;
            text-align: left;
            border-bottom: 1px solid #d4d9ff;
        }

        #entriesTable tbody td {
            padding: .65rem 1rem;
            border-bottom: 1px solid #f0f0f0;
            color: #444;
            word-wrap: break-word;
        }

        #entriesTable tbody tr:nth-child(even) {
            background: #fafbff;
        }

        /* highlight next lesson */
        .highlight-row td {
            background: #fff3cd;
            font-weight: bold;
        }

        /* disabled join button */
        .disabled-btn,
        .disabled-btn:hover,
        .disabled-btn:active,
        .disabled-btn:focus {
            pointer-events: none;
            background: #6c757d !important;
            border-color: #6c757d !important;
            opacity: .65;
            color: #fff;
        }

        /* ---------- MOBILE TABLE ---------- */
        @@media (max-width: 600px) {
            #entriesTable {
                border: 0;
            }

            #entriesTable colgroup {
                display: none;
            }

            #entriesTable thead {
                display: none;
            }

            #entriesTable tbody tr {
                display: block;
                margin-bottom: .75rem;
                background: #fafbff;
                border-radius: 8px;
                border: 1px solid #e5e5e5;
                overflow: hidden;
            }

            #entriesTable tbody td {
                display: flex;
                width: 100%;
                text-align: left;
                padding: .5rem .75rem;
                position: relative;
                border-bottom: 1px solid #eee;
            }

            #entriesTable tbody td:last-child {
                border-bottom: none;
            }

            #entriesTable tbody td::before {
                content: attr(data-label);
                font-weight: 600;
                color: #555;
                margin-right: .5rem;
                flex: 0 0 40%;
                max-width: 40%;
            }

            /* actions column: stack buttons full-width */
            #entriesTable td[data-label="Actions"] {
                flex-direction: column;
                gap: .35rem;
            }

            #entriesTable td[data-label="Actions"] a {
                width: 100%;
                text-align: center;
                font-size: .85rem;
                padding: .4rem .5rem;
            }
        }
    </style>
</head>
<!-- NAV -->
<header>
    <div class="header-container">
        <div id="logo">@ViewData["Title"]</div>

        <nav>
            <ul class="nav-links">
                <li>
                    <a asp-controller="Students" asp-action="Schedule" title="Schedule" class="active-page">
                        <i class="hgi hgi-stroke hgi-calendar-03"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Students" asp-action="Index" title="Account">
                        <i class="fas fa-user-graduate"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Students" asp-action="LessonAndTransactionHistory" title="History">
                        <i class="fa-solid fa-dollar-sign"></i>
                    </a>
                </li>
            </ul>

            <div class="burger">
                <div class="line line1"></div>
                <div class="line line2"></div>
                <div class="line line3"></div>
            </div>
        </nav>
    </div>
</header>

<!-- SCHEDULE CARD -->
<div class="content-wrapper">
    <div class="schedule-card">
        <!-- CONTROLS -->
        @*<div class="controls">
            <label for="timeZoneSelect">Time Zone:</label>
            <select id="timeZoneSelect" name="timeZoneOffset">
                @foreach (var tz in timeZones)
                {
                    if (tz.Selected)
                    {
                        <option value="@tz.Value" selected>@tz.Text</option>
                    }
                    else
                    {
                        <option value="@tz.Value">@tz.Text</option>
                    }
                }
            </select>
        </div>*@
        @{
            // Pick the selected time zone, or fall back to the first one
            var selectedTz = timeZones?.FirstOrDefault(t => t.Selected)
                            ?? timeZones?.FirstOrDefault();
        }

        <div class="controls">
            <label>Time Zone:</label>

            <!-- Display-only text -->
            <span class="timezone-display">
                @(selectedTz?.Text ?? "Not set")
            </span>

            <!-- Hidden value for JS to use -->
            <input type="hidden"
                id="timeZoneSelect"
                name="timeZoneOffset"
                value="@(selectedTz?.Value ?? "")" />
        </div>
        <div class="controls" style="font-size: small">
            <div>To change time zone, click here: </div>
            <a asp-controller="Students" asp-action="Index" title="Account">
                <i class="fas fa-user-graduate"></i>
            </a>
        </div>

        <!-- TABLE -->
        <table id="entriesTable">
            <colgroup>
                <col style="width:10%" />
                <col style="width:10%" />
                <col style="width:14%" />
                <col style="width:12%" />
                <col style="width:12%" />
                <col style="width:18%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Teacher</th>
                    <th>Status</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@* ---------- SCRIPTS ---------- *@
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.1.min.js"
        integrity="sha256-+LdG5Fjnxd8h8JAoywV4P8pIY2q3FfvMZHO7+jT9BkE=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>

    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const burger = document.querySelector('.burger');
            const navLinks = document.querySelector('.nav-links');

            if (burger && navLinks) {
                burger.addEventListener('click', function () {
                    burger.classList.toggle('active');
                    navLinks.classList.toggle('active');
                });
            }
        });


        (async () => {

            const studentId = '@ViewBag.StudentId';

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/scheduleHub")
                .withAutomaticReconnect()
                .build();

            await connection.start();
            await connection.invoke("JoinStudentGroup", studentId);
            connection.on("ScheduleChanged", () => {
                refreshRows();
            });
        })();

        const enterWaitingRoomBase = '@Url.Action("GetJoinUrl", "Students")';
        const waitRoomBase = '@Url.Action("Wait", "Students")';
        (() => {
            const { DateTime } = luxon;

            /* ───────── CONSTANTS (match Zoom page) ───────── */
            //console.log("Setting constants…");
            const minsBefore = 5;           // allow join 15 min before start
            const minsAfter = 90;           // …and 15 min after the lesson ENDS
            const meetingId = "7890699796";
            const pwd = "eXdhK0tMUHQvRmVQb2Q0MHYySWVZUT09";
            const deepLink = `https://us02web.zoom.us/j/7890699796?pwd=eXdhK0tMUHQvRmVQb2Q0MHYySWVZUT09`;
            const webLink = `https://us02web.zoom.us/j/${meetingId}?pwd=${pwd}`;
            const detailsBase = '@Url.Action("Zoom", "Students")';

            /* ───────── DATA ───────── */
            const raw = @Html.Raw(existingJson);
            const rows = raw
                .map(r => ({ ...r, DateTime: r.DateTime.endsWith('Z') ? r.DateTime : r.DateTime + 'Z' }))
                .sort((a, b) => DateTime.fromISO(a.DateTime) - DateTime.fromISO(b.DateTime)); // newest → oldest


            // Global timeout variable for refresh
            window.nextRefreshTimeout = null;

            window.refreshRows = async function refreshRows() {
                try {
                    const response = await fetch('@Url.Action("ScheduleJson", "Students")')
                        .then(r => r.json());

                    // Clear existing timeout if any
                    if (window.nextRefreshTimeout) {
                        clearTimeout(window.nextRefreshTimeout);
                        window.nextRefreshTimeout = null;
                    }

                    rows.length = 0;                             // clear array

                    // Handle both old format (array) and new format (object with rows property)
                    const latest = response.rows || response;

                    latest.forEach(src => {
                        // tolerate both PascalCase and camelCase coming from JSON
                        const rawTime = src.DateTime ?? src.dateTime;
                        if (!rawTime) return;                   // skip bad rows

                        rows.push({
                            Id: src.Id ?? src.id,
                            TeacherId: src.TeacherId ?? src.teacherId,
                            TeacherName: src.TeacherName ?? src.teacherName,
                            Status: src.Status ?? src.status,
                            Duration: Number(src.Duration ?? src.duration ?? 0),
                            DateTime: rawTime.endsWith('Z') ? rawTime : rawTime + 'Z',
                            CanJoinNow: (src.canJoinNow ?? src.CanJoinNow) === true,
                            EnableAtUtc: (src.enableAtUtc ?? src.EnableAtUtc) ?? null,
                            DisableAtUtc: (src.disableAtUtc ?? src.DisableAtUtc) ?? null,
                            HighlightRow: (src.highlightRow ?? src.HighlightRow) === true
                        });
                    });

                    renderTable();                              // redraw

                    // Set up next refresh timeout from response
                    const nextRefreshMs = response.nextRefreshMs;
                    if (Number.isFinite(nextRefreshMs) && nextRefreshMs > 0) {
                        console.log("Setting next refresh timeout in: " + nextRefreshMs + "ms");
                        window.nextRefreshTimeout = setTimeout(() => {
                            refreshRows();
                        }, nextRefreshMs);
                    }

                } catch (e) {
                    console.error("Refresh failed", e);
                }
            };

            // Initial setup
            $(function () {
                // Use refreshRows for initial load to handle timeout setup
                refreshRows();
            });

            // Clean up timeout when leaving page
            window.addEventListener('beforeunload', function () {
                if (window.nextRefreshTimeout) {
                    clearTimeout(window.nextRefreshTimeout);
                }
            });

            $('#timeZoneSelect').on('change', renderTable);

            function renderTable() {
                const zone = $('#timeZoneSelect').val();
                const nowUtc = DateTime.utc();
                const nowLocal = nowUtc.setZone(zone);
                const tbody = $('#entriesTable tbody').empty();

                let appendedCount = 0;
                rows.forEach(r => {
                    const startUtc = DateTime.fromISO(r.DateTime);
                    const diffMin = startUtc.diff(nowUtc, 'minutes').minutes;
                    const windowEnd = -(Number(r.Duration) + minsAfter);
                    const startLocal = startUtc.setZone(zone);
                    const isToday = startLocal.hasSame(nowLocal, 'day');
                    const status = r.Status;

                    let actionHtml = '';

                    if (r.CanJoinNow) {
                        actionHtml = buildBtn('enabled', r.Id)
                    }
                    /*else(){
                        actionHtml = buildBtn('disabled', r.Id);
                    }*/
                    //}

                    tbody.append(`
                                <tr class="${r.HighlightRow ? 'highlight-row' : ''}">
                                <td data-label="Date">${startLocal.toFormat('yyyy-LL-dd')}</td>
                                <td data-label="Time">${startLocal.toFormat('hh:mm a')}</td>
                                <td data-label="Teacher">${r.TeacherName}</td>
                                <td data-label="Status">${r.Status}</td>
                                <td data-label="Duration">${r.Duration}&nbsp;min</td>
                                <td data-label="Actions">${actionHtml}</td>
                                </tr>
                            `);
                    appendedCount++;

                });

                const domRowCount = $('#entriesTable tbody tr').length;
            }

            /* ---------- helpers ---------- */
            function buildBtn(state, id) {
                const disabled = state === 'disabled';
                const detailsBtn = `
                                <a
                                    href="${detailsBase}?scheduleId=${id}"
                                    class="btn btn-info btn-md ml-3"
                                    title="Lesson details">
                                    <i class="fa-solid fa-circle-info text-light"></i>
                                    </a>`;

                const waitBtn = `
                                <a href="${waitRoomBase}?scheduleId=${id}"
                                    class="btn btn-primary btn-md ml-2${disabled ? " disabled-btn" : ""}"
                                            ${disabled ? `aria-disabled="true" tabindex="-1"` : ""}"
                                    target="_blank"
                                    rel="noopener noreferrer">
                                    Join Lesson
                                </a>`;
                return waitBtn + detailsBtn;
            }

            /* open Zoom + browser fallback */
            $(document).on('click', '.join-btn', function (e) {
                if ($(this).hasClass('disabled-btn')) return;
                e.preventDefault();
                const $btn = $(this);
                const url = $btn.attr('href');
                window.open(url, '_blank');
                setTimeout(() => window.open(weblink, '_blank'), 500);
            });
        })();
    </script>
}