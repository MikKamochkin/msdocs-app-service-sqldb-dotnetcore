            */
            window.refreshRows = async function refreshRows() {
                try {
                    const latest = await fetch('@Url.Action("ScheduleJson","Students")')
                                        .then(r => r.json());

                    rows.length = 0;                             // clear array

                    latest.forEach(src => {
                        // tolerate both PascalCase and camelCase coming from JSON
                        const rawTime = src.DateTime ?? src.dateTime;
                        if (!rawTime) return;                   // skip bad rows

                        rows.push({
                            Id:          src.Id          ?? src.id,
                            TeacherId:   src.TeacherId   ?? src.teacherId,
                            TeacherName: src.TeacherName ?? src.teacherName,
                            Status:      src.Status      ?? src.status,
                            // ensure we always have a *number*
                            Duration:    Number(src.Duration ?? src.duration ?? 0),
                            DateTime:    rawTime.endsWith('Z') ? rawTime : rawTime + 'Z'
                        });
                    });

                    renderTable();                              // redraw
                } catch (e) {
                    console.error("Refresh failed", e);
                }
            };


            /* ───────── SIGNALR SETUP ───────── */
            // 1) Build a connection to the exact same endpoint you mapped in Program.cs:
            //      app.MapHub<ScheduleHub>("/scheduleHub");
            //    so here we use "/scheduleHub" (not "/hubs/scheduleHub").
            /*console.log("Building SignalR connection…");
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/scheduleHub")
                .withAutomaticReconnect()
                .build();

            connection.onclose(error => {
                console.error("SignalR: connection closed:", error);
            });

            connection.onreconnected(connId => {
                console.log("SignalR: reconnected, connectionId=", connId);
            });

            // 2) Once the connection is up, join each teacher’s group:
            console.log("Starting SignalR connection…");
            connection.start()
                .then(() => {
                    console.log("SignalR connected to /hubs/scheduleHub (connectionId:", connection.connectionId, ")");

                    // Extract unique TeacherId values from `rows`:
                    const uniqueTeacherIds = [...new Set(rows.map(r => r.TeacherId))];
                    console.log("Attempting to JoinTeacherGroup for:", uniqueTeacherIds);
                    uniqueTeacherIds.forEach(tid => {
                        // invoke the Hub method that adds us to "teacher_{tid}" group
                        connection.invoke("JoinTeacherGroup", tid)
                            .then(() => console.log(`Joined group: teacher_${tid}`))
                            .catch(err => console.error("JoinTeacherGroup failed:", err.toString()));
