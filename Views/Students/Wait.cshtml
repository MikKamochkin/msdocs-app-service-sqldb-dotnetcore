@* Views/Teachers/Wait.cshtml *@
@model Guid
@{
    Layout = "_Layout";
    var scheduleId = Model.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" />

    <style>
        /* ---------- RESET ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* push your text above the loader */
        .content-wrapper {
            position: relative;
            z-index: 100000;       /* above .loader's 99999 */
            color: #000000;           /* so it shows up on the dark gradient */
            margin: 20vh auto 0;   /* lift it a bit nearer the top */
            text-align: center;
            font-family: Helvetica, sans-serif;
        }

        .loader {
            background-color: #e8ecfc;
            bottom: 0;
            left: 0;
            overflow: hidden;
            position: fixed;
            right: 0;
            top: 0;
            z-index: 99999;       /* just under .content-wrapper */
        }

        .loader-inner {
            bottom: 0;
            height: 60px;
            left: 0;
            margin: auto;
            position: absolute;
            right: 0;
            top: 0;
            width: 100px;
        }

        .loader-line-wrap {
            animation:
                spin 2000ms cubic-bezier(.175, .885, .32, 1.275) infinite;
            box-sizing: border-box;
            height: 50px;
            left: 0;
            overflow: hidden;
            position: absolute;
            top: 0;
            transform-origin: 50% 100%;
            width: 100px;
        }

        .loader-line {
            border: 4px solid transparent;
            border-radius: 100%;
            box-sizing: border-box;
            height: 100px;
            left: 0;
            margin: 0 auto;
            position: absolute;
            right: 0;
            top: 0;
            width: 100px;
        }

        .loader-line-wrap:nth-child(1) { animation-delay: -50ms; }
        .loader-line-wrap:nth-child(2) { animation-delay: -100ms; }
        .loader-line-wrap:nth-child(3) { animation-delay: -150ms; }
        .loader-line-wrap:nth-child(4) { animation-delay: -200ms; }
        .loader-line-wrap:nth-child(5) { animation-delay: -250ms; }

        .loader-line-wrap:nth-child(1) .loader-line {
            border-color: hsl(0, 100%, 0%);
            height: 90px; width: 90px; top: 7px;
        }
        .loader-line-wrap:nth-child(2) .loader-line {
            border-color: hsl(0, 0%, 0%);
            height: 76px; width: 76px; top: 14px;
        }
        .loader-line-wrap:nth-child(3) .loader-line {
            border-color: hsl(0, 0%, 0%);
            height: 62px; width: 62px; top: 21px;
        }
        /*.loader-line-wrap:nth-child(4) .loader-line {
            border-color: hsl(0, 0%, 0%);
            height: 48px; width: 48px; top: 28px;
        }
        .loader-line-wrap:nth-child(5) .loader-line {
            border-color: hsl(0, 0%, 0%);
            height: 34px; width: 34px; top: 35px;
        }*/

        @@keyframes spin {
            0%, 15% { transform: rotate(0); }
            100%    { transform: rotate(360deg); }
        }

        /* ---------- PAGE BACKGROUND ---------- */
        body {
            font-family: Helvetica, sans-serif;
            background: #e8ecfc;
            min-height: 100vh;
        }

        /* ---------- NAVBAR (inherited from _Layout) ---------- */
        header { /* … your existing navbar styles … */ }

        /* ---------- MOBILE NAV ---------- */
        @@media(max-width: 768px) {
            /* … */
        }
    </style>
</head>

<body>
    <div class="content-wrapper">
        <h1 class="mt-4"><b>Waiting room</b></h1>
        <h3><b>Please hang on - your teacher will start your lesson soon.</b></h3>

        @* —— old Bootstrap spinner, now commented out —— *@
        @*<div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>*@
    </div>

    <!-- new rainbow loader -->
    <div class="loader">
        <div class="loader-inner">
            <div class="loader-line-wrap"><div class="loader-line"></div></div>
            <div class="loader-line-wrap"><div class="loader-line"></div></div>
            <div class="loader-line-wrap"><div class="loader-line"></div></div>
            <div class="loader-line-wrap"><div class="loader-line"></div></div>
            <div class="loader-line-wrap"><div class="loader-line"></div></div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script>
            (function () {
                const scheduleId = '@scheduleId';
                const checkUrl = `@Url.Action("GetJoinUrl","Students")?scheduleId=${scheduleId}`;
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/zoomMeetingHub")
                    .build();

                connection.on('MeetingCreated', link => {
                    window.location.href = link;
                });

                async function init() {
                    try {
                        await connection.start();
                        await connection.invoke('JoinGroup', scheduleId);
                    } catch (err) {
                        console.error('SignalR error', err);
                    }

                    try {
                        const resp = await fetch(checkUrl);
                        if (resp.status === 200) {
                            const { joinUrl } = await resp.json();
                            window.location.href = joinUrl;
                        }
                    } catch (err) {
                        console.error('Initial check failed', err);
                    }
                }

                init();
            })();
        </script>
    }
</body>
</html>
