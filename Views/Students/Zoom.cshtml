@model DotNetCoreSqlDb.Models.Student
@{
    ViewData["Title"] = "Zoom";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <!-- <link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css" /> -->

  <style>
    /* ---------- RESET ---------- */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* ---------- PAGE BACKGROUND ---------- */
    body {
      font-family: Helvetica, sans-serif;
      background: linear-gradient(to bottom right, #b2e7ff, #ffffff);
      min-height: 100vh;
    }

    /* ---------- NAVBAR ---------- */
    header {
      background-color: #6981ec;
      color: #fff;
      padding: 10px 0;
      min-height: 60px;
      position: relative;
    }
    .header-container {
      max-width: 1250px;
      margin: 0 auto;
      overflow: hidden;
    }
    #logo {
      float: left;
      font-size: 1.5em;
      color: #ffffff;
      padding-top: 5px;
    }

    /* ---------- DESKTOP NAV (40 % FROM VIEWPORT LEFT) ---------- */
    nav {
      position: absolute;
      left: 25vw;
      top: 50%;
      transform: translateY(-50%);
    }
    .nav-links {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav-links li        { display: inline-block; margin-left: 20px; }
    .nav-links li a {
      color: #000000;
      text-decoration: none;
      padding: 10px 15px;
      display: inline-block;
      transition: background-color 0.3s;
    }
    .nav-links li a:hover         { background-color: #ced6ff; scale: 110%; border-radius: 10%; }
    .nav-links li a.active-page   { background-color: #ffffff; border-radius: 10%; }
    .nav-links li a.inactive-page { background-color: rgb(255,255,255); border-radius: 10%; }

    /* burger (hidden on desktop) */
    .burger { display: none; cursor: pointer; margin-left: 15px; }
    .burger div {
      width: 25px; height: 3px;
      background-color: #fff;
      margin: 5px;
      transition: transform 0.3s, background-color 0.3s;
    }

    /* ---------- MOBILE NAV OVERRIDES ---------- */
    @@media screen and (max-width: 768px) {
      nav {
        position: relative;
        left: 0;
        top: 0;
        transform: none;
        margin-top: 10px;
      }
      .nav-links {
        display: none;
        width: 100%;
        text-align: center;
        position: absolute;
        background-color: #333;
        top: 60px; left: 0;
        z-index: 1;
      }
      .nav-links.active { display: block; }
      .nav-links li { display: block; margin: 10px 0; }
      .burger { display: block; float: right; margin-top: 15px; }
      .burger.active .line1 { transform: rotate(45deg) translate(-5px, 6px); }
      .burger.active .line2 { opacity: 0; }
      .burger.active .line3 { transform: rotate(-45deg) translate(-5px, -6px); }
    }

    /* ---------- CARD / CONTENT LAYOUT ---------- */
    .content-wrapper {
      max-width: 900px;
      margin: 80px auto 40px; /* leave room for header */
      padding: 0 20px;
      text-align: center;     /* centre cards */
    }

    /* Re-usable polished card */
    .card {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      padding: 1.5rem 2rem;
      margin: 0 auto 2rem;
      display: inline-block;   /* shrink width to content */
      max-width: 420px;        /* cap for readability */
    }

    /* Zoom buttons */
    .zoom-btn,
    #copy-zoom {
      display: inline-block;   /* prevents full-width expansion */
      width: auto;             /* natural width */
      max-width: 260px;        /* safety cap */
      white-space: nowrap;     /* keep text on one line */
      margin-left: auto;
      margin-right: auto;
    }
    .zoom-btn      { margin-bottom: 1.5rem; }
    #copy-zoom     { margin-top: 0.5rem; }

    /* small-screen tweaks */
    @@media screen and (max-width: 600px) {
      .card { padding: 1rem 1.25rem; max-width: 90%; }
    }
  </style>
</head>
<body>
  <!-- NAV -->
  <header>
    <div class="header-container">
      <div id="logo">@ViewData["Title"]</div>

      <nav>
        <ul class="nav-links">
          <li>
            <a asp-controller="Students" asp-action="Schedule" title="Schedule">
              <i class="hgi hgi-stroke hgi-calendar-03"></i>
            </a>
          </li>
          <li>
            <a asp-controller="Students" asp-action="Zoom" title="Zoom" class="active-page">
              <i class="hgi hgi-stroke hgi-zoom"></i>
            </a>
          </li>
          <li>
            <a asp-controller="Students" asp-action="Index" title="Account">
              <i class="fas fa-user-graduate"></i>
            </a>
          </li>
        </ul>

        <div class="burger">
          <div class="line1"></div><div class="line2"></div><div class="line3"></div>
        </div>
      </nav>
    </div>
  </header>

  <!-- ZOOM JOIN SECTION -->
  <div class="content-wrapper">
    <div class="card">
      <br>
      <a id="zoom-link"
         class="btn btn-primary zoom-btn"
         href="https://us02web.zoom.us/j/7890699796?pwd=eXdhK0tMUHQvRmVQb2Q0MHYySWVZUT09">
         Join&nbsp;Zoom&nbsp;Meeting
      </a>
      <br />
      <b>Meeting&nbsp;ID:</b>&nbsp;789&nbsp;069&nbsp;9796<br />
      <b>Passcode:</b>&nbsp;662638<br /><br />
      <button id="copy-zoom" type="button" class="btn btn-info btn-sm">
        Copy&nbsp;Zoom&nbsp;link&nbsp;to&nbsp;clipboard
      </button>
      <br>
      <br>
    </div>
  </div>

  <!-- ---------- SCRIPTS ---------- -->
  <script>
    /* burger toggle (mobile) */
    document.querySelector('.burger').addEventListener('click', e => {
      e.currentTarget.classList.toggle('active');
      document.querySelector('.nav-links').classList.toggle('active');
    });

    /* Deep-link into Zoom app if installed */
    const meetingId = "7890699796";
    const pwd       = "eXdhK0tMUHQvRmVQb2Q0MHYySWVZUT09";
    const deepLink  = `zoommtg://zoom.us/join?action=join&confno=${meetingId}&pwd=${pwd}`;

    /* Join button */
    document.getElementById("zoom-link").addEventListener("click", e => {
      e.preventDefault();
      window.location.href = deepLink;
      setTimeout(() => { window.location.href = e.currentTarget.href; }, 500);
    });

    /* Copy to clipboard */
    document.getElementById("copy-zoom").addEventListener("click", () => {
      const url = document.getElementById("zoom-link").href;
      navigator.clipboard.writeText(url)
        .then(() => alert("Copied to clipboard:\n" + url))
        .catch(err => alert("Failed to copy:\n" + err));
    });
  </script>
</body>
</html>
