@model DotNetCoreSqlDb.Models.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-dark d-flex icon-btn" title="Student Management">
                    <i class="fas fa-user-graduate"></i>
                </a>
                <a href="@Url.Action("Index", "Groups")" class="btn btn-dark d-flex icon-btn" title="Manage Groups">
                    <i class="fas fa-users"></i>
                </a>
                <a href="@Url.Action("Manage", "Schedule")" class="btn btn-dark d-flex icon-btn" title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
                <a href="@Url.Action("Index", "Whatsapp")" class="btn btn-dark d-flex icon-btn" title="WhatsApp">
                    <i class="hgi hgi-stroke hgi-message-01"></i>
                </a>
                <a href="@Url.Action("Index", "Assignments")" class="btn btn-dark icon-btn" title="Assignments">
                    <i class="fas fa-tasks"></i>
                </a>
                <a href="@Url.Action("Index", "TeacherManagement")" class="btn btn-success icon-btn" title="Teachers">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </a>
            </div>
        </div>
    }
    <div class="col">
        <h2>Teacher Details</h2>

        <div>
            <h4>Teacher</h4>
            <hr />
            <dl class="dl-horizontal">
                <dt>Name</dt>
                <dd>@Html.DisplayFor(model => model.Name)</dd>
            </dl>
        </div>

        <h4>Contact Information</h4>

        <div class="details-buttons">
            <a  
                href='@Url.Action("Edit", new { id = Model.Id })'
                class="btn btn-dark icon-btn"
                title="Edit Teacher">
                <i class="fa-solid fa-pencil"></i>
            </a>
            <a 
                href='@Url.Action("Index")'
                class="btn btn-dark icon-btn"
                title="Back to List">
                <i class="hgi hgi-stroke hgi-arrow-turn-backward"></i>
            </a>
            </div>

    </div>
</div>
