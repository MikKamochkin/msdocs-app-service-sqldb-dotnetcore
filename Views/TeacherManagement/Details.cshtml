@model DotNetCoreSqlDb.Models.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}

<style>
    .teacher-details-page {
        min-height: 100vh;
        background: #e8ecfc;
    }

    .teacher-details-content {
        min-width: 0;
        padding: 1rem;
        color: #2f3445;
    }

    .teacher-details-shell {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
    }

    .teacher-details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .75rem;
    }

    .teacher-details-content h2 {
        margin: 0;
        color: #333;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .teacher-details-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .teacher-details-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: .45rem .8rem;
        border: 1px solid #6981ec;
        border-radius: 6px;
        background: #fff;
        color: #6981ec;
        font-size: .95rem;
        font-weight: 500;
        text-decoration: none;
        transition: all .2s ease;
    }

    .teacher-details-action.icon-only {
        width: 38px;
        padding: 0;
    }

    .teacher-details-action:hover {
        background: #6981ec;
        color: #fff;
        text-decoration: none;
    }

    .teacher-details-card {
        min-width: 0;
        padding: .85rem 1rem;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
    }

    .teacher-details-card h4 {
        margin: 0 0 .65rem;
        color: #333;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .teacher-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .55rem .75rem;
        margin: 0;
    }

    .teacher-info-item {
        min-width: 0;
        padding: .55rem .65rem;
        border: 1px solid #c6c9da;
        border-radius: 6px;
        background: #fafbff;
    }

    .teacher-info-item dt {
        margin: 0 0 .15rem;
        color: #68708a;
        font-size: .8rem;
        font-weight: 700;
        line-height: 1.15;
        text-transform: uppercase;
        letter-spacing: .035em;
    }

    .teacher-info-item dd {
        margin: 0;
        overflow-wrap: anywhere;
        color: #333;
        font-size: 1rem;
        line-height: 1.3;
    }

    @@media (max-width: 767px) {
        .teacher-details-content {
            padding: .75rem;
        }

        .teacher-details-header {
            align-items: flex-start;
        }

        .teacher-details-content h2 {
            font-size: 1.5rem;
        }

        .teacher-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="row no-gutters teacher-details-page">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
    }
    <main class="col teacher-details-content">
        <div class="teacher-details-shell">
        <div class="teacher-details-header">
            <h2>Teacher Details</h2>
            <div class="teacher-details-actions">
                <a href='@Url.Action("Edit", new { id = Model.Id })'
                   class="teacher-details-action icon-only"
                   title="Edit Teacher"
                   aria-label="Edit Teacher">
                    <i class="fa-solid fa-pencil"></i>
                </a>
                <a href='@Url.Action("Index")'
                   class="teacher-details-action icon-only"
                   title="Back to List"
                   aria-label="Back to List">
                    <i class="hgi hgi-stroke hgi-arrow-turn-backward"></i>
                </a>
            </div>
        </div>

        <section class="teacher-details-card">
            <h4>Teacher</h4>
            <dl class="teacher-info-grid">
                <div class="teacher-info-item">
                    <dt>Name</dt>
                    <dd>@Html.DisplayFor(model => model.Name)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Email</dt>
                    <dd>@Html.DisplayFor(model => model.Email)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Address</dt>
                    <dd>@Html.DisplayFor(model => model.StreetAddress)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>City</dt>
                    <dd>@Html.DisplayFor(model => model.City)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Province Or State</dt>
                    <dd>@Html.DisplayFor(model => model.ProvinceOrState)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Postal Code</dt>
                    <dd>@Html.DisplayFor(model => model.PostalCode)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Country</dt>
                    <dd>@Html.DisplayFor(model => model.Country)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Phone Number</dt>
                    <dd>@Html.DisplayFor(model => model.PhoneNumber)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>ETransfer Email</dt>
                    <dd>@Html.DisplayFor(model => model.ETransferEmail)</dd>
                </div>
                <div class="teacher-info-item">
                    <dt>Enabled Invoicing</dt>
                    <dd>@Html.DisplayFor(model => model.EnableInvoicing)</dd>
                </div>
            </dl>
        </section>
        </div>
    </main>
</div>
