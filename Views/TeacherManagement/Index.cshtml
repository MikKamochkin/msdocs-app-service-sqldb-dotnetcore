@model IEnumerable<DotNetCoreSqlDb.Models.Teacher>

@{
    ViewData["Title"] = "Students List";
}

<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support") || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
        
        <div class="col-md-10">
            <h2>Teacher List</h2>

            <p>
                <a href="@Url.Action("Create")" class="btn btn-primary">Create New Teacher</a>
            </p>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Name
                        </th>
                        <th>
                            Email
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            @*<td>
                                <a href="@Url.Action("Details", new { id = item.ID })"><i class="fa-solid fa-circle-info btn-lg text-dark"></i></a>
                            </td>*@
                            <td>
                                <a href="@Url.Action("Details", new { id = item.Id })"><i class="fa-solid fa-circle-info btn-lg text-dark"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
}
