@model DotNetCoreSqlDb.Models.Teacher
@{
	ViewData["Title"] = "My Information";
	var timeZones = ViewBag.TimeZones as List<SelectListItem>;
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>

	<style>
		/* ---------- RESET ---------- */
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		/* ---------- PAGE BACKGROUND ---------- */
		body {
			font-family: Helvetica, sans-serif;
			/*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
			background: #e8ecfc;
			min-height: 100vh;
		}

		/* ---------- HEADER / NAV ---------- */
		header {
			background-color: #6981ec;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 60px;
			z-index: 1000;
		}

		.header-container {
			width: 100%;
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
			height: 100%;
			position: relative;
			/* Needed for absolute positioning of children */
		}

		#logo {
			position: absolute;
			left: 12%;
			top: 50%;
			transform: translate(-50%, -50%);
			font-size: 1.5rem;
			/*font-weight: 700;*/
			color: #fff;
			/* Changed to white to match your original */
		}

		nav {
			position: absolute;
			left: 20%;
			top: 50%;
			transform: translateY(-50%);
		}

		.nav-links {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.nav-links li {
			display: inline-block;
			margin-left: 20px;
		}

		.nav-links li a {
			color: #000;
			text-decoration: none;
			padding: 10px 15px;
			display: inline-block;
			transition: background-color .3s;
		}

		.nav-links li a:hover {
			background-color: #ced6ff;
			scale: 110%;
			border-radius: 10%;
		}

		.nav-links li a.active-page,
		.nav-links li a.inactive-page {
			background-color: #fff;
			border-radius: 10%;
		}

		/* burger (desktop hidden) */
		.burger {
			display: none;
			cursor: pointer;
			margin-left: 15px;
		}

		.burger div {
			width: 25px;
			height: 3px;
			background: #fff;
			margin: 5px;
			transition: .3s;
		}

		/* ---------- MOBILE NAV OVERRIDES ---------- */
		@@media(max-width:768px) {
			nav {
				position: relative;
				left: 0;
				top: 0;
				transform: none;
				margin-top: 10px;
			}

			.nav-links {
				display: none;
				width: 100%;
				text-align: center;
				position: absolute;
				background: #333;
				top: 60px;
				left: 0;
				z-index: 1;
			}

			.nav-links.active {
				display: block;
			}

			.nav-links li {
				display: block;
				margin: 10px 0;
			}

			.burger {
				display: block;
				float: right;
				margin-top: 15px;
			}

			.burger.active .line1 {
				transform: rotate(45deg) translate(-5px, 6px);
			}

			.burger.active .line2 {
				opacity: 0;
			}

			.burger.active .line3 {
				transform: rotate(-45deg) translate(-5px, -6px);
			}
		}

		/* ---------- MAIN LAYOUT ---------- */
		.content-wrapper {
			max-width: 900px;
			margin: 80px auto 40px;
			padding: 0 20px;
		}

		/* ---------- PROFILE CARD ---------- */
		.profile-section {
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
			padding: 1.5rem 2rem;
			margin-bottom: 2rem;
		}

		/* header row inside card */
		.profile-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
		}

		.profile-header h2 {
			color: #333;
			margin-bottom: .25rem;
		}

		/* settings action buttons */
		.settings-actions {
			display: flex;
			gap: .75rem;
			flex-wrap: wrap;
		}

		.settings-actions a {
			padding: .5rem 1rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #6981ec;
			font-size: .9rem;
			text-decoration: none;
			transition: all .25s;
		}

		.settings-actions a:hover {
			background: #6981ec;
			color: #fff;
		}

		/* definition list */
		.dl-horizontal {
			margin: 1rem 0 1.5rem;
		}

		.dl-horizontal dt {
			float: left;
			clear: left;
			width: 120px;
			font-weight: 600;
			color: #555;
		}

		.dl-horizontal dd {
			margin-left: 140px;
			color: #333;
		}

		/* table styling */
		.table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
			font-size: .95rem;
		}

		.table thead th {
			background: #e9efff;
			color: #333;
			font-weight: 600;
			padding: .75rem 1rem;
			text-align: left;
			border-bottom: 1px solid #d4d9ff;
		}

		.table tbody td {
			padding: .65rem 1rem;
			border-bottom: 1px solid #f0f0f0;
			color: #444;
		}

		.table tbody tr:nth-child(even) {
			background: #fafbff;
		}

		.time-zone .selector {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-left: 0.02rem;
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
			border: 1px solid #6981ec;
			border-radius: 6px;
			background: #fff;
			color: #000000;
			font-size: 1rem;
			text-decoration: none;
			transition: all .25s;
		}

		.time-zone .label {
			vertical-align: middle;
			/*background:#fff;
      color:#000000;
      border-radius: 25%;
      padding:.5rem 1rem;*/
			padding-top: 0.5rem;

		}

		/* ---------- RESPONSIVE PROFILE ---------- */
		@@media(max-width:600px) {
			.profile-section {
				padding: 1rem 1.25rem;
			}

			.profile-header {
				flex-direction: column;
				align-items: flex-start;
			}

			.settings-actions {
				margin-top: .75rem;
			}

			.dl-horizontal dt,
			.dl-horizontal dd {
				float: none;
				width: auto;
				margin: 0 0 .5rem 0;
			}

			.table thead {
				display: none;
			}

			.table tbody td {
				display: block;
				width: 100%;
				text-align: right;
				padding-left: 50%;
				position: relative;
			}

			.table tbody td::before {
				content: attr(data-label);
				position: absolute;
				left: 1rem;
				width: calc(50% - 1rem);
				text-align: left;
				font-weight: 600;
				color: #666;
			}
		}
	</style>
</head>

<body>
	<!-- NAV -->
	<header>
		<div class="header-container">
			<div id="logo">@ViewData["Title"]</div>

			<nav>
				<ul class="nav-links">
					<li>
						<a asp-controller="Teachers" asp-action="Schedule" title="Schedule">
							<i class="hgi hgi-stroke hgi-calendar-03"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Teachers" asp-action="Index" title="Account" class="active-page">
							<i class="fas fa-user-graduate"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Teachers" asp-action="EditSchedule" title="Edit Schedule">
							<i class="fa-regular fa-calendar-plus"></i>
						</a>
					</li>
					<li>
						<a asp-controller="Teachers" asp-action="LessonHistory" title="History">
							<i class="fa-regular fa-calendar-days"></i>
						</a>
					</li>
				</ul>

				<div class="burger">
					<div class="line1"></div>
					<div class="line3"></div>
				</div>
			</nav>
		</div>
	</header>

	<!-- PROFILE CONTENT -->
	<div class="content-wrapper">
		<!-- PROFILE DETAILS -->
		<div class="profile-section">
			<div class="profile-header">
				<h2><b>My Profile</b></h2>

				<!-- SETTINGS BUTTONS -->
				<div class="settings-actions">
					<!--<a asp-controller="AccountManagement"
             asp-action="ChangeUsername"
             asp-route-userId="@Model.Id">
            Change Username
          </a>-->
					<a asp-controller="AccountManagement" asp-action="ChangePassword" asp-route-userId="@Model.Id">
						Change Password
					</a>
				</div>

			</div>
			<hr />
			<dl class="dl-horizontal">
				<dt>Name</dt>
				<dd>@Html.DisplayFor(m => m.Name)</dd>
				<dt>Username</dt>
				<dd>@ViewBag.Username</dd>

				<form id="timezoneForm">
					@Html.AntiForgeryToken()
					<div class="time-zone">
						<dt class="label">Default time</dt>
						<dd>
							<select id="timeZoneSelect" name="timeZoneId" class="selector col-md-3.5">
								@foreach (var tz in timeZones)
								{
									<option value="@tz.Value" selected="@tz.Selected">@tz.Text</option>
								}
							</select>
						</dd>
					</div>
				</form>
			</dl>
		</div>
		<!-- CONTACT INFO -->
		<div class="profile-section">
			<h4><b>Contact Information</b></h4>
			@if (Model.Email != null)
			{
				<div style="overflow-x:auto;">
					<table class="table">
						<thead>
							@*<tr>
                <th>Type</th><th>Value</th><th>Invitation</th><th>Emergency</th><th>Money</th>
              </tr>*@
						</thead>
						<tbody>

							<tr>
								<td data-label="Type">Email</td>
								<td data-label="Value">@Model.Email</td>
								@*<td data-label="Invitation">@(contact.Invitation ? "✔" : "")</td>
                  <td data-label="Emergency">@(contact.Emergency ? "✔" : "")</td>
                  <td data-label="Money">@(contact.Money ? "✔" : "")</td>*@
							</tr>

						</tbody>
					</table>
				</div>
			}
			else
			{
				<p>No contact information available.</p>
			}
		</div>
	</div>

	<!-- ---------- SCRIPTS ---------- -->
	<script>
		/* burger toggle (mobile) */
		document.querySelector('.burger').addEventListener('click', e => {
			e.currentTarget.classList.toggle('active');
			document.querySelector('.nav-links').classList.toggle('active');
		});


		document.getElementById('timeZoneSelect').addEventListener('change', function () {
			const selectedTimeZone = this.value;

			fetch('@Url.Action("SaveTimeZone", "Teachers")', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
				},
				body: JSON.stringify({ timeZoneId: selectedTimeZone })
			})
				.then(response => {
					if (!response.ok) throw new Error('Failed to save');
					console.log("Time zone updated!");
				})
				.catch(error => {
					console.error('Error updating time zone:', error);
				});
		});
	</script>
</body>

</html>