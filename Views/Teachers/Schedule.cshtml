@model List<DotNetCoreSqlDb.Models.Schedule>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
	ViewData["Title"] = "My Schedule";
	var existingJson = ViewBag.ExistingJson as string ?? "[]";
	var timeZones = ViewBag.TimeZones as List<SelectListItem>;
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>

	<style>
		/* ---------- RESET ---------- */
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		/* ---------- PAGE BACKGROUND ---------- */
		body {
			font-family: Helvetica, sans-serif;
			/*background: linear-gradient(to bottom right, #b2e7ff, #ffffff);*/
			background: #e8ecfc;
			min-height: 100vh;
		}

		/* ---------- HEADER / NAV ---------- */
		header {
			position: relative;
			left: 50%;
			width: 100vw;
			/* full viewport width */
			margin-left: -50vw;
			/* pull it back so it’s centered */

			/* (your existing styles) */
			background: #6981ec;
			color: #fff;
			padding: 10px 0;
			min-height: 60px;
		}

		.header-container {
			max-width: 1250px;
			margin: 0 auto;
			overflow: hidden;
		}

		#logo {
			float: left;
			font-size: 1.5em;
			color: #fff;
			padding-top: 5px;
		}

		nav {
			position: absolute;
			left: 25vw;
			top: 50%;
			transform: translateY(-50%);
		}

		.nav-links {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.nav-links li {
			display: inline-block;
			margin-left: 20px;
		}

		.nav-links li a {
			color: #000;
			text-decoration: none;
			padding: 10px 15px;
			display: inline-block;
			transition: background-color .3s;
		}

		.nav-links li a:hover {
			background: #ced6ff;
			scale: 110%;
			border-radius: 10%;
		}

		.nav-links li a.active-page,
		.nav-links li a.inactive-page {
			background: #fff;
			border-radius: 10%;
		}

		.burger {
			display: none;
			cursor: pointer;
			margin-left: 15px;
		}

		.burger div {
			width: 25px;
			height: 3px;
			background: #fff;
			margin: 5px;
			transition: .3s;
		}

		/* ---------- MOBILE NAV ---------- */
		/*@@media(max-width:768px) {
			nav {
				position: relative;
				left: 0;
				top: 0;
				transform: none;
				margin-top: 10px;
			}

			.nav-links {
				display: none;
				width: 100%;
				text-align: center;
				position: absolute;
				background: #333;
				top: 60px;
				left: 0;
				z-index: 1;
			}

			.nav-links.active {
				display: block;
			}

			.nav-links li {
				display: block;
				margin: 10px 0;
			}

			.burger {
				display: block;
				float: right;
				margin-top: 15px;
			}

			.burger.active .line1 {
				transform: rotate(45deg) translate(-5px, 6px);
			}

			.burger.active .line2 {
				opacity: 0;
			}

			.burger.active .line3 {
				transform: rotate(-45deg) translate(-5px, -6px);
			}
		}*/

		/* ---------- MAIN WRAPPER ---------- */
		.content-wrapper {
			max-width: 1100px;
			margin: 80px auto 40px;
			padding: 0 20px;
		}

		/* ---------- SCHEDULE CARD ---------- */
		.schedule-card {
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 6px rgba(0, 0, 0, .1);
			padding: 1.5rem 2rem;
		}

		/* controls row (tz selector) */
		.controls {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: .5rem;
			justify-content: center;
		}

		.controls label {
			margin: 0;
			font-weight: bold;
		}

		.controls select {
			max-width: 260px;
			width: 100%;
			padding: .4rem .6rem;
			border: 1px solid #ccc;
			border-radius: 4px;
		}

		/* ---------- TABLE ---------- */
		#entriesTable {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1.25rem;
			font-size: .95rem;
		}

		#entriesTable thead th {
			background: #e9efff;
			color: #333;
			font-weight: 600;
			padding: .75rem 1rem;
			text-align: left;
			border-bottom: 1px solid #d4d9ff;
		}

		#entriesTable tbody td {
			padding: .65rem 1rem;
			border-bottom: 1px solid #f0f0f0;
			color: #444;
			word-wrap: break-word;
		}

		#entriesTable tbody tr:nth-child(even) {
			background: #fafbff;
		}

		/* highlight next lesson */
		.next-row td {
			background: #fff3cd;
			font-weight: bold;
		}

		/* disabled join button */
		.disabled-btn,
		.disabled-btn:hover,
		.disabled-btn:active,
		.disabled-btn:focus {
			pointer-events: none;
			background: #6c757d !important;
			border-color: #6c757d !important;
			opacity: .65;
			color: #fff;
		}

		/* ---------- MOBILE TABLE ---------- */
		@@media(max-width:600px) {
			#entriesTable thead {
				display: none;
			}

			#entriesTable tbody td {
				display: block;
				width: 100%;
				text-align: right;
				padding-left: 50%;
				position: relative;
			}

			#entriesTable tbody td::before {
				content: attr(data-label);
				position: absolute;
				left: 1rem;
				width: calc(50% - 1rem);
				text-align: left;
				font-weight: 600;
				color: #666;
			}
		}
	</style>
</head>
<!-- NAV -->
<header>
	<div class="header-container">
		<div id="logo">@ViewData["Title"]</div>

		<nav>
			<ul class="nav-links">
				<li>
					<a asp-controller="Teachers" asp-action="Schedule" title="Schedule" class="active-page">
						<i class="hgi hgi-stroke hgi-calendar-03"></i>
					</a>
				</li>
				@*<li>
					<a asp-controller="Teachers" asp-action="Zoom" title="Zoom">
						<i class="hgi hgi-stroke hgi-zoom"></i>
					</a>
				</li>*@
				<li>
					<a asp-controller="Teachers" asp-action="Index" title="Account">
						<i class="fas fa-user-graduate"></i>
					</a>
				</li>
			</ul>

			<div class="burger">
				<div class="line1"></div>
				@*<div class="line2"></div>*@
				<div class="line3"></div>
			</div>
		</nav>
	</div>
</header>

<!-- SCHEDULE CARD -->
<div class="content-wrapper">
	<div class="schedule-card">
		<!-- CONTROLS -->
		<div class="controls">
			<label for="timeZoneSelect">Time&nbsp;Zone:</label>
			<select id="timeZoneSelect" name="timeZoneOffset">
				@foreach (var tz in timeZones)
				{
					if (tz.Selected)
					{
						<option value="@tz.Value" selected>@tz.Text</option>
					}
					else
					{
						<option value="@tz.Value">@tz.Text</option>
					}
				}
			</select>
		</div>

		<!-- TABLE -->
		<table id="entriesTable">
			<colgroup>
				<col style="width:10%" />
				<col style="width:10%" />
				<col style="width:14%" />
				<col style="width:12%" />
				<col style="width:12%" />
				<col style="width:18%" />
			</colgroup>
			<thead>
				<tr>
					<th>Date</th>
					<th>Time</th>
					<th>Student</th>
					<th>Status</th>
					<th>Duration</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>

@* ---------- SCRIPTS ---------- *@
@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.1.min.js"
		integrity="sha256-+LdG5Fjnxd8h8JAoywV4P8pIY2q3FfvMZHO7+jT9BkE=" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
	<script>
    (async () => {

        /* teacherId injected by Razor */
        const teacherId = '@ViewBag.TeacherId';

        /* build + start connection */
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/scheduleHub")
            .withAutomaticReconnect()
            //.configureLogging(signalR.LogLevel.Information)
            .build();

        await connection.start();
        //console.log("SignalR connected. Joining group…");
        await connection.invoke("JoinTeacherGroup", teacherId);

        connection.on("ScheduleChanged", () => {
            //.log("Ping received – refresh!");
			//g("pinging schedule changed");
            refreshRows();                 // your existing function
        });

    })();
    </script>
	<script>
		const startLessonBase = '@Url.Action("StartLesson", "Teachers")';
		const endLessonBase = '@Url.Action("EndLesson", "Teachers")';
		(() => {
			const { DateTime } = luxon;

			/* ───────── CONSTANTS (match Zoom page) ───────── */
			const minsBefore = 5;           // allow join 5 min before start
			const minsAfter = 15;           // …and 15 min after the lesson ENDS
			const meetingId = "7890699796";
			const pwd = "eXdhK0tMUHQvRmVQb2Q0MHYySWVZUT09";
			const deepLink = `zoommtg://zoom.us/join?action=join&confno=${meetingId}&pwd=${pwd}`;
			const webLink = `https://us02web.zoom.us/j/${meetingId}?pwd=${pwd}`;
			const tempTestLink = 'https://learn.microsoft.com/en-us/aspnet/core/web-api/action-return-types?view=aspnetcore-9.0';
			const detailsBase = '@Url.Action("Zoom", "Teachers")';


			/* ───────── DATA ───────── */
			const raw = @Html.Raw(existingJson);
			const rows = raw
				.map(r => ({ ...r, DateTime: r.DateTime.endsWith('Z') ? r.DateTime : r.DateTime + 'Z' }))
				.sort((a, b) => DateTime.fromISO(b.DateTime) - DateTime.fromISO(a.DateTime)); // newest → oldest


			window.refreshRows = async function refreshRows() {
				//console.log("in refresh rows");
                try {
                    const latest = await fetch('@Url.Action("ScheduleJson","Teachers")')
                                        .then(r => r.json());

                    rows.length = 0;                             // clear array

                    latest.forEach(src => {
                        // tolerate both PascalCase and camelCase coming from JSON
                        const rawTime = src.DateTime ?? src.dateTime;
                        if (!rawTime) return;                   // skip bad rows

                        rows.push({
                            Id:          src.Id          ?? src.id,
                            TeacherId:   src.TeacherId   ?? src.teacherId,
                            StudentName: src.StudentName ?? src.studentName,
                            Status:      src.Status      ?? src.status,
                            // ensure we always have a *number*
                            Duration:    Number(src.Duration ?? src.duration ?? 0),
                            DateTime:    rawTime.endsWith('Z') ? rawTime : rawTime + 'Z'
                        });
                    });

                    renderTable();                              // redraw
                } catch (e) {
                    console.error("Refresh failed", e);
                }
            };

			$(renderTable);
			$('#timeZoneSelect').on('change', renderTable);

			function renderTable() {
				const zone = $('#timeZoneSelect').val();
				const nowUtc = DateTime.utc();
				const nowLocal = nowUtc.setZone(zone);
				const tbody = $('#entriesTable tbody').empty();

				/* ---------- choose row to highlight ---------- */
				let highlightId = null;
				rows.forEach(r => {
					const startUtc = DateTime.fromISO(r.DateTime);
					const diffMin = startUtc.diff(nowUtc, 'minutes').minutes;   // +ve = future
					const windowEnd = -(Number(r.Duration) + minsAfter);        // negative minutes after END
					const isToday = startUtc.setZone(zone).hasSame(nowLocal, 'day');

					if (!highlightId && isToday && diffMin <= minsBefore && diffMin >= windowEnd)
						highlightId = r.Id;                                       // active/ongoing lesson
				});
				if (!highlightId) {
					/* otherwise highlight nearest future lesson */
					let bestAhead = null;
					rows.forEach(r => {
						const diffMin = DateTime.fromISO(r.DateTime).diff(nowUtc, 'minutes').minutes;
						if (diffMin > 0 && (!bestAhead || diffMin < bestAhead.diff))
							bestAhead = { id: r.Id, diff: diffMin };
					});
					if (bestAhead) highlightId = bestAhead.id;
				}

				/* ---------- render each <tr> ---------- */
				rows.forEach(row => {
					const startUtc = DateTime.fromISO(row.DateTime);
					const diffMin = startUtc.diff(nowUtc, 'minutes').minutes;
					const windowEnd = -(Number(row.Duration) + minsAfter);
					const startLocal = startUtc.setZone(zone);
					const isToday = startLocal.hasSame(nowLocal, 'day');

					let actionHtml = '';
					//TODO: Fix this logic (or not, it sorta works, just very ugly)
					if (isToday) {
						if (diffMin > minsBefore)               // too early
							actionHtml = '';
						else if (diffMin < windowEnd)           // too late (>15 min after end)
							actionHtml = '';
						else {
							actionHtml = buildBtn('enabled', row.Id, row.Status);
						}                                    // within join-window

					}

					tbody.append(`
				                <tr class="${row.Id === highlightId ? 'next-row' : ''}">
				                  <td data-label="Date">${startLocal.toFormat('yyyy-LL-dd')}</td>
				                  <td data-label="Time">${startLocal.toFormat('hh:mm a')}</td>
				                  <td data-label="Student">${row.StudentName}</td>
				                  <td data-label="Status">${row.Status}</td>
				                  <td data-label="Duration">${row.Duration}&nbsp;min</td>
				                  <td data-label="Actions">${actionHtml}</td>
				                </tr>`);
				});
			}

			/* ---------- helpers ---------- */
			function buildBtn(state, id, status) {
				const cls = state === 'disabled'
					? 'btn btn-primary btn-md join-btn ml-2 disabled-btn'
					: 'btn btn-primary btn-md join-btn ml-2';
				const extra = state === 'disabled' ? 'aria-disabled="true" tabindex="-1"' : '';
				let startOrJoin = "";
				let endBtnStatus = "";

				if (status == "Ongoing") {
					startOrJoin = "Join";

				}
				else {
					startOrJoin = "Start";
					endBtnStatus = "disabled"
				}

				//Uncomment this to use actual static link
				return `
						  <a href="${deepLink}" class="${cls}" data-id="${id}" ${extra}>
							<strong>Join Static Link</strong>
						  </a>
						  `;
				//Dynamic link:
				/*return `
					<a
						href="${tempTestLink}" class="${cls}" data-id="${id}" ${extra}>
						<strong>Join Static Link</strong>
					</a>
					<a
						href="${startLessonBase}?id=${id}"
						class="btn btn-primary btn-md ml-2 start-lesson-btn"
						target="_blank"
						rel="noopener noreferrer">
						<strong>${startOrJoin} Lesson</strong>
					</a>
					<button
						class="btn btn-danger btn-md ml-2 end-lesson-btn ${endBtnStatus}"
						data-id="${id}"
						onclick="pingEndLesson('${id}')"
						<strong>End Lesson</strong>
					</button>	
					<a
						href="${detailsBase}?scheduleId=${id}"
						class="btn btn-info btn-md ml-3"
						title="Lesson details">
						<i class="fa-solid fa-circle-info text-light"></i>
					</a>`;*/
			}

			/* open Zoom + browser fallback */
			//Uncomment this to route to actual static link; for now just testing

			$(document).on('click', '.join-btn', function (e) {
				if ($(this).hasClass('disabled-btn')) return;
				e.preventDefault();
				const $btn = $(this);
				const url = $btn.attr('href');
				//window.location.href = deepLink;
				window.open(url, '_blank');

				setTimeout(() => window.open(weblink, '_blank'), 500);
			});
			/*$(document).on('click', '.join-btn', function (e) {
				if ($(this).hasClass('disabled-btn')) return;
				e.preventDefault();
				window.location.href = tempTestLink;
				setTimeout(() => window.location.href = tempTestLink, 500);
			});*/
		})();

		async function pingEndLesson(id) {
			try {
				const url = `${endLessonBase}?id=${id}`; // use query param for GET
				const response = await fetch(url, {
					method: 'GET',
					headers: {
						'Accept': 'application/json'
					}
				});

				if (response.ok) {
					//nsole.log("EndLesson called successfully");
				} else {
					//nsole.error("EndLesson call failed:", response.status);
				}
			} catch (error) {
				//console.error("Error calling EndLesson:", error);
			}
			location.reload(true)
		}

		// ── PREVENT DOUBLE-CLICK ON START/END ─────────────────────────────
		$(document).on('click', '.start-lesson-btn, .end-lesson-btn', function (e) {
			const $btn = $(this);
			// first click: add .disabled-btn (blocks pointer-events + greys it out)
			$btn.addClass('disabled-btn');
			// after 2s: restore
			setTimeout(() => {
				$btn.removeClass('disabled-btn');
			}, 2000);

			//location.reload(true);

			// allow the first click to proceed (opening the new tab or firing pingEndLesson)
		});

		// 1) Intercept the Start-Lesson link
		$(document).on('click', '.start-lesson-btn', function (e) {
			e.preventDefault();                         // stop the default navigation
			const $btn = $(this);
			const url = $btn.attr('href');           // e.g. “/Teachers/StartLesson?id=…”

			// 2) Open Zoom in a new tab (will follow the server’s redirect → joinUrl)
			window.open(url, '_blank');

			// 3) Swap this into a “Join Lesson” button
			$btn
				.removeClass('start-lesson-btn btn-primary')   // no longer a “start” button
				.addClass('join-btn btn-secondary')            // give it your “join” styling
				.find('strong')
				.text('Join Lesson');                        // flip the text label

			setTimeout(() => {
				window.location.reload();
			}, 500)
		});

	</script>
}
