@model IEnumerable<DotNetCoreSqlDb.Models.WhatsAppVoiceMessages>

@{
    ViewData["Title"] = "WhatsApp Voice Messages";
}

<div class="row no-gutters">
    @if (User.IsInRole("support"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-dark d-flex icon-btn" title="Student Management">
                    <i class="fas fa-user-graduate"></i> Student Management
                </a>
                <a href="@Url.Action("Index", "Groups")" class="btn btn-dark d-flex icon-btn" title="Groups">
                    <i class="fas fa-users"></i> Groups
                </a>
                <a href="@Url.Action("Index", "Assignments")" class="btn btn-dark d-flex icon-btn" title="Assignments">
                    <i class="fas fa-tasks"></i> Assignments
                </a>
                <a href="@Url.Action("Index", "WhatsApp")" class="btn btn-primary d-flex icon-btn" title="WhatsApp">
                    <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
            </div>
        </div>
        <div class="col pl-3">
    }

    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <input type="text" id="searchBox" class="form-control" placeholder="Search voice messages..." />
            </div>
        </div>
        <div class="row" id="messagesContainer"></div>
    </div>

    @if (User.IsInRole("support"))
    {
        </div>
    }
</div>

@* Fuse JS and initial render *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/6.6.2/fuse.min.js"></script>
<script>
  const allMessages = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
      Model.Select(m => new { m.Id, m.Name, m.Description })
    )
  );

  function debounce(fn, delay) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn.apply(this, args), delay);
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const fuse = new Fuse(allMessages, {
      keys: ['Name', 'Description'],
      threshold: 0.3
    });

    function render(items) {
      const container = document.getElementById('messagesContainer');
      container.innerHTML = '';

      items.forEach(vm => {
        const col = document.createElement('div');
        col.className = 'col-md-4 mb-3';
        const card = document.createElement('div');
        card.className = 'card h-100';
        const body = document.createElement('div');
        body.className = 'card-body';

        const title = document.createElement('h5');
        title.className = 'card-title';
        title.textContent = vm.Name;
        body.appendChild(title);

        const desc = document.createElement('p');
        desc.className = 'card-text';
        desc.textContent = vm.Description;
        body.appendChild(desc);

        const tr = document.createElement('tr');
        const tdPhone = document.createElement('td');
        const form = document.createElement('form');
        form.classList.add('d-flex', 'mb-0');
        form.onsubmit = e => sendAndTrack(e, vm.Id);

        const hid = document.createElement('input');
        hid.type = 'hidden'; hid.name = 'id'; hid.value = vm.Id;
        form.appendChild(hid);

        const input = document.createElement('input');
        Object.assign(input, {
          type: 'text',
          name: 'phone',
          placeholder: '+16475550123',
          required: true,
          pattern: '^\\+(?:1\\d{10}|7\\d{10}|(?:3\\d|4\\d)\\d{7,13})$',
          title: 'Valid NA (+1), RU (+7) or EU (+30–+49) E.164 number'
        });
        input.classList.add('form-control', 'me-2');
        form.appendChild(input);

        const btn = document.createElement('button');
        btn.type = 'submit';
        btn.id = `send-btn-${vm.Id}`;
        btn.classList.add('btn','btn-sm','btn-primary');
        btn.textContent = 'Send';
        form.appendChild(btn);

        tdPhone.appendChild(form);
        tr.appendChild(tdPhone);

        const tdStatus = document.createElement('td');
        const span = document.createElement('span');
        span.id = `status-${vm.Id}`;
        span.classList.add('ms-2','small');
        tdStatus.appendChild(span);
        tr.appendChild(tdStatus);

        card.appendChild(body);
        col.appendChild(card);
        container.appendChild(col);
      });
    }

    render(allMessages);

    const searchBox = document.getElementById('searchBox');
    searchBox.addEventListener('input', debounce(e => {
      const q = e.target.value.trim();
      render(q ? fuse.search(q).map(r => r.item) : allMessages);
    }, 150));
  });
</script>

@* SignalR client lib *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
  const connection = new signalR.HubConnectionBuilder()
    .withUrl("/hubs/whstatus")
    .build();

  connection.on("statusUpdated", (dbId, status) => {
    const el = document.getElementById(`status-${dbId}`);
    if (!el) return;
    if (["delivered","processed","read","sent"].includes(status)) {
      el.innerHTML = '<i class="hgi hgi-stroke hgi-tick-double-02"></i>';
    } else if (["failed","cancelled","revoked"].includes(status)) {
      el.innerHTML = '<i class="hgi hgi-stroke hgi-cancel-01"></i>';
    }
  });

  connection.start().catch(console.error);

  // helper to validate numbers via our API
  async function validateNumber(phone) {
    try {
      const res = await fetch(`/WhatsApp/ValidateContact?phone=${encodeURIComponent(phone)}`);
      if (!res.ok) return false;
      const data = await res.json();
      return data.valid === true && data.exists === true;
    } catch {
      return false;
    }
  }

  async function sendAndTrack(evt, id) {
    evt.preventDefault();
    const form    = evt.target;
    const statusEl = document.getElementById(`status-${id}`);
    // show spinner while sending
    statusEl.innerHTML =
      '<div class="spinner-border spinner-border-sm" role="status"></div>';
    const btn = document.getElementById(`send-btn-${id}`);
    btn.disabled = true;

    try {
      const res = await fetch(`/WhatsApp/Send`, {
        method: 'POST',
        body: new FormData(form)
      });
      if (!res.ok) throw new Error();
      // ✨ on success: replace spinner with checkmark
      statusEl.innerHTML = '<i class="hgi hgi-stroke hgi-tick-double-02"></i>';
    } catch {
      // ❌ on error: show cancel icon and re-enable the button
      statusEl.innerHTML = '<i class="hgi hgi-stroke hgi-cancel-01"></i>';
      btn.disabled = false;
    }
  }
</script>
