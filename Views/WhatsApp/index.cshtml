@model IEnumerable<DotNetCoreSqlDb.Models.WhatsAppVoiceMessages>

@{
    ViewData["Title"] = "WhatsApp Voice Messages";
}

<div class="row no-gutters">
    @if (User.IsInRole("support"))
    {
        <div class="col-auto admin-sidebar">
            <div class="sidebar-header">
                <i class="hgi hgi-stroke hgi-croissant"></i>
            </div>
            <div class="sidebar-content">
                <a href="@Url.Action("Index", "StudentManagement")" class="btn btn-dark d-flex icon-btn" title="Student Management">
                    <i class="fas fa-user-graduate"></i>
                </a>
                
                <a href="@Url.Action("Index", "Groups")" class="btn btn-dark d-flex icon-btn" title="Manage Groups">
                    <i class="fas fa-users"></i>
                </a>

                <a href="@Url.Action("Manage", "Schedule")" class="btn btn-dark d-flex icon-btn" title="Schedule">
                    <i class="hgi hgi-stroke hgi-calendar-03"></i>
                </a>
                <a href="@Url.Action("Index", "Whatsapp")" class="btn btn-success d-flex icon-btn" title="WhatsApp">
                    <i class="hgi hgi-stroke hgi-message-01"></i>
                </a>
                <a href="@Url.Action("Index", "Assignments")"       class="btn btn-dark icon-btn" title="Assignments"><i class="fas fa-tasks"></i></a>
               
            </div>
        </div>
    }
    <div class="col-md-10">
        <h2>Voice Messages</h2>

        <!-- Search box -->
        <input id="search-box"
               type="text"
               class="form-control mb-3"
               placeholder="Search descriptions…" />

        <table class="table" id="messages-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Phone &amp; Send</th>
                    <th>Live Status</th>
                </tr>
            </thead>
            <tbody>
                @* Populated by JavaScript *@
            </tbody>
        </table>
    </div>
</div>

<!-- Fuse.js CDN for client-side fuzzy search -->
<script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/dist/fuse.min.js"></script>

<script>
  // Expose only minimal data to JS for safety
  const allMessages = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
      Model.Select(m => new { m.Id, m.Name, m.Description })
    )
  );

  // Debounce helper
  function debounce(fn, delay) {
    let timer;
    return function(...args) {
      clearTimeout(timer);
      timer = setTimeout(() => fn.apply(this, args), delay);
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Initialize Fuse.js with ignoreLocation so substrings anywhere match
    const fuse = new Fuse(allMessages, {
      keys: ['Description'],
      threshold: 0.3,
      distance: 100,
      ignoreLocation: true,
      minMatchCharLength: 2
    });

    const tableBody = document.querySelector('#messages-table tbody');
    const searchBox = document.getElementById('search-box');

    // Render function: safe DOM creation
    function render(items) {
      tableBody.innerHTML = '';
      items.forEach(vm => {
        const tr = document.createElement('tr');

        // Name cell
        const tdName = document.createElement('td');
        tdName.textContent = vm.Name || '';
        tr.appendChild(tdName);

        // Description cell
        const tdDesc = document.createElement('td');
        tdDesc.classList.add('description-col');
        tdDesc.textContent = vm.Description;
        tr.appendChild(tdDesc);

        // Phone & Send cell
        const tdPhone = document.createElement('td');
        const form   = document.createElement('form');
        form.classList.add('d-flex', 'mb-0');
        form.onsubmit = e => sendAndTrack(e, vm.Id);

        // hidden ID
        const hid = document.createElement('input');
        hid.type  = 'hidden';
        hid.name  = 'id';
        hid.value = vm.Id;
        form.appendChild(hid);

        // phone input
        const input = document.createElement('input');
        Object.assign(input, {
          type: 'text',
          name: 'phone',
          placeholder: '+1 647‑555‑0123',
          required: true,
          pattern: '^\\+(?:1\\d{10}|7\\d{10}|(?:3\\d|4\\d)\\d{7,13})$',
          title: 'Must be a valid NA (+1), RU (+7) or EU (+30–+49) E.164 number'
        });
        input.classList.add('form-control', 'me-2');
        form.appendChild(input);

        // send button
        const btn = document.createElement('button');
        btn.type = 'submit';
        btn.id   = `send-btn-${vm.Id}`;
        btn.classList.add('btn', 'btn-sm', 'btn-primary');
        btn.textContent = 'Send';
        form.appendChild(btn);

        tdPhone.appendChild(form);
        tr.appendChild(tdPhone);

        // Live Status cell
        const tdStatus = document.createElement('td');
        const span     = document.createElement('span');
        span.id    = `status-${vm.Id}`;
        span.classList.add('ms-2', 'small');
        tdStatus.appendChild(span);
        tr.appendChild(tdStatus);

        tableBody.appendChild(tr);
      });
    }

    // Initial render of all messages
    render(allMessages);

    // Search input handler with debounce
    searchBox.addEventListener('input', debounce(e => {
      const q = e.target.value.trim();
      if (!q) {
        render(allMessages);
      } else {
        const results = fuse.search(q).map(r => r.item);
        render(results);
      }
    }, 150));
  });
</script>

<!-- Existing WhatsApp send/status scripts -->
<script>
  async function validateNumber(phone) {
    let res;
    try {
      res = await fetch(`/WhatsApp/ValidateContact?phone=${encodeURIComponent(phone)}`);
    } catch {
      return false;
    }
    const raw = await res.text();
    let json;
    try {
      json = JSON.parse(raw);
    } catch {
      return false;
    }
    return json.valid === true;
  }

  async function sendAndTrack(evt, id) {
    evt.preventDefault();
    const form = evt.target;
    const phone = form.phone.value;
    const btn = document.getElementById(`send-btn-${id}`);
    const statusEl = document.getElementById(`status-${id}`);

    // 1) validate
    statusEl.innerHTML = '<div class="loading-spinner"></div>';
    if (!await validateNumber(phone)) {
      statusEl.innerHTML = '<i class="fa fa-times"></i> Invalid number';
      return;
    }

    // 2) send
    btn.disabled = true;
    btn.classList.add('disabled');
    statusEl.innerHTML = '<div class="loading-spinner"></div>';

    let sendOk = false;
    try {
      const res = await fetch(`/WhatsApp/Send`, {
        method: 'POST',
        body: new FormData(form)
      });
      sendOk = res.ok;
    } catch {
      sendOk = false;
    }

    if (!sendOk) {
      statusEl.innerHTML = '<i class="fa fa-times"></i>';
      btn.disabled = false;
      return;
    }

    // 3) poll status
    pollStatus(id);
  }

  function pollStatus(id) {
    const btn = document.getElementById(`send-btn-${id}`);
    const statusEl = document.getElementById(`status-${id}`);
    const maxAttempts = 300;
    let attempts = 0, lastStatus = null;

    const handle = setInterval(async () => {
      attempts++;
      try {
        const res  = await fetch(`/WhatsApp/GetStatus?id=${id}`);
        const data = await res.json();
        const ds   = data.deliveryStatus;
        lastStatus = ds || lastStatus;

        if (ds === 'delivered' || ds === 'processed' || ds === 'read' || ds === 'sent') {
          statusEl.innerHTML = '<i class="hgi hgi-stroke hgi-tick-double-02"></i>';
          clearInterval(handle);
        }
        else if ([`failed`,`cancelled`,`revoked`].includes(ds)) {
          statusEl.innerHTML = '<i class="hgi hgi-stroke hgi-cancel-01"></i>';
          clearInterval(handle);
        }
      } catch {
        clearInterval(handle);
        statusEl.innerHTML = '<i class="fa fa-times"></i>';
      }

      if (attempts >= maxAttempts) {
        clearInterval(handle);
        if (lastStatus === 'delivered') {
          statusEl.innerHTML = '<i class="fa fa-arrow-right"></i>';
        }
        btn.disabled = false;
      }
    }, 1000);
  }
</script>
