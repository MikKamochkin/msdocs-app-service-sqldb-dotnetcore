@using DotNetCoreSqlDb.Services
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Zoom Meetings";
    var items = (ViewBag.ZoomRows as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var isFree = true;
    var remaining = ViewBag.RateLimitRemaining;
}

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>

	<style>
        .free-row{
            background-color: rgb(215, 235, 214);
        }
        .busy-row{
            background-color: rgb(240, 220, 198);
        }
    </style>
</head>
<div class="row no-gutters">
    @if (User.IsInRole("admin") || User.IsInRole("support")  || User.IsInRole("assistant"))
    {
        <partial name="_AdminSidebar" />
        
        <div class="col-md-10">
        @*<div>API-remaining: @ViewBag.RateLimitRemaining</div>*@
        <table class="table">
            <thead>
                <tr>
                    <th>Teacher</th>
                    <th>Group Name</th>
                    <th>Participants</th>
                    <th>Join URL</th>
                    <th>MeetingId</th>
                    <th>MeetingPassword</th>
                    <th>StartTime</th>
                    <th>Duration</th>
                    <th>Email</th>  
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    string rowClass = item.IsBusy ? "busy-row" : "free-row";
                    isFree = !item.IsBusy;
                    <tr class="@rowClass">
                        <td>@item.TeacherName</td>
                        <td>@item.GroupName</td>
                        <td>
                            @if (((IReadOnlyList<ZoomParticipant>)item.Participants).Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var p in (IReadOnlyList<ZoomParticipant>)item.Participants)
                                    {
                                        <li>
                                            Name: @p.UserName Joined at
                                            @DateTime.Parse(p.JoinTime).ToLocalTime().ToString("HH:mm:ss")
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>No participants</span>
                            }
                        </td>
                        <td>@item.JoinUrl</td>
                        <td>@item.MeetingId</td>
                        <td>@item.MeetingPassword</td>
                        <td>@item.StartTime</td>
                        <td>@item.Duration</td>
                        <td>@Regex.Match(item.Email, @"\d+").Value</td> 
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>
